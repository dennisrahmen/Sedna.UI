# Formatting and analysis rules for Sedna.UI.
#
# TreatWarningsAsErrors is on, so anything raised to warning below fails the build.
# That is deliberate for the rules that encode a decision this repo has already made;
# everything else stays a suggestion.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# The generator writes LF and compares byte-for-byte with `cmp`, so a CRLF checkout of
# either generated asset would fail the drift guard on every machine that has one.
[*.{css,js}]
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[*.{json,slnx,csproj,props,targets}]
indent_size = 2

[*.sh]
indent_size = 4
end_of_line = lf

[*.{cs,razor}]
indent_size = 4

# ── C# style ────────────────────────────────────────────────────────────────────
[*.cs]
# File-scoped namespaces throughout, and the compiler enforces it rather than review.
csharp_style_namespace_declarations = file_scoped:error

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion

dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion

# Every public member is part of the package's API surface and needs a doc comment.
# GenerateDocumentationFile already makes CS1591 fire; this pins the intent so nobody
# "fixes" a build failure by turning the documentation file off.
dotnet_diagnostic.CS1591.severity = error

# ── Culture-sensitive string comparison ─────────────────────────────────────────
# Every guard test compares CSS and markup, where the current culture is irrelevant
# and Turkish-I would silently change what a scan matches. StringComparison.Ordinal
# is used throughout; these keep it that way.
dotnet_diagnostic.CA1307.severity = warning   # specify StringComparison for clarity
dotnet_diagnostic.CA1310.severity = warning   # StartsWith/EndsWith without one
dotnet_diagnostic.CA1309.severity = warning   # prefer Ordinal over InvariantCulture

# The tests read the real shipped files rather than test fixtures, on purpose — a test
# asserting things about a copy proves nothing about what ships.
[src/Sedna.UI.Tests/**.cs]
dotnet_diagnostic.CS1591.severity = none

# The catalogue application and its tests are not packages: nothing consumes their
# API, so there is no documentation surface to keep. GenerateDocumentationFile is
# already false in both, which is what actually stops CS1591 firing; this pins the
# intent so turning it back on does not read as an oversight.
[src/Sedna.UI.Catalogue{,.Tests}/**.cs]
dotnet_diagnostic.CS1591.severity = none
