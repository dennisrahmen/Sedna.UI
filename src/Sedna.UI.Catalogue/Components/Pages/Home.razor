@page "/"
@using Sedna.UI.Catalogue.Navigation

<PageTitle>@SiteMeta.HomeTitle</PageTitle>

<div class="cat-hero">
    <span class="cat-hero-logo cat-mark cat-mark--hero"></span>
    <div class="cat-hero-text">
        <h1>Sedna.UI</h1>
        <p>@SiteMeta.Tagline</p>
    </div>
</div>

<div class="cat-hero-rule"></div>

<div class="cat-actions">
    <a class="btn btn-lg btn-primary" href="/getting-started">Get started <i class="ri-arrow-right-line"></i></a>
    <a class="btn btn-lg" href="/frame"><i class="ri-side-bar-line"></i> Browse the classes</a>
    <CatLink Class="btn btn-lg" Href="@CatalogueLinks.NuGet"><i class="ri-box-3-line"></i> NuGet</CatLink>
</div>

@* Why this and not a component library or utility CSS — the same argument, in the same
   order, as the opening of README.md. The MCP server is one of the four points rather
   than a callout beside them, because an agent writing the app is what the library is for. *@
<div class="cat-pitch">
    <p class="cat-pitch-lede">
        Every component library gets you to ninety percent. The last ten is the button the component
        has no parameter for, and it is where you copy the component&rsquo;s markup out and rebuild it
        yourself. <strong>Sedna.UI starts you at a hundred.</strong>
    </p>
    <div class="cat-points">
        <div class="cat-point">
            <span class="cat-tile-ic"><i class="ri-code-s-slash-line"></i></span>
            <div class="cat-point-text">
                <strong>The markup is yours</strong>
                <span>
                    Plain, open HTML with semantic classes, from the first line. The package ships what
                    sits underneath: the stylesheet, a design-token contract, the icons and the script.
                </span>
            </div>
        </div>
        <div class="cat-point">
            <span class="cat-tile-ic"><i class="ri-cursor-line"></i></span>
            <div class="cat-point-text">
                <strong>The behaviour comes with it</strong>
                <span>
                    Menus, tabs, popovers and the command palette work from attributes on your own
                    markup, and a small C# surface opens the dialogs your app writes.
                </span>
            </div>
        </div>
        <div class="cat-point">
            <span class="cat-tile-ic"><i class="ri-robot-2-line"></i></span>
            <div class="cat-point-text">
                <strong>Built to be written by an agent</strong>
                <span>
                    Add the <a href="/mcp-server">MCP server</a> &mdash; one URL, and your agent searches
                    this catalogue, copies the exact markup, and checks which release first shipped a class.
                </span>
            </div>
        </div>
        <div class="cat-point">
            <span class="cat-tile-ic"><i class="ri-shield-check-line"></i></span>
            <div class="cat-point-text">
                <strong>A system, not a starter kit</strong>
                <span>
                    Every colour through a token, every class on a page here, and this site built with the
                    library itself &mdash; down to the graph and the rich-text editor.
                </span>
            </div>
        </div>
    </div>
</div>

@* The pitch above is about the library; everything below is the catalogue. *@
<hr class="cat-divider" />

@foreach (var heading in Headings)
{
    var pages = heading.Pages;
    if (pages.Count == 0) continue;

    <h2>@heading.Title</h2>
    <div class="cat-tiles">
        @foreach (var item in pages)
        {
            <a class="card cat-tile" href="@item.Route">
                <span class="cat-tile-ic"><i class="@item.Icon"></i></span>
                <span class="cat-tile-text">
                    <strong>@item.Label</strong>
                    <span>@item.Blurb</span>
                </span>
                <i class="ri-arrow-right-line cat-tile-go"></i>
            </a>
        }
    </div>
}

@code {
    // One heading per group, and one more per section a group carries — the reference
    // pages under Start are their own row of tiles rather than tiles among the start pages.
    private static IEnumerable<(string Title, List<CataloguePage> Pages)> Headings =>
        CataloguePages.Groups.SelectMany(group =>
            new[] { (Title: group, Pages: CataloguePages.InGroup(group).Where(p => p.Route != "/" && p.Section is null).ToList()) }
                .Concat(CataloguePages.SectionsOf(group)
                    .Select(section => (Title: section, Pages: CataloguePages.InGroup(group).Where(p => p.Section == section).ToList()))));
}
