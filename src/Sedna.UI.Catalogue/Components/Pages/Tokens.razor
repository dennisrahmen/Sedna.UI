@page "/tokens"
@using Sedna.UI.Catalogue.Navigation
@implements IDisposable
@inject IJSRuntime Js
@inject ThemeState Theme

<CatHead Title="Tokens">
    Every colour, size, radius and duration in the stylesheet resolves through one of these, and all
    of them are below — a test compares this page against the token export in both directions. The
    chips are painted by the token itself, and the values are read from the stylesheet the browser
    actually loaded, so they follow the theme, the colour-blind palette and any override an app has
    applied.
</CatHead>

<div class="cat-note">
    <i class="ri-brush-line"></i>
    <strong>Redefine these in your own <code>brand.css</code>, loaded after the library sheet.</strong>
    Never declare a <code>--</code> name the library does not already define: a future version may
    introduce that name with a different meaning, and your app breaks on upgrade. The
    <a href="/">Overview</a> page shows the block to copy.
</div>

@foreach (var group in TokenGroups.All)
{
    <h2 id="@Slug.From(group.Name)">
        <CatTitle Text="@group.Name" /><a class="cat-anchor" href="#@Slug.From(group.Name)" aria-label="Link to this section"><i class="ri-links-line"></i></a>
    </h2>
    <div class="cat-swatches">
        @foreach (var token in group.Tokens)
        {
            <div class="cat-swatch">
                @if (group.Swatch)
                {
                    @* Painted by the token, not by a value read in JavaScript — so it
                       is correct before the circuit connects and with scripting off. *@
                    <span class="cat-chip" style="background: var(@token)"></span>
                }
                @* .cat-swatch-text, not a bare div with an inline min-width, and
                   .cat-swatch-value rather than the library's .col-muted — which is a
                   table-column modifier and was being borrowed for "small grey text".
                   Borrowing it also put the fix out of reach: catalogue.css may not
                   style a library class, so the long values (a font stack, a
                   color-mix()) had nothing to wrap them and pushed a horizontal
                   scrollbar onto the whole page. *@
                <div class="cat-swatch-text">
                    <div class="cat-swatch-name">@token</div>
                    <div class="cat-swatch-value">@Value(token)</div>
                </div>
            </div>
        }
    </div>
}

@code {
    private Dictionary<string, string>? _values;

    protected override void OnInitialized() => Theme.Changed += Refresh;

    public void Dispose() => Theme.Changed -= Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Read();
    }

    private string Value(string token) =>
        _values is null ? "…" : _values.GetValueOrDefault(token, "not declared");

    private async Task Read()
    {
        _values = await Js.InvokeAsync<Dictionary<string, string>>(
            "sednaUiCatalogue.readTokenValues", TokenGroups.AllTokens);
        StateHasChanged();
    }

    private void Refresh() => _ = InvokeAsync(Read);
}
