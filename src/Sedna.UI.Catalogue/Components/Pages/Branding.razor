@page "/branding"
@using Sedna.UI.Catalogue.Navigation
@implements IDisposable
@inject IJSRuntime Js
@inject ISednaSettings Settings

<CatHead Title="Branding" Tier="@CatHead.Site">
    A rebrand, not a redesign: corner rounding, spacing, type and motion carry over unchanged, and
    what moves is hue. The full manual is
    <a href="@CatalogueLinks.BrandingDoc">docs/BRANDING.md</a>.
</CatHead>

<h2 id="switch">Switch it live</h2>

<p class="cat-lede">
    Four registered themes, applied by flipping <code>data-theme</code> and
    <code>data-variant</code> on <code>&lt;html&gt;</code> for the rest of this site.
    <strong>Forest</strong> moves both halves, brand and base ramp; <strong>Cobalt</strong> moves the
    brand only; <strong>Graphite</strong> the base only. A brand hue landing within ~15° of a
    semantic family has to move that family — which is why Forest also moves <code>go</code> and
    Cobalt moves <code>orbit</code>.
</p>

<div style="display:flex; gap:24px; flex-wrap:wrap; margin:20px 0 34px">
    <fieldset class="form-section" style="margin:0">
        <legend>Theme</legend>
        <div class="segmented">
            <label class="segmented-option">
                <input type="radio" name="branding-theme" checked="@IsSedna" @onchange="SelectSedna" /> Sedna
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-theme" checked="@IsForest" @onchange="SelectForest" /> Forest
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-theme" checked="@IsCobalt" @onchange="SelectCobalt" /> Cobalt
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-theme" checked="@IsGraphite" @onchange="SelectGraphite" /> Graphite
            </label>
        </div>
    </fieldset>
    <fieldset class="form-section" style="margin:0">
        <legend>Variant</legend>
        <div class="segmented">
            <label class="segmented-option">
                <input type="radio" name="branding-variant" checked="@IsDark" @onchange="SelectDark" />
                <span><i class="ri-moon-line"></i> Dark</span>
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-variant" checked="@IsLight" @onchange="SelectLight" />
                <span><i class="ri-sun-line"></i> Light</span>
            </label>
        </div>
    </fieldset>
    @* The other three appearance settings the header carries, on the page that is about
       appearance. They are the same ISednaSettings the header writes, so flipping one here
       moves the header's own toggle and the reverse, and neither has to know about the other. *@
    <fieldset class="form-section" style="margin:0">
        <legend>Palette</legend>
        <div class="segmented">
            <label class="segmented-option">
                <input type="radio" name="branding-palette" checked="@(!IsColourBlind)" @onchange="SelectFullColour" />
                <span><i class="ri-palette-line"></i> Full colour</span>
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-palette" checked="@IsColourBlind" @onchange="SelectColourBlind" />
                <span><i class="ri-contrast-2-line"></i> Colour-blind</span>
            </label>
        </div>
    </fieldset>
    <fieldset class="form-section" style="margin:0">
        <legend>Density</legend>
        <div class="segmented">
            <label class="segmented-option">
                <input type="radio" name="branding-density" checked="@(!IsCompact)" @onchange="SelectComfortable" />
                <span><i class="ri-menu-line"></i> Comfortable</span>
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-density" checked="@IsCompact" @onchange="SelectCompact" />
                <span><i class="ri-list-check-2"></i> Compact</span>
            </label>
        </div>
    </fieldset>
    <fieldset class="form-section" style="margin:0">
        <legend>Direction</legend>
        <div class="segmented">
            <label class="segmented-option">
                <input type="radio" name="branding-direction" checked="@(!IsRtl)" @onchange="SelectLtr" />
                <span><i class="ri-text-direction-r"></i> Left to right</span>
            </label>
            <label class="segmented-option">
                <input type="radio" name="branding-direction" checked="@IsRtl" @onchange="SelectRtl" />
                <span><i class="ri-text-direction-l"></i> Right to left</span>
            </label>
        </div>
    </fieldset>
</div>

<CatExample TExample="Examples.Branding.Showcase" Title="Recolours instantly" Demo="ex-demo--block">
    <p>
        The same six things every page on this site is built from. Watch the card under Forest and
        Graphite: its fill, its border and the page behind it all come from the theme's own base ramp.
    </p>
</CatExample>

<h2 id="mark">The mark, drawn three times</h2>

<p class="cat-lede">
    An elliptical orbit resolving into an <em>S</em>, with a coral focal body and a small blue
    satellite. Pick a PNG by size and the right drawing comes out — the ladders in
    <code>assets/brand/</code> already switch tier, so never scale one to stand in for another.
</p>

<div style="display:flex; gap:32px; align-items:flex-end; flex-wrap:wrap; margin:24px 0">
    <figure style="margin:0; text-align:center">
        <img src="brand/sedna-ui-icon-96.png" width="96" height="96"
             alt="Full mark: a thin orbit, a coral focal body, and a blue satellite" />
        <figcaption class="form-hint" style="margin-top:8px">Full — stroke 2.5, 96px and up</figcaption>
    </figure>
    <figure style="margin:0; text-align:center">
        <img src="brand/sedna-ui-icon-64.png" width="64" height="64"
             alt="Compact mark: a heavier orbit and a larger satellite" />
        <figcaption class="form-hint" style="margin-top:8px">Compact — stroke 5.5, 32–64px</figcaption>
    </figure>
    <figure style="margin:0; text-align:center">
        <img src="brand/sedna-ui-icon-16.png" width="16" height="16"
             alt="Micro mark: only the orbit and the focal body, no satellite" />
        <figcaption class="form-hint" style="margin-top:8px">Micro — stroke 8, 16px, satellite dropped</figcaption>
    </figure>
</div>

<h2 id="ladders">Two ladders, and the tile</h2>

<p class="cat-lede">
    Navy for light backgrounds, Ice White for dark ones. Only the diagonal reads.
</p>

<div style="display:grid; grid-template-columns:repeat(2,1fr); gap:16px; max-width:420px; margin:24px 0">
    <div style="background:var(--slate-50); border-radius:var(--radius-surface); padding:24px; text-align:center">
        <img src="brand/sedna-ui-icon-64.png" width="64" height="64" alt="Navy mark, clearly visible on a light surface" />
    </div>
    <div style="background:var(--slate-900); border-radius:var(--radius-surface); padding:24px; text-align:center">
        <img src="brand/sedna-ui-icon-64.png" width="64" height="64" alt="The same navy mark on a dark surface, nearly invisible" />
    </div>
    <div style="background:var(--slate-50); border-radius:var(--radius-surface); padding:24px; text-align:center">
        <img src="brand/sedna-ui-icon-on-dark-64.png" width="64" height="64" alt="The Ice White mark on a light surface, washed out" />
    </div>
    <div style="background:var(--slate-900); border-radius:var(--radius-surface); padding:24px; text-align:center">
        <img src="brand/sedna-ui-icon-on-dark-64.png" width="64" height="64" alt="Ice White mark, clearly visible on a dark surface" />
    </div>
</div>
<p class="cat-lede" style="margin-top:-8px">
    Top row: <code>sedna-ui-icon-*</code>, the navy ladder. Bottom row:
    <code>sedna-ui-icon-on-dark-*</code>, the Ice White ladder. Left column: a light surface. Right
    column: a dark one.
</p>

<div style="text-align:center; margin:24px 0">
    <img src="brand/sedna-ui-tile-128.png" width="96" height="96"
         alt="The tile: the mark on its own Deep Space field, readable on any background" />
    <p class="form-hint" style="margin-top:8px">
        <code>sedna-ui-tile-*</code> — carries its own Deep Space field, for a background you do not
        control. The NuGet package icon and this site's favicon both come from it at 128×128.
    </p>
</div>

<h2 id="clear-space">Clear space, minimum sizes, misuse</h2>

<div style="display:flex; gap:16px; flex-wrap:wrap; margin:24px 0">
    <div style="background:var(--slate-50); border-radius:var(--radius-surface); padding:16px">
        <img src="brand/sedna-ui-logo-light.png" width="191" height="56" alt="Horizontal lockup for light backgrounds" />
    </div>
    <div style="background:var(--slate-900); border-radius:var(--radius-surface); padding:16px">
        <img src="brand/sedna-ui-logo-dark.png" width="191" height="56" alt="Horizontal lockup for dark backgrounds" />
    </div>
</div>

<div class="card">
    <table class="table">
        <thead><tr><th>Rule</th><th>Value</th></tr></thead>
        <tbody>
            <tr><td>Clear space, all four sides</td><td>The radius of the focal body</td></tr>
            <tr><td>Minimum size, standalone icon</td><td>20px — below that, the micro tier</td></tr>
            <tr><td>Minimum width, horizontal lockup</td><td>96px</td></tr>
            <tr><td>Misuse</td><td>Never rotate, recolour or add an effect. Never rebuild the wordmark in another face.</td></tr>
        </tbody>
    </table>
</div>

<div class="callout callout-warn">
    <i class="ri-error-warning-line"></i>
    <div class="callout-body">
        <span class="callout-title">The SVG trap</span>
        <code>sedna-ui-wordmark*.svg</code> and
        <code>sedna-ui-logo-*.svg</code> set live <code>&lt;text&gt;</code> in Outfit, so on a machine
        without that font they silently fall back to a generic sans. For a wordmark or a lockup on the
        web use the <strong>PNG</strong>, as the two lockups above do. Mark and tile SVGs are pure
        geometry and safe anywhere.
    </div>
</div>

<h2 id="palette">The palette, read live</h2>

<p class="cat-lede">
    The seven core colours the rest of the palette is generated from, read from the stylesheet the
    browser actually loaded — so they follow whichever theme is selected above.
</p>

<div class="cat-swatches">
    @foreach (var anchor in CoreAnchors)
    {
        <div class="cat-swatch">
            <span class="cat-chip" style="background: var(@anchor.Token)"></span>
            <div class="cat-swatch-text">
                <div class="cat-swatch-name">@anchor.Label</div>
                <div class="cat-swatch-value">@anchor.Token — @Value(anchor.Token)</div>
            </div>
        </div>
    }
</div>

<h2 id="decisions">Three decisions that shaped the system</h2>

<p class="cat-lede">
    Places the palette could not be applied literally. Each is encoded as a ramp relationship rather
    than a hard-coded value, so it holds for every theme above.
</p>

<div class="card">
    <table class="table">
        <thead><tr><th>Decision</th><th>Why</th></tr></thead>
        <tbody>
            <tr>
                <td><strong>Sedna Red cannot be a button</strong></td>
                <td>
                    White on Sedna Red measures 2.82:1, short of the 4.5:1 a filled control's label
                    needs. <code>--brand</code> takes ramp step 600 instead, solved for the contrast
                    floor, which reaches 4.55:1.
                </td>
            </tr>
            <tr>
                <td><strong>The accent is Orbit Blue</strong></td>
                <td>
                    A second coral would make a link and a button the same colour, so
                    <code>--accent</code> takes Orbit Blue.
                </td>
            </tr>
            <tr>
                <td><strong>Danger cannot stay red</strong></td>
                <td>
                    The old danger red sat 7° from the brand in OKLCH. Danger moves to crimson, 32°
                    away, so a destructive action and the brand separate on hue as well as on fill.
                </td>
            </tr>
        </tbody>
    </table>
</div>

@code {
    private Dictionary<string, string>? _values;

    // Read from ISednaSettings rather than kept here, so this page and the header's
    // own toggle cannot disagree about what is applied. They did: each held its own
    // copy, and changing the theme in one left the other showing the old choice
    // until a reload.
    private bool IsSedna => Settings.Current.Theme == "sedna";
    private bool IsForest => Settings.Current.Theme == "forest";
    private bool IsCobalt => Settings.Current.Theme == "cobalt";
    private bool IsGraphite => Settings.Current.Theme == "graphite";
    // "system" is stored as itself and resolves in the document. These two controls
    // have no third state, so a reader on "system" sees the variant they are
    // actually looking at rather than an empty selection.
    private bool IsLight => Settings.Current.Variant == "light";
    private bool IsDark => !IsLight;
    private bool IsColourBlind => Settings.Current.ColourBlind;
    private bool IsCompact => Settings.Current.Compact;
    private bool IsRtl => Settings.Current.Direction == "rtl";

    /// <summary>The seven fixed points every ramp is generated from — docs/BRANDING.md §1.4.</summary>
    private static readonly (string Label, string Token)[] CoreAnchors =
    [
        ("Sedna Red", "--coral-500"),
        ("Orbit Blue", "--orbit-400"),
        ("Sedna Navy", "--navy-900"),
        ("Deep Space", "--slate-900"),
        ("Navy Slate", "--slate-800"),
        ("Ice White", "--slate-50"),
        ("Dust Gray", "--slate-400"),
    ];

    // IReadOnlyList<string>, not string[]: InvokeAsync's second parameter is
    // `params object?[] args`, and a bare string[] argument is spread across that
    // params array by C#'s own array-covariance rule — readTokenValues then receives
    // each token as a separate argument instead of one array, and "names" inside it
    // becomes the first token string, indexed character by character. TokenGroups.AllTokens
    // on the Tokens page avoids this the same way.
    private static readonly IReadOnlyList<string> PaletteTokens = CoreAnchors.Select(a => a.Token).ToList();

    protected override void OnInitialized() => Settings.Changed += Refresh;

    public void Dispose() => Settings.Changed -= Refresh;

    /// <summary>
    /// Starts the settings feed once the circuit is up — an interop call cannot run during
    /// prerendering, so until this runs the segmented controls show the library's defaults
    /// while <c>Sedna.UI.boot.js</c> has already applied the real settings to
    /// <c>&lt;html&gt;</c>. Same shape as <c>CatalogueTopbar.OnAfterRenderAsync</c>.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Settings.StartAsync();
        await Read();
    }

    private Task SelectSedna() => Settings.SetThemeAsync("sedna");
    private Task SelectForest() => Settings.SetThemeAsync("forest");
    private Task SelectCobalt() => Settings.SetThemeAsync("cobalt");
    private Task SelectGraphite() => Settings.SetThemeAsync("graphite");
    private Task SelectDark() => Settings.SetVariantAsync("dark");
    private Task SelectLight() => Settings.SetVariantAsync("light");
    private Task SelectFullColour() => Settings.SetColourBlindAsync(false);
    private Task SelectColourBlind() => Settings.SetColourBlindAsync(true);
    private Task SelectComfortable() => Settings.SetCompactAsync(false);
    private Task SelectCompact() => Settings.SetCompactAsync(true);
    private Task SelectLtr() => Settings.SetDirectionAsync("ltr");
    private Task SelectRtl() => Settings.SetDirectionAsync("rtl");

    /// <summary>
    /// Every change arrives here, whichever control made it — this page's own segmented
    /// controls, the header's toggle, or the reader switching their OS while a stored
    /// <c>"system"</c> choice is live. The swatch values below are computed, so they are
    /// re-read; the controls redraw from <c>Settings.Current</c> on their own.
    /// </summary>
    private void Refresh(SednaUiSettings applied) => InvokeAsync(Read);

    private async Task Read()
    {
        _values = await Js.InvokeAsync<Dictionary<string, string>>(
            "sednaUiCatalogue.readTokenValues", PaletteTokens);
        StateHasChanged();
    }

    private string Value(string token) =>
        _values is null ? "…" : _values.GetValueOrDefault(token, "not declared");
}
