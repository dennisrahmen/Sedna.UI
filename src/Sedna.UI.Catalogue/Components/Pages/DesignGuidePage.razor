@page "/design-guide"
@using Sedna.UI.Catalogue.Guide
@inject DesignGuide Guide

@* docs/design-guide/, as a place to start from: the principles as tiles into their own page, then
   the goals of one catalogue area at a time. The area is in the address (?group=forms), so it is
   rendered by the server, can be linked to and works before the circuit connects; a component
   page's "Goals it answers" links to its goal's card with the area in the address. Nothing here
   is written twice — the words are the files'. *@

<CatHead Title="Design guide" Tier="@CatHead.Site">
    Start from what the app's user has to do: pick the area, find the goal, and start from the page
    it names. Search for a goal in your own words from the box at the top of the page, or ask the MCP
    server's <code>search</code> and <code>get_guide</code>. Every component page carries its own
    entry at its foot, under "Goes well with".
</CatHead>

<h2 id="principles">Principles <CatAnchor Id="principles" /></h2>
<p>
    How any page is composed — the spacing, colour, actions, feedback and words every goal below
    relies on. Each is a section of the <a href="/principles">principles</a> page.
</p>
<div class="cat-tiles">
    @foreach (var section in Guide.Sections)
    {
        <a class="card cat-tile" href="/principles#@section.Id">
            <span class="cat-tile-text">
                <strong>@section.Title</strong>
                <span>@GuideMarkdown.Summary(section.Markdown)</span>
            </span>
            <i class="ri-arrow-right-line cat-tile-go"></i>
        </a>
    }
</div>

<h2 id="goals">Goals <CatAnchor Id="goals" /></h2>
<p>
    What the app's user should be able to do, by the area of the catalogue that answers it. Each goal
    names the page to start from, the parts that go around it, and the usual mistake.
</p>

@* The areas are links to addresses, each a filter that is on or offered: chips, which wrap, so
   every area is in view however many there are. *@
<nav aria-label="Areas">
    <div class="chip-set">
        @foreach (var (group, count) in Areas)
        {
            var current = group == Area;
            <a class="chip @(current ? "chip--active" : null)" href="@HrefOf(group)" aria-current="@(current ? "page" : null)">
                <span class="chip-label">@group · @count</span>
            </a>
        }
    </div>
</nav>

<div class="sedna-grid cat-goals">
    @foreach (var goal in Guide.Goals.Where(g => g.Group == Area))
    {
        <article class="card cat-goal" id="@goal.Id">
            <div class="card-body">
                <h3>@goal.Goal</h3>
                <p>@goal.How</p>
                <p>
                    <strong>Start from</strong>
                    <a href="@goal.PrimaryPage">@DesignGuide.LabelOf(goal.PrimaryPage)</a>@if (Parts(goal) is { Count: > 0 } parts)
                    {
                        <text>, with </text>
                        @for (var i = 0; i < parts.Count; i++)
                        {
                            @(i == 0 ? null : i == parts.Count - 1 ? " and " : ", ")<a href="@parts[i].Page">@DesignGuide.LabelOf(parts[i].Page)</a>
                        }
                    }.
                </p>
                <p class="cat-goal-avoid"><strong>Avoid</strong> @goal.Avoid</p>
            </div>
        </article>
    }
</div>

@code {
    /// <summary>
    /// The area whose goals are shown: the address's ?group=, by its lowercase name.
    /// </summary>
    [SupplyParameterFromQuery(Name = "group")] public string? GroupQuery { get; set; }

    /// <summary>
    /// The address of an area's goals, and of one goal's card within it.
    /// </summary>
    public static string HrefOf(string group, string? goalId = null) =>
        $"/design-guide?group={group.ToLowerInvariant()}{(goalId is null ? null : "#" + goalId)}";

    private IReadOnlyList<(string Group, int Count)> Areas =>
        [.. CataloguePages.Groups
            .Select(g => (g, Guide.Goals.Count(goal => goal.Group == g)))
            .Where(a => a.Item2 > 0)];

    private string Area =>
        Areas.Select(a => a.Group).FirstOrDefault(g => string.Equals(g, GroupQuery, StringComparison.OrdinalIgnoreCase))
        ?? Areas[0].Group;

    // Each page once, and not the one to start from: three anchors on one page read as the page's
    // name three times.
    private static List<GuideAnswer> Parts(GuideGoal goal) =>
        goal.Answer.Where(a => a.Role == GuideAnswer.Part)
            .Where(a => RouteOf(a.Page) != RouteOf(goal.PrimaryPage))
            .DistinctBy(a => RouteOf(a.Page))
            .ToList();

    private static string RouteOf(string page) => page.Split('#')[0];
}
