@* A page title that may name a class, as the Tokens page's does: backticks mark code, exactly
   as they would in the prose around them, and Blazor escapes the text nodes, which is what makes
   `<dialog>` safe to write. A section heading never names code — SectionHeadingTests — so the
   example and group headings do not use this. *@
@foreach (var (text, isCode) in Parts)
{
    if (isCode)
    {
        <code>@text</code>
    }
    else
    {
        @text
    }
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = default!;

    /// <summary>The title with the backticks removed — for a slug, an aria-label,
    /// or an index.</summary>
    public static string Plain(string text) =>
        text.Replace("`", string.Empty, StringComparison.Ordinal);

    private IEnumerable<(string Text, bool IsCode)> Parts =>
        // Odd segments are inside a backtick pair. An unclosed backtick leaves its
        // tail as the last segment, so it renders as code rather than vanishing.
        Text.Split('`').Select((part, i) => (part, i % 2 == 1)).Where(p => p.part.Length > 0);
}
