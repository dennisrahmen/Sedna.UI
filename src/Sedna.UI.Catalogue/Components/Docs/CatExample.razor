@* A live demo and the source that produced it — the same file, rendered and
   printed.

   TExample is a type parameter rather than a `Type` passed to DynamicComponent so
   that the compiler proves the example exists and is a component: a typo is a
   build error instead of a blank demo. *@
@typeparam TExample where TExample : IComponent

<section class="cat-ex" data-example>
    <h2 id="@Anchor">
        <CatTitle Text="@Title" /><CatAnchor Id="@Anchor" />
    </h2>
    @ChildContent
    @if (Shell is null && !AuthShell)
    {
        <div class="ex-demo @Demo">@Instance</div>
    }
    else
    {
        @* A page recipe, drawn inside the app's frame. The code block still prints the
           example's own file, which is the content of .page and nothing else. *@
        <div class="ex-demo ex-demo--block ex-demo--flush @Demo">
            <CatShell Active="@Shell" Auth="@AuthShell" Height="@ShellHeight" Page="@ShellPage">@Instance</CatShell>
        </div>
    }
    @if (Companion is null)
    {
        <CatCode Source="@Source" Label="@($"{Title} — markup")" />
    }
    else
    {
        @* Two files, one example: the page that presents and the component it presents.
           The library's own tabs in a card, so the files are one thing to read, switched
           with the keyboard like any tablist. data-tabs rather than C# state, because a
           code block has to work before the circuit connects. *@
        <div class="card">
            <div class="card-head card-head--tabs">
                <div class="tabs" role="tablist" data-tabs aria-label="@($"{Title} — files")">
                    <button class="tab" role="tab" type="button" id="@($"{Anchor}-file-1")"
                            aria-controls="@($"{Anchor}-files-1")" aria-selected="true">
                        @ExampleFile
                    </button>
                    <button class="tab" role="tab" type="button" id="@($"{Anchor}-file-2")"
                            aria-controls="@($"{Anchor}-files-2")" aria-selected="false" tabindex="-1">
                        @CompanionFile
                    </button>
                </div>
            </div>
            <div class="card-body card-body--flush">
                <div class="tab-panel" role="tabpanel" id="@($"{Anchor}-files-1")" aria-labelledby="@($"{Anchor}-file-1")">
                    <CatCode Source="@Source" Label="@($"{Title} — {ExampleFile}")" Flush />
                </div>
                <div class="tab-panel" role="tabpanel" id="@($"{Anchor}-files-2")" aria-labelledby="@($"{Anchor}-file-2")" hidden>
                    <CatCode Source="@ExampleSource.For(Companion)" Label="@($"{Title} — {CompanionFile}")" Flush />
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// "ex-demo--block" lays the demo out as a block instead of a centred row;
    /// add "ex-demo--pad" for something that needs room around it, or
    /// "ex-demo--flush" for a demo that brings its own edge, like a whole frame.
    /// Omit for small inline things like a badge or a button.
    [Parameter] public string? Demo { get; set; }

    /// One or two sentences: when to use this, and what the reader would otherwise
    /// get wrong.
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// A second file the example needs — the app's own overlay component, for an example
    /// that presents one. A path under Examples/, such as "Interop/ReassignOrder.razor".
    /// The two files are then tabs in a card instead of one code block. The companion is
    /// never rendered on its own: it is only meaningful inside the thing that presents it.
    [Parameter] public string? Companion { get; set; }

    /// Draws the demo inside the app's frame — the full shell from /frame — with the
    /// example as the content of .page, and names the sidebar link marked current. For a
    /// page recipe: the code block still prints only the example, which is what goes
    /// inside .page.
    [Parameter] public string? Shell { get; set; }

    /// Draws the demo inside .auth-layout instead, with the example as its content: a
    /// sign-in, an invitation, a page with no navigation to offer.
    [Parameter] public bool AuthShell { get; set; }

    /// With Shell: a fixed height for the frame, such as "640px", for a recipe whose point
    /// is something that sticks while the page scrolls. The content's height otherwise.
    [Parameter] public string? ShellHeight { get; set; }

    /// With Shell: extra classes on .page, such as "page--fill".
    [Parameter] public string? ShellPage { get; set; }

    private string ExampleFile => typeof(TExample).Name + ".razor";

    private string? CompanionFile => Companion is null ? null : Path.GetFileName(Companion);

    private string Anchor => Slug.From(CatTitle.Plain(Title));

    private string Source => ExampleSource.For(typeof(TExample));

    private RenderFragment Instance => builder =>
    {
        builder.OpenComponent<TExample>(0);
        builder.CloseComponent();
    };
}
