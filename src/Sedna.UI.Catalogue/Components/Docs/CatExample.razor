@* A live demo and the source that produced it — the same file, rendered and
   printed.

   TExample is a type parameter rather than a `Type` passed to DynamicComponent so
   that the compiler proves the example exists and is a component: a typo is a
   build error instead of a blank demo. *@
@typeparam TExample where TExample : IComponent

<section class="cat-ex" data-example>
    <h2 id="@Anchor">
        <CatTitle Text="@Title" /><CatAnchor Id="@Anchor" />
    </h2>
    @ChildContent
    <div class="ex-demo @Demo">@Instance</div>
    <CatCode Source="@Source" Label="@($"{Title} — markup")" />
    @if (Companion is not null)
    {
        <p class="cat-ex-file"><code>@CompanionFile</code></p>
        <CatCode Source="@ExampleSource.For(Companion)" Label="@($"{Title} — {CompanionFile}")" />
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// "ex-demo--block" lays the demo out as a block instead of a centred row;
    /// add "ex-demo--pad" for something that needs room around it, or
    /// "ex-demo--flush" for a demo that brings its own edge, like a whole frame.
    /// Omit for small inline things like a badge or a button.
    [Parameter] public string? Demo { get; set; }

    /// One or two sentences: when to use this, and what the reader would otherwise
    /// get wrong.
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// A second file the example needs, printed under the first — the app's own overlay
    /// component, for an example that presents one. A path under Examples/, such as
    /// "Interop/ReassignOrder.razor". It is not rendered on its own: it is only
    /// meaningful inside the thing that presents it.
    [Parameter] public string? Companion { get; set; }

    private string? CompanionFile => Companion is null ? null : Path.GetFileName(Companion);

    private string Anchor => Slug.From(CatTitle.Plain(Title));

    private string Source => ExampleSource.For(typeof(TExample));

    private RenderFragment Instance => builder =>
    {
        builder.OpenComponent<TExample>(0);
        builder.CloseComponent();
    };
}
