@* The title row every content page opens with. The tier badge is the tier rule
   made visible: tier 1 is the frame, tier 2 is everything a page puts inside it,
   both CSS classes, and tier 3 is a surface the library draws — docs/surfaces.md
   lists them, and SurfacePageTests holds the badge to that list. *@
<PageTitle>@Title — Sedna.UI catalogue</PageTitle>

<div class="cat-head">
    <h1>@Title</h1>
    <span class="cat-tier">@Tier</span>
</div>
<p class="cat-lede">@ChildContent</p>

@code {
    public const string Tier1 = "tier 1 — the frame";
    public const string Tier2 = "tier 2 — classes";
    public const string Tier3 = "tier 3 — a surface";

    /// For a page about this site rather than about the package — the MCP server
    /// runs here and is not in the .nupkg, and the badge is where that is said.
    public const string Site = "this site, not the package";

    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public string Tier { get; set; } = Tier2;

    /// One or two sentences: what this family is for, and the distinction a reader
    /// would otherwise get wrong.
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
