@* The page's design-guide entry, at the foot of the page: what goes well with it, what to reach
   for instead and which goals it answers, as tiles like the landing page's. The layout renders
   it after every page's body, found by the route, so no page writes it and none can leave it
   out. The words are docs/design-guide/components/, and a page with no entry — a reference
   page — shows nothing.

   The route is a parameter, not read from NavigationManager here: the layout survives an
   in-app navigation, and a child whose parameters are unchanged is not rendered again, so
   this section kept the first page's entry — none, from the landing page — until a reload. *@
@using Sedna.UI.Catalogue.Guide
@using Sedna.UI.Catalogue.Navigation
@using Sedna.UI.Catalogue.Components.Pages
@inject DesignGuide Guide

@if (Entry is { } entry)
{
    <section class="cat-guide" aria-labelledby="@HeadingId">
        <div class="cat-guide-head">
            <h2 id="@HeadingId">Goes well with <CatAnchor Id="@HeadingId" /></h2>
            <a class="btn btn--brand" href="/design-guide"><i class="ri-compass-3-line"></i> <span>Open the design guide</span> <i class="ri-arrow-right-line"></i></a>
        </div>
        <p class="cat-guide-use">@entry.UseFor</p>

        <div class="cat-tiles">
            @foreach (var link in entry.CombineWith)
            {
                <a class="card cat-tile" href="@link.Page">
                    <span class="cat-tile-ic"><i class="@IconOf(link.Page)"></i></span>
                    <span class="cat-tile-text">
                        <strong>@DesignGuide.LabelOf(link.Page)</strong>
                        <span>@link.How</span>
                    </span>
                    <i class="ri-arrow-right-line cat-tile-go"></i>
                </a>
            }
        </div>

        @if (entry.NotFor.Count > 0)
        {
            <h3>Reach for something else</h3>
            <div class="cat-tiles">
                @foreach (var not in entry.NotFor)
                {
                    <a class="card cat-tile" href="@not.Instead">
                        <span class="cat-tile-ic cat-tile-ic--quiet"><i class="@IconOf(not.Instead)"></i></span>
                        <span class="cat-tile-text">
                            <strong>@DesignGuide.LabelOf(not.Instead)</strong>
                            <span>@not.Text</span>
                        </span>
                        <i class="ri-arrow-right-line cat-tile-go"></i>
                    </a>
                }
            </div>
        }

        @if (Guide.GoalsOf(entry) is { Count: > 0 } goals)
        {
            <h3>Goals it answers</h3>
            <ul class="cat-guide-goals">
                @foreach (var goal in goals)
                {
                    <li><a href="@DesignGuidePage.HrefOf(goal.Group, goal.Id)">@goal.Goal</a></li>
                }
            </ul>
        }
    </section>
}

@code {
    /// The id of the section's heading, which the page's contents link to.
    public const string HeadingId = "goes-well-with";

    /// The page's route, without query or fragment.
    [Parameter, EditorRequired] public string Route { get; set; } = "";

    private GuideEntry? Entry => Guide.EntryFor(Route);

    private static string IconOf(string page)
    {
        var end = page.IndexOf('#');
        var route = end < 0 ? page : page[..end];
        return CataloguePages.All.FirstOrDefault(p => p.Route == route)?.Icon ?? "ri-file-line";
    }
}
