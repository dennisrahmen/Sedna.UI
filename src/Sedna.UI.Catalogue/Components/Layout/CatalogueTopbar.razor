@* The library's own .topbar markup, written by hand.

   The three toggles are the flagship ISednaUi demo: each writes through
   sednaUi.settings.save, which stores the choice under the sedna. prefix and
   stamps <html>. The static catalogue set the data-* attributes directly and
   never touched the library's settings path at all, so nothing exercised it.

   Each carries a data-tip, which also puts the hover-hint engine on every page. *@
<header class="topbar">
    <button class="topbar-btn topbar-btn--start cat-burger" type="button"
            aria-label="Open navigation" aria-expanded="@NavOpen.ToString().ToLowerInvariant()"
            @onclick="() => NavOpenChanged.InvokeAsync(true)">
        <i class="ri-menu-line"></i>
    </button>

    @* The library's own .sidebar.collapsed rail, documented on the Shell & nav page. *@
    <button class="topbar-btn topbar-btn--start cat-collapse" type="button"
            aria-label="Collapse navigation" aria-pressed="@Collapsed.ToString().ToLowerInvariant()"
            data-tip="Collapse the sidebar to an icon rail."
            @onclick="() => CollapsedChanged.InvokeAsync(!Collapsed)">
        <i class="ri-side-bar-line"></i>
    </button>

    <a class="cat-topbrand" href="/">
        <img src="logo.png" width="24" height="24" alt="" /><span>Sedna.UI</span>
    </a>

    @* The library's .search box, in the place the frame puts it: first thing
       after the nav toggles, before the spacer.

       Everything below the input is sednaUi.search — the panel, the ranking
       and the keyboard. This markup is the whole of what an app writes, and the
       index is registered from CatalogueLayout once the circuit is up. The clear
       button is shown by CSS on :placeholder-shown, so it needs no state here. *@
    <div class="search">
        <i class="ri-search-line search-icon" aria-hidden="true"></i>
        <input class="search-input" id="cat-search" type="search" data-search
               autocomplete="off" spellcheck="false"
               placeholder="Search pages and examples…" aria-label="Search the catalogue" />
        <button class="search-clear" type="button" aria-label="Clear the search" tabindex="-1">
            <i class="ri-close-line"></i>
        </button>
    </div>

    <div class="topbar-spacer"></div>

    <button class="topbar-btn cat-toggle" type="button"
            aria-label="Light theme" aria-pressed="@Pressed(_light)"
            data-tip="Switch between the light and dark theme."
            @onclick="ToggleTheme">
        <i class="@(_light ? "ri-moon-line" : "ri-sun-line")"></i>
    </button>

    <button class="topbar-btn cat-toggle" type="button"
            aria-label="Colour-blind palette" aria-pressed="@Pressed(_colourBlind)"
            data-tip="Deuteranopia-safe palette: the go family turns blue."
            @onclick="ToggleColourBlind">
        <i class="ri-contrast-2-line"></i>
    </button>

    <button class="topbar-btn cat-toggle" type="button"
            aria-label="Compact density" aria-pressed="@Pressed(_compact)"
            data-tip="Tighten table rows."
            @onclick="ToggleDensity">
        <i class="ri-list-check-2"></i>
    </button>

    @* Every directional property in the library is a logical one, so this writes
       one attribute and the whole document mirrors. It is here rather than on a
       page about RTL because the interesting question is whether the frame and the
       example you are looking at survive it. *@
    <button class="topbar-btn cat-toggle" type="button"
            aria-label="Right-to-left" aria-pressed="@Pressed(_rtl)"
            data-tip="Mirror the document, as an RTL language would."
            @onclick="ToggleDirection">
        <i class="@(_rtl ? "ri-text-direction-l" : "ri-text-direction-r")"></i>
    </button>

    <CatLink Class="topbar-btn cat-ext" Href="@CatalogueLinks.Repo"
             Label="Repository on GitHub" data-tip="Source, issues and releases on GitHub.">
        <i class="ri-github-fill"></i>
    </CatLink>
</header>
