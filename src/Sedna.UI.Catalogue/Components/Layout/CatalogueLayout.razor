@* .layout > (.sidebar) > .content > (.topbar) > .page — the library's frame,
   written by hand. With no frame components this markup is the documentation, and
   FrameMarkupTests asserts every class it names exists in the shipped stylesheet
   and appears on the Shell & nav page.

   data-interactive is a test hook, not a style hook: a browser test that clicks a
   Blazor handler has to wait for the circuit, and RendererInfo.IsInteractive is
   Blazor's own signal for that. Waiting on it beats sleeping. *@
@inherits LayoutComponentBase
@implements IDisposable
@using Sedna.UI.Catalogue.Navigation
@inject NavigationManager Nav
@inject ISednaUi Ui
@inject CatalogueSearch Search

@* Examples/Frame/SkipLink.html, as written: a bare fragment. Under <base href="/">
   that would open the landing page, and Sedna.UI.js is what keeps it here and moves
   focus — which is what the Shell & nav page tells an app to rely on. *@
<a class="skip-link" href="#main">Skip to content</a>

@* .layout--flow: on a phone the document scrolls, so Safari collapses its toolbar
   as the reader scrolls — with the page scrolling inside a box it never does. *@
<div class="layout layout--flow @(_navOpen ? "cat-nav-open" : null)"
     data-interactive="@(RendererInfo.IsInteractive ? "true" : null)">

    <div class="cat-drawer">
        <CatalogueSidebar Collapsed="_collapsed" AreaChosen="KeepDrawerOpen" />
    </div>

    <button class="cat-scrim" type="button" aria-label="Close navigation"
            hidden="@(!_navOpen)" @onclick="CloseDrawer"></button>

    <div class="content">
        <CatalogueTopbar @bind-NavOpen="_navOpen" @bind-Collapsed="_collapsed" />

        <div class="page page--fill">
            @* The library's own answer to a footer on a short page: the page is a flex
               column, and .cat-column fills it so the footer sits at its bottom. *@
            <div class="cat-column">
                <main class="cat-main" id="main" tabindex="-1">
                    @Body
                </main>
                <CatalogueFooter />
            </div>
        </div>
    </div>
</div>

@* The command palette and the search results: app markup, like everything else on the
   page. The script fills their lists from these templates and draws nothing itself, so
   the words are this site's. Outside .layout, so neither is inside .topbar's stacking
   context. *@
<dialog class="palette" data-palette aria-label="Commands">
    <input class="palette-input" type="text" placeholder="Search commands…" aria-label="Search commands" />
    <ul class="palette-list" aria-label="Commands"></ul>
    <div class="palette-footer">
        <span><span class="kbd">&uarr;</span> <span class="kbd">&darr;</span> to move</span>
        <span><span class="kbd">Enter</span> to run</span>
        <span><span class="kbd">Esc</span> to close</span>
    </div>
    <template data-palette-item>
        <li role="presentation">
            <div class="palette-item" role="option">
                <i data-icon aria-hidden="true"></i><span data-label></span>
                <span class="palette-item-note" data-note></span>
            </div>
        </li>
    </template>
    <template data-palette-group>
        <li role="presentation"><div class="palette-group" data-group></div></li>
    </template>
    <template data-palette-empty>
        <li role="presentation"><div class="palette-empty">Nothing matches &ldquo;<span data-query></span>&rdquo;.</div></li>
    </template>
</dialog>

<div class="search-panel sedna-scroll" id="cat-search-results" data-search-panel hidden>
    <div data-search-list aria-label="Results"></div>
    <template data-search-item>
        <a class="search-item">
            <span class="search-item-title" data-title></span>
            <span class="search-item-meta">
                <span class="text-mono" data-code></span><span data-meta></span>
                <span class="search-tag" data-tag></span>
            </span>
        </a>
    </template>
    <template data-search-empty>
        <div class="search-status">Nothing matches &ldquo;<span data-query></span>&rdquo;.</div>
    </template>
    <template data-search-more>
        <div class="search-status"><span data-count></span> more. Keep typing to narrow it down.</div>
    </template>
</div>

@* Renders the overlay components ISednaOverlays presents. No element of its own, and
   its position does not matter: an open modal dialog is in the top layer. *@
<SednaOverlayHost />

@code {
    private bool _navOpen;
    private bool _collapsed;
    // Set by the sidebar when a rail area is chosen: that navigation opens the
    // area's first page, and the drawer stays so the reader can pick one of its pages.
    private bool _keepOpen;

    // This subscription is for the layout's OWN state below — the drawer and the
    // search panel. It deliberately does not carry the sidebar's active link:
    // CatalogueSidebar subscribes for itself, because a parent's StateHasChanged
    // does not reach a child whose parameters are unchanged.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // The topbar search's index and the palette's commands. Registered here rather
    // than in the topbar because the layout survives navigation, so this runs once
    // per circuit; and after the first render, because an interop call cannot run
    // during prerendering.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Ui.RegisterSearchAsync(Search.Items);

        // Until something is registered, sednaUi.palette deliberately leaves the
        // browser's own Ctrl-K alone — so a site that documents the palette and
        // never calls this has one in the stylesheet and none in the browser.
        await Ui.RegisterCommandsAsync(CatalogueCommands.All);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Navigating from inside the drawer closes it: on a phone the destination
        // is behind the panel that was just used to reach it — unless the navigation
        // was a rail area, whose pages the reader has not seen yet.
        if (!_keepOpen) _navOpen = false;
        _keepOpen = false;
        // Same for the result panel. It is anchored to a box the enhanced
        // navigation may have just moved, and a list for the previous page is
        // worse than none.
        _ = Ui.CloseSearchAsync();

        // .page is the only scroll container, so nothing the router does moves it and a
        // new page opens at the offset the previous one was scrolled to.
        _ = Ui.ScrollPageTopAsync();

        StateHasChanged();
    }

    private void CloseDrawer() => _navOpen = false;

    // On a phone the drawer stays; on a desktop a collapsed rail opens back up —
    // an area is a list of pages, and the rail alone cannot show it.
    private void KeepDrawerOpen()
    {
        _keepOpen = true;
        _collapsed = false;
    }
}
