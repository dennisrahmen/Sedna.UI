@* The library's own sidebar markup, written by hand. There are no frame
   components: this is what a consuming app writes, so a regression in .sidebar,
   .nav-link or the collapsed rail shows up here first.

   The active state is the one thing markup cannot express. ActiveLink supplies it,
   and the root link is the documented trap — with the default Prefix it is active
   on every page, so it needs NavLinkMatch.All.

   This component subscribes to LocationChanged itself, in the code-behind. It has
   to be THIS component and not the layout: a parent's StateHasChanged does not
   reach a child whose parameters are all unchanged, so a subscription one level up
   re-renders the layout and leaves the links reading the previous address until
   something else happens to change a parameter. *@
@using Sedna.UI.Catalogue.Navigation
@inject NavigationManager Nav

<aside class="sidebar @(Collapsed ? "collapsed" : null)">
    <a class="brand" href="/">
        <img class="brand-logo" src="logo.png" width="30" height="30" alt="" />
        <span class="brand-text">
            <strong>Sedna.UI</strong>
            <span class="brand-sub">catalogue</span>
        </span>
    </a>

    <nav class="nav">
        <div class="nav-scroll">
            @foreach (var group in CataloguePages.Groups)
            {
                <div class="nav-section">
                    <span class="nav-section-label">@group</span>
                    @* `item`, never `page`: Razor reads a bare `@page.` as the
                       @@page directive and the file stops compiling. *@
                    @foreach (var item in CataloguePages.InGroup(group))
                    {
                        @* data-tip is what labels the icon once the rail is
                           collapsed — the library's CSS flyout reads it. It is
                           inert while the sidebar is expanded, and the JS hint
                           engine skips .sidebar, so there is no second tooltip. *@
                        <a class="@Nav.CssClass(item.Route, match: MatchFor(item))"
                           aria-current="@Nav.AriaCurrent(item.Route, MatchFor(item))"
                           data-tip="@item.Label"
                           href="@item.Route">
                            <i class="@item.Icon"></i><span>@item.Label</span>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="nav-tools">
            <CatLink Class="nav-link nav-link-tool" Href="@CatalogueLinks.Repo" data-tip="Repository">
                <i class="ri-github-fill"></i><span>Repository</span>
            </CatLink>
            <CatLink Class="nav-link nav-link-tool" Href="@CatalogueLinks.NuGet" data-tip="NuGet">
                <i class="ri-box-3-line"></i><span>NuGet</span>
            </CatLink>
            <CatLink Class="nav-link nav-link-tool" Href="@CatalogueLinks.Icons" data-tip="Remix Icon">
                <i class="ri-brush-line"></i><span>Remix Icon</span>
            </CatLink>
        </div>
    </nav>
</aside>
