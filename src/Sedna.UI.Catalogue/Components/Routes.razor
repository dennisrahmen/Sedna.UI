@* The catalogue is an application built with Sedna.UI, not a site describing
   one, so its own chrome is the library's frame classes and a regression there
   shows up here first. CatalogueLayout writes that markup by hand — which is also
   the reference implementation a reader copies. *@
@implements IDisposable
@inject NavigationManager Nav

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(CatalogueLayout)" />

        @* Mounted only once the reader has actually navigated. FocusOnNavigate
           focuses its selector on its first render as well as on every route
           change, so rendering it unconditionally puts focus on the <h1> of the
           page somebody just arrived at: the heading paints a focus ring nobody
           asked for, and Tab from there skips the skip link, the sidebar and the
           topbar. Landing on a fresh page belongs to the reader; moving focus is
           only right when something moved them. *@
        @if (_navigated)
        {
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
</Router>

@code {
    private bool _navigated;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_navigated) return;

        // First navigation of the circuit: mounting FocusOnNavigate now is what
        // focuses this destination, and it stays mounted for every later one.
        _navigated = true;
        StateHasChanged();
    }
}
