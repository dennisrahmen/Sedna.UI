<div class="graph graph--sm" data-graph id="graph-shapes" data-graph-layout="grid" data-graph-labels="all" data-graph-spacing="loose"
     aria-label="Every shape a record can take">
    <ul class="graph-data" data-graph-data>
        <li data-node="circle" data-weight="9" data-tone="1" data-shape="circle">circle</li>
        <li data-node="square" data-weight="9" data-tone="2" data-shape="square">square</li>
        <li data-node="rounded" data-weight="9" data-tone="3" data-shape="rounded">rounded</li>
        <li data-node="diamond" data-weight="9" data-tone="4" data-shape="diamond">diamond</li>
        <li data-node="hexagon" data-weight="9" data-tone="5" data-shape="hexagon">hexagon</li>
        <li data-node="octagon" data-weight="9" data-tone="6" data-shape="octagon">octagon</li>
        <li data-node="pentagon" data-weight="9" data-tone="1" data-shape="pentagon">pentagon</li>
        <li data-node="triangle" data-weight="9" data-tone="2" data-shape="triangle">triangle</li>
        <li data-node="tag" data-weight="9" data-tone="3" data-shape="tag">tag</li>
        <li data-node="star" data-weight="9" data-tone="4" data-shape="star">star</li>
        <li data-node="barrel" data-weight="9" data-tone="5" data-shape="barrel">barrel</li>
        <li data-node="rhomboid" data-weight="9" data-tone="6" data-shape="rhomboid">rhomboid</li>
        <li data-node="vee" data-weight="9" data-tone="1" data-shape="vee">vee</li>
    </ul>
    <div class="graph-canvas"></div>
    <div class="graph-wait skeleton skeleton-block"></div>
</div>
