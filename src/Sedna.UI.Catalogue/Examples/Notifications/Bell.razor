<div class="sedna-row-wrap sedna-gap-20">
    <button class="btn btn--ghost btn--icon" type="button" aria-label="Notifications, 3 unread">
        <span class="inbox-bell"><i class="ri-notification-3-line" aria-hidden="true"></i><span class="inbox-count" aria-hidden="true">3</span></span>
    </button>
    <button class="btn btn--ghost btn--icon" type="button" aria-label="Notifications, more than 99 unread">
        <span class="inbox-bell"><i class="ri-notification-3-line" aria-hidden="true"></i><span class="inbox-count" aria-hidden="true">99+</span></span>
    </button>
    <button class="btn btn--ghost btn--icon" type="button" aria-label="Notifications, something new">
        <span class="inbox-bell"><i class="ri-notification-3-line" aria-hidden="true"></i><span class="inbox-count" aria-hidden="true"></span></span>
    </button>
    <button class="btn btn--ghost btn--icon" type="button" aria-label="Notifications">
        <span class="inbox-bell"><i class="ri-notification-3-line" aria-hidden="true"></i></span>
    </button>
</div>
