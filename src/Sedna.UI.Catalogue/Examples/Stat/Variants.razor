        <span class="stat-delta stat-delta--good"><i class="ri-arrow-up-line"></i> <span>9% on last Monday</span></span>
    </div>
    <div class="stat-row stat-row--divided">
        <span class="stat">
            <span class="stat-label">Dispatched</span>
            <span class="stat-value">248</span>
