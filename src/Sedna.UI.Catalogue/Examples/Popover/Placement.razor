<div class="sedna-row-wrap sedna-gap-3" style="justify-content:center; padding-block:150px">
    <span>
        <button class="btn" type="button" popovertarget="hold-below">Below</button>
        <div class="popover" id="hold-below" popover>
            <strong class="popover-title">Held for stock</strong>
            <p>Two of the six lines wait on a delivery due Thursday.</p>
        </div>
    </span>
    <span style="--panel-placement: block-start">
        <button class="btn" type="button" popovertarget="hold-above">Above</button>
        <div class="popover" id="hold-above" popover>
            <strong class="popover-title">Held for stock</strong>
            <p>Two of the six lines wait on a delivery due Thursday.</p>
        </div>
    </span>
    <span style="--panel-placement: inline-start">
        <button class="btn" type="button" popovertarget="hold-before">Before</button>
        <div class="popover" id="hold-before" popover>
            <strong class="popover-title">Held for stock</strong>
            <p>Two of the six lines wait on a delivery due Thursday.</p>
        </div>
    </span>
    <span style="--panel-placement: inline-end">
        <button class="btn" type="button" popovertarget="hold-after">After</button>
        <div class="popover" id="hold-after" popover>
            <strong class="popover-title">Held for stock</strong>
            <p>Two of the six lines wait on a delivery due Thursday.</p>
        </div>
    </span>
</div>
