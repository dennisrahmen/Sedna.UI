<div style="max-width:720px">
    <div class="output-head">
        <span class="health-badge health-badge--idle"><span class="health-dot"></span> Idle</span>
        <span class="sedna-push">Errors in the last hour</span>
    </div>
    <ul class="output output--columns" aria-label="Errors in the last hour">
        <li class="output-empty">
            <div class="empty-state">
                <i class="ri-checkbox-circle-line state-icon" aria-hidden="true"></i>
                <span class="empty-state-title">No errors in the last hour</span>
                <p>Lines at every other level are hidden by the level filter.</p>
                <button class="btn btn-sm" type="button">Show all levels</button>
            </div>
        </li>
    </ul>
</div>
