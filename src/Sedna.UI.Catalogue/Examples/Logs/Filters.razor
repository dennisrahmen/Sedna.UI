<div style="max-width:860px">
    <div class="toolbar">
        <div class="toolbar-filters">
            <input class="form-input form-input-sm toolbar-input toolbar-input--wide" type="search" placeholder="Search messages&hellip;" aria-label="Search messages" />
            <div class="chip-set" role="group" aria-label="Levels">
                <button class="chip" type="button" aria-pressed="false"><i class="ri-bug-line"></i><span class="chip-label">Debug</span><span class="text-nums">204</span></button>
                <button class="chip" type="button" aria-pressed="false"><i class="ri-information-line"></i><span class="chip-label">Info</span><span class="text-nums">1,318</span></button>
                <button class="chip chip--active" type="button" aria-pressed="true"><i class="ri-alert-line"></i><span class="chip-label">Warn</span><span class="text-nums">12</span></button>
                <button class="chip chip--active" type="button" aria-pressed="true"><i class="ri-close-circle-line"></i><span class="chip-label">Error</span><span class="text-nums">3</span></button>
            </div>
        </div>
        <div class="toolbar-actions">
            <div class="segmented segmented--sm" role="group" aria-label="Long lines">
                <label class="segmented-option"><input type="radio" name="log-wrap" checked /><span><i class="ri-text-wrap"></i> Wrap</span></label>
                <label class="segmented-option"><input type="radio" name="log-wrap" /><span><i class="ri-arrow-right-line"></i> One line</span></label>
            </div>
        </div>
    </div>
    <ul class="output output--columns" tabindex="0" aria-label="Warnings and errors">
        <li class="output-line output-line--warn">
            <span class="output-time">08:02:44.310</span>
            <span class="output-level"><i class="ri-alert-line" aria-hidden="true"></i> WARN</span>
            <span class="output-source">orders.reservations</span>
            <span class="output-msg">stock service slow to answer for <span class="output-id">ORD-4182</span>, took <span class="output-num">2311</span> ms</span>
        </li>
        <li class="output-line output-line--error">
            <span class="output-time">08:02:47.901</span>
            <span class="output-level"><i class="ri-close-circle-line" aria-hidden="true"></i> ERROR</span>
            <span class="output-source">orders.reservations</span>
            <span class="output-msg">reservation failed for <span class="output-id">ORD-4190</span>: <span class="output-str">"stock service returned 504"</span></span>
        </li>
        <li class="output-line output-line--warn">
