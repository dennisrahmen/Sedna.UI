<div class="card" style="max-width:640px">
    <div class="card-head"><h3>orders-console-01 environment</h3></div>
    <div class="card-body">
        <dl>
            <div class="kv">
                <dt class="k text-mono">ASPNETCORE_ENVIRONMENT</dt>
                <dd class="v">Production</dd>
                <dd class="kv-action">
                    <button class="btn btn--sm btn--ghost btn--icon" type="button" data-copy="Production" aria-label="Copy ASPNETCORE_ENVIRONMENT"><i class="ri-file-copy-line"></i></button>
                </dd>
            </div>
            <div class="kv">
                <dt class="k text-mono">ORDERS_DB</dt>
                <dd class="v"><span class="secret-value" id="env-db">Host=203.0.113.14;Database=orders;Username=orders;Password=example-only</span></dd>
                <dd class="kv-action">
                    <button class="btn btn--sm btn--ghost btn--icon" type="button" data-reveal aria-controls="env-db" aria-pressed="false" aria-label="Show ORDERS_DB">
                        <i class="ri-eye-line"></i><i class="ri-eye-off-line"></i>
                    </button>
                    <button class="btn btn--sm btn--ghost btn--icon" type="button" data-copy="Host=203.0.113.14;Database=orders;Username=orders;Password=example-only" aria-label="Copy ORDERS_DB"><i class="ri-file-copy-line"></i></button>
                </dd>
            </div>
            <div class="kv">
                <dt class="k text-mono">STOCK_API_KEY</dt>
                <dd class="v"><span class="secret-value" id="env-key">demo-key-0000-example</span></dd>
                <dd class="kv-action">
                    <button class="btn btn--sm btn--ghost btn--icon" type="button" data-reveal aria-controls="env-key" aria-pressed="false" aria-label="Show STOCK_API_KEY">
                        <i class="ri-eye-line"></i><i class="ri-eye-off-line"></i>
                    </button>
                    <button class="btn btn--sm btn--ghost btn--icon" type="button" data-copy="demo-key-0000-example" aria-label="Copy STOCK_API_KEY"><i class="ri-file-copy-line"></i></button>
                </dd>
            </div>
            <div class="kv">
                <dt class="k text-mono">SYNC_WINDOW</dt>
                <dd class="v">02:00-02:30</dd>
                <dd class="kv-action">
                    <button class="btn btn--sm btn--ghost btn--icon" type="button" data-copy="02:00-02:30" aria-label="Copy SYNC_WINDOW"><i class="ri-file-copy-line"></i></button>
                </dd>
            </div>
        </dl>
    </div>
</div>
