<div class="card" style="max-width:520px">
    <div class="card-head"><h3>Open tasks by person</h3></div>
    <div class="card-body">
        <div class="bar-list">
            <div class="bar-list-row">
                <span class="bar-list-label">Alex Fischer</span>
                <span class="bar-list-track">
                    <span class="bar-list-fill" style="--value: 100%" role="img" aria-label="18 open: 9 new, 6 in progress, 3 overdue">
                        <span class="stack-bar-segment series-info" style="--value: 50%"></span>
                        <span class="stack-bar-segment series-go" style="--value: 33%"></span>
                        <span class="stack-bar-segment series-danger" style="--value: 17%"></span>
                    </span>
                </span>
                <span class="bar-list-value">18</span>
            </div>
            <div class="bar-list-row">
                <span class="bar-list-label">Front desk</span>
                <span class="bar-list-track">
                    <span class="bar-list-fill" style="--value: 50%" role="img" aria-label="9 open: 6 new, 3 in progress">
                        <span class="stack-bar-segment series-info" style="--value: 67%"></span>
                        <span class="stack-bar-segment series-go" style="--value: 33%"></span>
                    </span>
                </span>
                <span class="bar-list-value">9</span>
            </div>
        </div>
        <div class="stack-bar-legend">
            <span class="stack-bar-key"><span class="stack-bar-swatch series-info"></span> <span>New 15</span></span>
            <span class="stack-bar-key"><span class="stack-bar-swatch series-go"></span> <span>In progress 9</span></span>
            <span class="stack-bar-key"><span class="stack-bar-swatch series-danger"></span> <span>Overdue 3</span></span>
        </div>
    </div>
</div>
