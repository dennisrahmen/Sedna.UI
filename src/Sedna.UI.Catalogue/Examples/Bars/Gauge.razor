<div class="sedna-row-wrap sedna-gap-5">
    <div class="card">
        <div class="card-body sedna-col sedna-gap-2" style="align-items: center">
            <span class="stat-label">CPU on build-runner-04</span>
            <div class="gauge series-warn" style="--value: 72%" role="img" aria-label="CPU 72%, over the 70% alert line">
                <span class="gauge-value">72%</span>
                <span class="gauge-label">CPU</span>
            </div>
            <div class="meter-scale" style="inline-size: 120px"><span>0</span><span>100</span></div>
        </div>
    </div>
    <div class="card">
        <div class="card-body sedna-col sedna-gap-2" style="align-items: center">
            <span class="stat-label">Checks passing</span>
            <div class="gauge gauge--arc series-go" style="--value: 94%" role="img" aria-label="94 of 100 checks passing">
                <span class="gauge-value">94</span>
                <span class="gauge-label">of 100</span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body sedna-col sedna-gap-2" style="align-items: center">
            <span class="stat-label">Survey score</span>
            <div class="gauge gauge--arc" style="--value: 61%" role="img" aria-label="Survey score 61 of 100">
                <span class="gauge-value">61</span>
                <span class="gauge-label">score</span>
            </div>
        </div>
    </div>
</div>
