<div class="card" style="max-width:520px">
    <div class="card-body sedna-col sedna-gap-4">
        <div class="sedna-col sedna-gap-1">
            <span class="text-sm">CPU on build-runner-04 <span class="text-muted text-nums">34%</span></span>
            <div class="meter meter--sm" role="img" aria-label="34% used; alert at 85%">
                <span class="meter-fill series-go" style="--value: 34%"></span>
                <span class="meter-mark" style="--at: 85%"></span>
            </div>
        </div>
        <div class="sedna-col sedna-gap-1">
            <span class="text-sm">Memory on build-runner-04 <span class="text-muted text-nums">58%</span></span>
            <div class="meter" role="img" aria-label="58% used; alert at 85%">
                <span class="meter-fill series-go" style="--value: 58%"></span>
                <span class="meter-mark" style="--at: 85%"></span>
            </div>
        </div>
        <div class="sedna-col sedna-gap-1">
            <span class="text-sm">Storage quota <span class="text-muted text-nums">88%</span></span>
            <div class="meter meter--lg" role="img" aria-label="88% used; alert at 85%">
                <span class="meter-fill series-warn" style="--value: 88%"></span>
                <span class="meter-mark" style="--at: 85%"></span>
            </div>
        </div>
    </div>
</div>
