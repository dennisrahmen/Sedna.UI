<div class="sedna-row-wrap sedna-end sedna-gap-5">
    <div class="gauge gauge--sm series-go" style="--value: 34%" role="img" aria-label="Memory 34%">
        <span class="gauge-value">34%</span>
        <span class="gauge-label">memory</span>
    </div>
    <div class="gauge series-go" style="--value: 58%" role="img" aria-label="Disk 58%">
        <span class="gauge-value">58%</span>
        <span class="gauge-label">disk</span>
    </div>
    <div class="gauge gauge--lg series-danger" style="--value: 93%" role="img" aria-label="Queue 93% full">
        <span class="gauge-value">93%</span>
        <span class="gauge-label">queue</span>
    </div>
    <div class="gauge gauge--sm gauge--arc series-2" style="--value: 40%" role="img" aria-label="40% of the quarter's target">
        <span class="gauge-value">40%</span>
    </div>
    <div class="gauge gauge--lg gauge--arc series-5" style="--value: 75%" role="img" aria-label="75% of the year's target">
        <span class="gauge-value">75%</span>
        <span class="gauge-label">of target</span>
    </div>
</div>
