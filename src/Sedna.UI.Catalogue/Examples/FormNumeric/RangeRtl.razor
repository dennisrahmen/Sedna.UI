<div class="form-field" role="group" aria-labelledby="rr-label" dir="rtl" lang="ar" style="max-width:420px">
    <span class="form-label" id="rr-label">قيمة الطلب</span>
    <div class="form-range-box">
        <output class="form-range-bubble" for="rr-lo" data-range-value>200</output>
        <output class="form-range-bubble" for="rr-hi" data-range-value>700</output>
        <input class="form-range" id="rr-lo" type="range" min="0" max="1000" step="50" value="200" aria-label="أدنى قيمة" list="rr-marks" />
        <input class="form-range" id="rr-hi" type="range" min="0" max="1000" step="50" value="700" aria-label="أعلى قيمة" list="rr-marks" />
        <datalist class="form-range-ticks" id="rr-marks">
            <option value="0">0</option>
            <option value="500">500</option>
            <option value="1000">1000</option>
        </datalist>
    </div>
</div>
