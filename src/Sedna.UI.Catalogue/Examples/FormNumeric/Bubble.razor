<div class="form-field" style="max-width:420px">
    <label class="form-label" for="bb-conf">Confidence threshold</label>
    <div class="form-range-box">
        <output class="form-range-bubble" for="bb-conf"><span data-range-value>85</span>%</output>
        <input class="form-range" id="bb-conf" type="range" min="0" max="100" value="85" />
    </div>
    <p class="form-hint">Reservations below this are held for a human decision.</p>
</div>
