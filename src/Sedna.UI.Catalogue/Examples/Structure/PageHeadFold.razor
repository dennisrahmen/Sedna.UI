<div style="max-width:360px">
    <div class="page-head">
        <div class="page-head-text">
            <h1>Approval queue</h1>
            <p>Items waiting on a human decision.</p>
        </div>
        <div class="page-head-actions page-head-actions--fold">
            <button class="btn" type="button"><i class="ri-refresh-line"></i> <span>Refresh</span></button>
            <button class="btn" type="button"><i class="ri-download-line"></i> <span>Export</span></button>
            <button class="btn btn--go btn--solid actions-keep" type="button"><i class="ri-check-double-line"></i> <span>Approve all</span></button>
            <div class="menu-anchor actions-more">
                <button class="btn btn--icon" type="button" data-menu-toggle aria-expanded="false" aria-label="More actions">
                    <i class="ri-more-2-fill"></i>
                </button>
                <div class="menu" hidden>
                    <button class="menu-item" type="button"><i class="ri-refresh-line"></i> <span>Refresh</span></button>
                    <button class="menu-item" type="button"><i class="ri-download-line"></i> <span>Export</span></button>
                </div>
            </div>
        </div>
    </div>
</div>
