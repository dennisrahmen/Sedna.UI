<section class="carousel" aria-roledescription="carousel" aria-label="What we do" data-carousel>
    <div class="carousel-track" tabindex="0" aria-label="Slides">
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="1 of 3">
            <div class="page-head page-head--hero page-head--hero-top" data-variant="dark" style="--hero-height: 18rem; margin-bottom: 0">
                <img class="page-head-image"
                     src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1200&amp;h=540&amp;fit=crop&amp;q=70&amp;auto=format"
                     width="1200" height="540" alt="" loading="lazy" />
                <div class="page-head-text">
                    <p class="eyebrow">Receiving</p>
                    <h2>Every pallet booked in at the dock</h2>
                </div>
                <div class="page-head-actions"><a class="btn btn--brand btn--solid" href="#">See receiving</a></div>
            </div>
        </div>
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="2 of 3">
            <div class="page-head page-head--hero page-head--hero-top" data-variant="dark" style="--hero-height: 18rem; margin-bottom: 0">
                <img class="page-head-image"
                     src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1200&amp;h=540&amp;fit=crop&amp;q=70&amp;auto=format"
                     width="1200" height="540" alt="" loading="lazy" />
                <div class="page-head-text">
                    <p class="eyebrow">Picking</p>
                    <h2>The shortest walk to every order line</h2>
                </div>
                <div class="page-head-actions"><a class="btn btn--brand btn--solid" href="#">See picking</a></div>
            </div>
        </div>
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="3 of 3">
            <div class="page-head page-head--hero page-head--hero-top" data-variant="dark" style="--hero-height: 18rem; margin-bottom: 0">
                <img class="page-head-image"
                     src="https://images.unsplash.com/photo-1565891741441-64926e441838?w=1200&amp;h=540&amp;fit=crop&amp;q=70&amp;auto=format"
                     width="1200" height="540" alt="" loading="lazy" />
                <div class="page-head-text">
                    <p class="eyebrow">Dispatch</p>
                    <h2>Loaded, labelled and gone by four</h2>
                </div>
                <div class="page-head-actions"><a class="btn btn--brand btn--solid" href="#">See dispatch</a></div>
            </div>
        </div>
    </div>
    <div class="carousel-controls">
        <button class="btn btn--icon btn--sm" type="button" data-carousel-prev aria-label="Previous slide"><i class="ri-arrow-left-s-line"></i></button>
        <div class="deck-dots">
            <button class="deck-dot" type="button" data-carousel-to="1" aria-label="Slide 1" aria-current="true"></button>
            <button class="deck-dot" type="button" data-carousel-to="2" aria-label="Slide 2"></button>
            <button class="deck-dot" type="button" data-carousel-to="3" aria-label="Slide 3"></button>
        </div>
        <button class="btn btn--icon btn--sm" type="button" data-carousel-next aria-label="Next slide"><i class="ri-arrow-right-s-line"></i></button>
    </div>
    <p class="visually-hidden" aria-live="polite" data-carousel-live data-carousel-say="Slide {position} of {count}"></p>
</section>
<p class="text-sm text-muted">Photos by Adrian Sulyok, CHUTTERSNAP and Marcin Jozwiak on Unsplash.</p>
