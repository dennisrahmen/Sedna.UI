<div class="bare-layout" style="height:300px">
    <header class="topbar">
        <div class="bare-brand">
            <div class="brand-logo" style="background:var(--brand)"></div>
            <span>Dispatch Console</span>
        </div>
    </header>
    <div class="page-banner page-banner--info" role="region" aria-label="Service notice">
        <i class="ri-information-line" aria-hidden="true"></i>
        <div class="page-banner-body">
            <span>Exports pause on Saturday from 06:00 to 08:00 UTC while the warehouse database is upgraded.</span>
        </div>
        <div class="page-banner-actions">
            <a class="btn btn--sm" href="#">Details</a>
        </div>
        <button class="page-banner-dismiss" type="button" aria-label="Dismiss this notice">
            <i class="ri-close-line" aria-hidden="true"></i>
        </button>
    </div>
    <main class="page">
        <h1>Exports</h1>
        <p class="lede">Scheduled exports run every night at 02:00 UTC.</p>
    </main>
</div>
