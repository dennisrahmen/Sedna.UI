<div class="sedna-col">
    <div class="page-banner page-banner--info" role="region" aria-label="Service notice">
        <i class="ri-information-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>The new returns flow is on for every warehouse from Monday.</span></div>
    </div>
    <div class="page-banner page-banner--warn" role="region" aria-label="Service notice">
        <i class="ri-error-warning-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>Carrier rates are delayed. Prices shown may be up to an hour old.</span></div>
    </div>
    <div class="page-banner page-banner--danger" role="region" aria-label="Service notice">
        <i class="ri-close-circle-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>Payments are failing for every order. The team is on it.</span></div>
        <div class="page-banner-actions"><a class="btn btn--sm" href="#">Status page</a></div>
    </div>
    <div class="page-banner page-banner--go" role="region" aria-label="Service notice">
        <i class="ri-checkbox-circle-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>Payments are working again. Orders held during the outage have been sent.</span></div>
        <button class="page-banner-dismiss" type="button" aria-label="Dismiss this notice">
            <i class="ri-close-line" aria-hidden="true"></i>
        </button>
    </div>
    <div class="page-banner page-banner--brand" role="region" aria-label="Announcement">
        <i class="ri-megaphone-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>Saved views can now be shared with your team.</span></div>
        <div class="page-banner-actions"><a class="btn btn--sm" href="#">Show me</a></div>
    </div>
    <div class="page-banner page-banner--secret" role="region" aria-label="Viewing as another user">
        <i class="ri-spy-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>You are viewing the console as Alex Fischer. Every change is made in their name.</span></div>
        <div class="page-banner-actions"><a class="btn btn--sm" href="#">Stop</a></div>
    </div>
    <div class="page-banner" role="region" aria-label="Service notice">
        <i class="ri-time-line" aria-hidden="true"></i>
        <div class="page-banner-body"><span>Times on this console are now shown in your own time zone.</span></div>
        <button class="page-banner-dismiss" type="button" aria-label="Dismiss this notice">
            <i class="ri-close-line" aria-hidden="true"></i>
        </button>
    </div>
</div>
