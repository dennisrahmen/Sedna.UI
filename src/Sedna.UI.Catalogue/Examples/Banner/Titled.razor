<div class="page-banner page-banner--warn" role="region" aria-labelledby="banner-maintenance-title">
    <i class="ri-tools-line" aria-hidden="true"></i>
    <div class="page-banner-body">
        <strong class="page-banner-title" id="banner-maintenance-title">Planned maintenance on Saturday</strong>
        <p>
            From 06:00 to 08:00 UTC orders can be viewed but not changed, and exports pause. Anything
            queued in that window is sent once it ends. <a href="#">What changes for you</a>
        </p>
    </div>
    <div class="page-banner-actions">
        <a class="btn btn--sm" href="#">Add to calendar</a>
    </div>
    <button class="page-banner-dismiss" type="button" aria-label="Dismiss this notice">
        <i class="ri-close-line" aria-hidden="true"></i>
    </button>
</div>

<div class="page-banner page-banner--info" role="region" aria-labelledby="banner-migration-title">
    <i class="ri-information-line" aria-hidden="true"></i>
    <div class="page-banner-body">
        <strong class="page-banner-title" id="banner-migration-title">Your saved filters moved</strong>
        <p>
            Saved filters now live under each list's view menu instead of in the sidebar. Nothing was
            removed, and the filters you shared are still shared.
        </p>
        <div class="page-banner-actions">
            <a class="btn btn--sm btn--info" href="#">Show me where</a>
            <button class="btn btn--sm btn--ghost" type="button">Remind me later</button>
        </div>
    </div>
    <button class="page-banner-dismiss" type="button" aria-label="Dismiss this notice">
        <i class="ri-close-line" aria-hidden="true"></i>
    </button>
</div>
