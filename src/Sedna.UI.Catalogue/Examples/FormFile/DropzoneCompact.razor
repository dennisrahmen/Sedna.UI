<form class="sedna-col sedna-gap-2" style="max-width:520px">
    <label class="form-label" for="reply-text">Reply</label>
    <textarea class="form-input" id="reply-text" rows="3" placeholder="Write a reply">The new label is attached — the old one is void.</textarea>
    <label class="dropzone dropzone--sm" data-dropzone>
        <input type="file" multiple class="visually-hidden" />
        <i class="ri-attachment-2"></i>
        <span>Attach a file, or drop it here</span>
    </label>
    <ul class="file-list">
        <li class="file-item">
            <i class="ri-file-pdf-2-line"></i>
            <span class="file-item-name">label-ORD-4209.pdf</span>
            <span class="file-item-size">84 KB</span>
            <button class="chip-dismiss" type="button" aria-label="Remove label-ORD-4209.pdf">
                <i class="ri-close-line"></i>
            </button>
        </li>
    </ul>
    <div class="form-actions">
        <button class="btn btn-primary" type="button"><i class="ri-send-plane-2-line"></i> Send reply</button>
    </div>
</form>
