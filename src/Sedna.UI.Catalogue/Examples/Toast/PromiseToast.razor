<!-- The toast for work still running, written once. No close button: the work's outcome replaces it. -->
<template id="toast-saving">
    <div class="toast">
        <span class="spinner" aria-hidden="true"></span>
        <div class="toast-body"><strong data-title></strong><span data-text></span></div>
    </div>
</template>

<div class="sedna-row-wrap sedna-gap-3">
    <button class="btn" type="button"
            onclick="const id = sednaUi.toast.present('toast-saving', { title: 'Saving route plan 14', text: 'Six stops, two drivers.' }, { timeout: 0 });
                     new Promise(done => setTimeout(done, 1500))
                         .then(() => sednaUi.toast.replace(id, 'Route plan 14 goes out with the 14:30 run.', { kind: 'go', title: 'Saved' }));">
        <i class="ri-route-line"></i> <span>Save the route plan</span>
    </button>
    <button class="btn" type="button"
            onclick="const id = sednaUi.toast.present('toast-saving', { title: 'Saving route plan 14', text: 'Six stops, two drivers.' }, { timeout: 0 });
                     new Promise((done, fail) => setTimeout(fail, 1500))
                         .catch(() => sednaUi.toast.replace(id, 'The planner did not answer. Nothing was saved.', { kind: 'danger', title: 'Not saved', timeout: 0 }));">
        <span>Save, and fail</span>
    </button>
</div>
