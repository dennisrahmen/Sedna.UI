<button class="btn btn--go btn--solid" type="button"
        onclick="sednaUi.toast('ORD-4182 is on its way to EU-West.', { kind: 'go', title: 'Order dispatched' })">
    Dispatch
</button>
<button class="btn" type="button"
        onclick="sednaUi.toast('2 of 5 lines are awaiting stock.', { kind: 'warn', title: 'Partially fulfilled' })">
    Ship what is in stock
</button>
<button class="btn" type="button"
        onclick="sednaUi.toast('The endpoint returned 503. Nothing was written.', { kind: 'danger', title: 'Import failed', timeout: 0 })">
    Import orders
</button>
<button class="btn" type="button"
        onclick="sednaUi.toast('Reconciliation closed 4 stale orders.')">
    Reconcile now
</button>
