<div class="sedna-grid sedna-grid--fit" style="max-width:880px">
    <fieldset class="form-section form-section--box" aria-describedby="bx-days-error">
        <legend>Schedule</legend>
        <p class="form-error" id="bx-days-error"><i class="ri-error-warning-line"></i><span>Pick at least one day.</span></p>
        <div class="form-section-body">
            <label class="form-check"><input type="checkbox" aria-invalid="true" /> <span>Weekdays</span></label>
            <label class="form-check"><input type="checkbox" aria-invalid="true" /> <span>Weekends</span></label>
        </div>
    </fieldset>

    <fieldset class="form-section form-section--box" disabled>
        <legend><span>Billing</span> <span class="badge">Owner only</span></legend>
        <div class="form-section-body">
            <div class="form-field">
                <label class="form-label" for="bx-invoice">Invoice e-mail</label>
                <input class="form-input" id="bx-invoice" type="email" value="alex.fischer@example.com" />
            </div>
            <label class="form-check"><input type="checkbox" checked /> <span>Send a paper copy</span></label>
        </div>
    </fieldset>
</div>
