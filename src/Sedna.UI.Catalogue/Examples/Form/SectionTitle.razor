<div style="max-width:520px">
    <fieldset class="form-section">
        <legend>Escalation</legend>
        <p class="form-section-hint">A <code>fieldset</code> and a <code>legend</code>, because these 3 controls are one decision.</p>
        <div class="form-section-body">
            <label class="form-check"><input type="radio" name="st-esc" checked /> <span>Page the on-call rota</span></label>
            <label class="form-check"><input type="radio" name="st-esc" /> <span>Page the team channel</span></label>
            <label class="form-check"><input type="radio" name="st-esc" /> <span>Do not page</span></label>
        </div>
    </fieldset>

    <section class="form-section">
        <h3 class="form-section-title">Danger zone</h3>
        <p class="form-section-hint">A heading and <code>.form-section-title</code>, because this groups content rather than controls — nothing here shares an answer.</p>
        <div class="form-section-body">
            <div class="form-actions form-actions--start">
                <button class="btn btn--danger" type="button">Transfer ownership</button>
                <button class="btn btn--danger" type="button">Delete project</button>
            </div>
        </div>
    </section>
</div>
