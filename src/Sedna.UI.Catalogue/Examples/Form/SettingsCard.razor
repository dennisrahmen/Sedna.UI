<div class="card" style="max-width:520px">
    <div class="card-head"><strong>Notifications</strong></div>
    <div class="card-body sedna-col sedna-gap-12">
        <label class="form-check"><input type="checkbox" checked /> <span>Notify me about new pending items</span></label>
        <div class="form-field">
            <label class="form-label" for="f-quiet">Quiet hours</label>
            <input class="form-input" id="f-quiet" type="text" value="22:00 – 07:00" />
            <p class="form-hint">Notifications are suppressed during this window. The queue still updates.</p>
        </div>
    </div>
    <div class="card-foot">
        <button class="btn" type="button">Reset</button>
        <button class="btn btn--brand btn--solid" type="button">Save</button>
    </div>
</div>
