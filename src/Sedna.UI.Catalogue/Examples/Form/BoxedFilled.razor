<div class="sedna-grid sedna-grid--fit" style="max-width:880px">
    <fieldset class="form-section form-section--box form-section--filled">
        <legend>Profile</legend>
        <div class="form-section-body">
            <div class="form-field">
                <label class="form-label" for="bx-name">Display name</label>
                <input class="form-input" id="bx-name" value="Alex Fischer" />
            </div>
            <label class="form-check"><input type="checkbox" checked /> <span>Show my status to the team</span></label>
        </div>
    </fieldset>

    <fieldset class="form-section form-section--box">
        <legend>Backup</legend>
        <div class="form-section-body">
            <label class="form-check"><input type="checkbox" checked /> <span>Back up every night</span></label>
            <fieldset class="form-section form-section--box">
                <legend>Where to</legend>
                <div class="form-section-body">
                    <div class="form-field">
                        <label class="form-label" for="bx-store">Target</label>
                        <input class="form-input" id="bx-store" value="backup-store-02" />
                    </div>
                </div>
            </fieldset>
        </div>
    </fieldset>
</div>
