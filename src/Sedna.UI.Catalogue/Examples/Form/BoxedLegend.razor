<div class="sedna-grid sedna-grid--fit" style="max-width:880px">
    <fieldset class="form-section form-section--box">
        <legend><i class="ri-lock-line"></i> <span>Access</span> <span class="badge">2</span></legend>
        <p class="form-section-hint">Who can open this workspace besides its owner.</p>
        <div class="form-section-body">
            <label class="form-check"><input type="checkbox" checked /> <span>Members of the team</span></label>
            <label class="form-check"><input type="checkbox" checked /> <span>Guests with a link</span></label>
        </div>
    </fieldset>

    <fieldset class="form-section form-section--box">
        <legend>Retention</legend>
        <span class="form-section-action"><button class="btn btn--sm btn--ghost" type="button">Reset to defaults</button></span>
        <div class="form-section-body">
            <div class="form-field">
                <label class="form-label" for="bx-retain">Keep history for</label>
                <div class="input-group">
                    <input class="form-input" id="bx-retain" type="number" value="90" />
                    <span class="input-affix">days</span>
                </div>
            </div>
            <label class="form-check"><input type="checkbox" /> <span>Delete attachments with their record</span></label>
        </div>
    </fieldset>
</div>
