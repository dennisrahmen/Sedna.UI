<div class="sedna-grid sedna-grid--fit" style="max-width:880px">
    <fieldset class="form-section form-section--box">
        <legend><label class="switch"><input type="checkbox" /> <span>Proxy</span></label></legend>
        <div class="form-section-body choice-dependent choice-dependent--dim">
            <div class="form-field">
                <label class="form-label" for="bx-proxy">Address</label>
                <input class="form-input" id="bx-proxy" value="198.51.100.20:3128" />
            </div>
            <label class="form-check"><input type="checkbox" checked /> <span>Skip it for local addresses</span></label>
        </div>
    </fieldset>

    <fieldset class="form-section form-section--box">
        <legend><label class="form-check"><input type="checkbox" checked /> <span>Back up every night</span></label></legend>
        <div class="form-section-body choice-dependent choice-dependent--hide">
            <div class="form-field">
                <label class="form-label" for="bx-target">Target</label>
                <input class="form-input" id="bx-target" value="backup-store-02" />
            </div>
        </div>
    </fieldset>
</div>
