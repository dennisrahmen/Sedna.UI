<div class="graph-frame" data-graph-frame>
    <div class="toolbar">
        <div class="toolbar-filters">
            <select class="form-select form-select--sm toolbar-input" data-graph-option="zoom" aria-label="Zoom">
                <option value="">Other zoom</option>
                <option value="50">50 %</option>
                <option value="100">100 %</option>
                <option value="150">150 %</option>
                <option value="200">200 %</option>
            </select>
        </div>
    </div>
    <div class="card">
        <div class="graph" data-graph id="xp-zoom" aria-label="The parts of a bicycle">
            <ul class="graph-data" data-graph-data>
                <li data-node="bike" data-tone="1" data-shape="rounded" data-root>Bicycle</li>
                <li data-node="frame" data-tone="2">Frame</li>
                <li data-node="fork" data-tone="2">Fork</li>
                <li data-node="wheels" data-tone="3">Wheels</li>
                <li data-node="front" data-tone="3">Front wheel</li>
                <li data-node="rear" data-tone="3">Rear wheel</li>
                <li data-node="drive" data-tone="4">Drivetrain</li>
                <li data-node="chain" data-tone="4">Chain</li>
                <li data-node="gears" data-tone="4">Gears</li>
                <li data-node="brakes" data-tone="5">Brakes</li>

                <li data-edge data-source="bike" data-target="frame">A bicycle is built on its frame.</li>
                <li data-edge data-source="frame" data-target="fork">The fork turns in the frame.</li>
                <li data-edge data-source="bike" data-target="wheels">A bicycle has two wheels.</li>
                <li data-edge data-source="wheels" data-target="front">One wheel is at the front.</li>
                <li data-edge data-source="wheels" data-target="rear">One wheel is at the rear.</li>
                <li data-edge data-source="fork" data-target="front">The front wheel sits in the fork.</li>
                <li data-edge data-source="bike" data-target="drive">A bicycle is driven by its drivetrain.</li>
                <li data-edge data-source="drive" data-target="chain">The drivetrain turns a chain.</li>
                <li data-edge data-source="drive" data-target="gears">The drivetrain changes gear.</li>
                <li data-edge data-source="chain" data-target="rear">The chain drives the rear wheel.</li>
                <li data-edge data-source="bike" data-target="brakes">A bicycle stops with its brakes.</li>
            </ul>
            <div class="graph-canvas"></div>
            <div class="graph-tools graph-tools--bottom" role="toolbar" aria-label="Zoom">
                <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="zoom-out" aria-label="Zoom out" data-tip="Zoom out"><i class="ri-zoom-out-line"></i></button>
                <input class="form-range form-range--sm" type="range" step="5" data-graph-option="zoom" aria-label="Zoom, in percent" />
                <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="zoom-in" aria-label="Zoom in" data-tip="Zoom in"><i class="ri-zoom-in-line"></i></button>
                <span class="graph-tools-sep"></span>
                <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="fit" aria-label="Fit" data-tip="Fit"><i class="ri-focus-3-line"></i></button>
            </div>
            <div class="graph-wait skeleton skeleton-block"></div>
        </div>
    </div>
</div>
