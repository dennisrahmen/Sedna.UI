<div class="sedna-row-wrap sedna-gap-12">
    <button class="btn" type="button" data-tip="Reload the list from the server. Unsaved notes are kept.">
        <i class="ri-refresh-line"></i> <span>Refresh</span>
    </button>
    <button class="btn btn--icon" type="button" aria-label="Export"
            data-tip="Downloads every row that matches the current filters, as CSV.">
        <i class="ri-download-2-line"></i>
    </button>
    <button class="btn btn--danger" type="button"
            data-tip="The order goes back to unreserved and its stock is freed." data-tip-pos="right">
        <i class="ri-delete-bin-line"></i> <span>Delete reservation</span>
    </button>
    <span class="badge badge--warn" data-tip="2 of 5 lines have no stock in any warehouse."
          data-tip-pos="bottom">Awaiting stock</span>
    <span class="health-badge health-badge--degraded" data-tip="1 of 3 warehouses is not answering."
          data-tip-pos="top"><span class="health-dot"></span> <span>Degraded</span></span>
</div>
