<div class="card" style="position:relative; height:240px">
    <div class="card-body sedna-col sedna-gap-2 sedna-start">
        <button class="btn btn--go btn--solid" type="button">Approve all</button>
        <p class="form-hint">Page content behind the dim.</p>
    </div>
    <div class="spotlight-hole spotlight-ring"
         style="top:8px; left:12px; width:109px; height:44px; border-radius:var(--radius-control)"></div>
    <div class="spotlight-tip" style="top:64px; left:12px">
        <span class="spotlight-tip-title">Approve in one go</span>
        Applies every reservation above the confidence threshold. You can still undo each one
        afterwards.
        <div class="spotlight-tip-actions">
            <span class="spotlight-step">2 of 5</span>
            <button class="btn btn--sm btn--brand btn--solid" type="button">Next</button>
        </div>
    </div>
</div>
