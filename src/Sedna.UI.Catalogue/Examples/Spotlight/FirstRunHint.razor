<div class="card" style="position:relative; height:230px">
    <div class="card-body">
        <div class="toolbar sedna-mb-0">
            <div class="toolbar-filters">
                <input class="form-input toolbar-input" type="search" placeholder="Search orders…" aria-label="Search orders" />
            </div>
            <button class="btn btn--icon" type="button" aria-label="Saved views"><i class="ri-bookmark-line"></i></button>
        </div>
    </div>
    <div class="spotlight-hole spotlight-ring"
         style="top:8px; inset-inline-end:12px; width:44px; height:44px; border-radius:var(--radius-control)"></div>
    <div class="spotlight-tip" style="top:64px; inset-inline-end:12px">
        <span class="spotlight-tip-title">Saved views live here</span>
        Whatever you have filtered to can be kept and reopened later. Your views are yours alone.
        <div class="spotlight-tip-actions">
            <button class="btn btn--sm btn--brand btn--solid" type="button">Dismiss</button>
        </div>
    </div>
</div>
