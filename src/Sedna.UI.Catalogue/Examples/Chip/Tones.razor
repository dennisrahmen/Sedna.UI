<div class="chip-set">
    <span class="chip">
        <span class="chip-label">Neutral</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Neutral"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--brand">
        <span class="chip-label">Terminal</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Terminal"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--go">
        <span class="chip-label">Active</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Active"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--warn">
        <span class="chip-label">Pending</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Pending"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--danger">
        <span class="chip-label">Failed</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Failed"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--info">
        <span class="chip-label">Draft</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Draft"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--secret">
        <span class="chip-label">Private</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Private"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--cyan">
        <span class="chip-label">Retail</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Retail"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--orange">
        <span class="chip-label">Wholesale</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Wholesale"><i class="ri-close-line"></i></button>
    </span>
    <span class="chip chip--teal">
        <span class="chip-label">Partner</span>
        <button class="chip-dismiss" type="button" aria-label="Stop filtering by Partner"><i class="ri-close-line"></i></button>
    </span>
</div>
