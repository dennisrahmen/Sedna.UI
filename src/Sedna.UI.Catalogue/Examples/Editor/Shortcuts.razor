<div class="form-field">
    <label class="form-label" for="press-value">Press notice</label>
    <div class="editor" data-editor id="press" style="--editor-max-height: 22rem">
        <div class="editor-toolbar" role="toolbar" aria-label="Formatting">
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="bold" aria-label="Bold" data-tip="Bold · Ctrl+B"><i class="ri-bold"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="italic" aria-label="Italic" data-tip="Italic · Ctrl+I"><i class="ri-italic"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="strike" aria-label="Strikethrough" data-tip="Strikethrough"><i class="ri-strikethrough"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="code" aria-label="Code" data-tip="Code"><i class="ri-code-line"></i></button>
            <span class="editor-sep" role="separator"></span>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="header" value="2" aria-label="Heading" data-tip="Heading"><i class="ri-h-2"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="blockquote" aria-label="Quote" data-tip="Quote"><i class="ri-double-quotes-l"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="code-block" aria-label="Code block" data-tip="Code block"><i class="ri-code-box-line"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="rule" aria-label="Horizontal rule" data-tip="Horizontal rule"><i class="ri-separator"></i></button>
            <span class="editor-sep" role="separator"></span>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="direction" value="rtl" aria-label="Right to left" data-tip="Right to left"><i class="ri-text-direction-r"></i></button>
        </div>
        <div class="editor-body prose" data-editor-body></div>
        <textarea id="press-value" name="press" data-editor-value hidden placeholder="Try # and a space, &gt; and a space, --- and Enter, or **bold**">&lt;h2&gt;Warehouse reopens on Monday&lt;/h2&gt;&lt;p&gt;Bay 4 is back in use after the racking was moved.&lt;/p&gt;&lt;hr&gt;&lt;p&gt;Questions go to the dock office.&lt;/p&gt;</textarea>
    </div>
</div>
