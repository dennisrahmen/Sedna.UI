<div class="form-field">
    <label class="form-label" for="rates-value">Carrier rates</label>
    <div class="editor" data-editor id="rates" style="--editor-max-height: 20rem">
        <div class="editor-toolbar" role="toolbar" aria-label="Formatting">
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-format="bold" aria-label="Bold" data-tip="Bold · Ctrl+B"><i class="ri-bold"></i></button>
            <span class="editor-sep" role="separator"></span>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-insert" aria-label="Insert a table" data-tip="Insert a table"><i class="ri-table-2"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-row-above" aria-label="Row above" data-tip="Row above"><i class="ri-insert-row-top"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-row-below" aria-label="Row below" data-tip="Row below"><i class="ri-insert-row-bottom"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-column-before" aria-label="Column before" data-tip="Column before"><i class="ri-insert-column-left"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-column-after" aria-label="Column after" data-tip="Column after"><i class="ri-insert-column-right"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-row-delete" aria-label="Delete the row" data-tip="Delete the row"><i class="ri-delete-row"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-column-delete" aria-label="Delete the column" data-tip="Delete the column"><i class="ri-delete-column"></i></button>
        <button class="btn btn--ghost btn--icon btn--sm" type="button" data-editor-action="table-delete" aria-label="Delete the table" data-tip="Delete the table"><i class="ri-delete-bin-line"></i></button>
        </div>
        <div class="editor-body prose" data-editor-body></div>
        <textarea id="rates-value" name="rates" data-editor-value hidden placeholder="Insert a table to start">&lt;p&gt;Rates from the dock, per pallet:&lt;/p&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Zone&lt;/td&gt;&lt;td&gt;Price&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;North&lt;/td&gt;&lt;td&gt;12.50&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;</textarea>
    </div>
</div>
