<div class="sedna-col sedna-gap-2">
    <div class="sedna-row-wrap sedna-gap-3">
        <span class="health-badge health-badge--live"><span class="health-dot"></span> <span>Live</span></span>
        <span class="health-badge health-badge--streaming"><span class="health-dot"></span> <span>Streaming</span></span>
        <span class="health-badge health-badge--connecting"><span class="health-dot"></span> <span>Connecting</span></span>
        <span class="health-badge health-badge--idle"><span class="health-dot"></span> <span>Idle</span></span>
        <span class="health-badge health-badge--degraded"><span class="health-dot"></span> <span>Degraded</span></span>
        <span class="health-badge health-badge--down"><span class="health-dot"></span> <span>Disconnected</span></span>
    </div>
    <div class="sedna-row-wrap sedna-gap-3">
        <span class="stale"><i class="ri-time-line"></i> <span>updated 4s ago</span></span>
        <span class="stale stale--warn"><i class="ri-time-line"></i> <span>updated 6m ago</span></span>
    </div>
</div>
