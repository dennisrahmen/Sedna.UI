<div class="form-field">
    <span class="form-label" id="rt-fit-label">How well did the packaging fit?</span>
    <div class="rating" role="radiogroup" aria-labelledby="rt-fit-label">
        <span class="rating-star">
            <label class="rating-half"><input type="radio" name="rt-fit" value="0.5" aria-label="Half a star" /></label>
            <label class="rating-half"><input type="radio" name="rt-fit" value="1" aria-label="1 star" /></label>
        </span>
        <span class="rating-star">
            <label class="rating-half"><input type="radio" name="rt-fit" value="1.5" aria-label="1 and a half stars" /></label>
            <label class="rating-half"><input type="radio" name="rt-fit" value="2" aria-label="2 stars" /></label>
        </span>
        <span class="rating-star">
            <label class="rating-half"><input type="radio" name="rt-fit" value="2.5" aria-label="2 and a half stars" /></label>
            <label class="rating-half"><input type="radio" name="rt-fit" value="3" aria-label="3 stars" /></label>
        </span>
        <span class="rating-star">
            <label class="rating-half"><input type="radio" name="rt-fit" value="3.5" aria-label="3 and a half stars" checked /></label>
            <label class="rating-half"><input type="radio" name="rt-fit" value="4" aria-label="4 stars" /></label>
        </span>
        <span class="rating-star">
            <label class="rating-half"><input type="radio" name="rt-fit" value="4.5" aria-label="4 and a half stars" /></label>
            <label class="rating-half"><input type="radio" name="rt-fit" value="5" aria-label="5 stars" /></label>
        </span>
    </div>
</div>
