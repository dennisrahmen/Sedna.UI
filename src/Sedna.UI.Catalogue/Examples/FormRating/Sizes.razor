<div class="sedna-col sedna-gap-12">
    <div class="sedna-row-wrap">
        <div class="rating rating--sm" role="radiogroup" aria-label="Rate the route, small">
            <label class="rating-star"><input type="radio" name="rt-size-sm" value="1" aria-label="1 star" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-sm" value="2" aria-label="2 stars" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-sm" value="3" aria-label="3 stars" checked /></label>
            <label class="rating-star"><input type="radio" name="rt-size-sm" value="4" aria-label="4 stars" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-sm" value="5" aria-label="5 stars" /></label>
        </div>
        <input class="form-input form-input--sm sedna-w-fit" type="text" placeholder="Add a comment" aria-label="Comment on the route, small" />
        <button class="btn btn--sm" type="button">Send</button>
    </div>
    <div class="sedna-row-wrap">
        <div class="rating" role="radiogroup" aria-label="Rate the route">
            <label class="rating-star"><input type="radio" name="rt-size-md" value="1" aria-label="1 star" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-md" value="2" aria-label="2 stars" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-md" value="3" aria-label="3 stars" checked /></label>
            <label class="rating-star"><input type="radio" name="rt-size-md" value="4" aria-label="4 stars" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-md" value="5" aria-label="5 stars" /></label>
        </div>
        <input class="form-input sedna-w-fit" type="text" placeholder="Add a comment" aria-label="Comment on the route" />
        <button class="btn" type="button">Send</button>
    </div>
    <div class="sedna-row-wrap">
        <div class="rating rating--lg" role="radiogroup" aria-label="Rate the route, large">
            <label class="rating-star"><input type="radio" name="rt-size-lg" value="1" aria-label="1 star" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-lg" value="2" aria-label="2 stars" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-lg" value="3" aria-label="3 stars" checked /></label>
            <label class="rating-star"><input type="radio" name="rt-size-lg" value="4" aria-label="4 stars" /></label>
            <label class="rating-star"><input type="radio" name="rt-size-lg" value="5" aria-label="5 stars" /></label>
        </div>
        <input class="form-input form-input--lg sedna-w-fit" type="text" placeholder="Add a comment" aria-label="Comment on the route, large" />
        <button class="btn btn--lg" type="button">Send</button>
    </div>
</div>
