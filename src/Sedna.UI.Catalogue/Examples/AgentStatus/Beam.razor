<div class="sedna-row-wrap sedna-gap-3" style="align-items: start">
    <div class="card beam" style="width: 340px">
        <div class="card-head"><strong>Summarising 214 tickets</strong><span class="badge badge-ai"><i class="ri-sparkling-2-line"></i>AI</span></div>
        <div class="card-body sedna-col sedna-gap-2" aria-busy="true">
            <span class="skeleton skeleton--agent skeleton-text" style="width: 94%"></span>
            <span class="skeleton skeleton--agent skeleton-text" style="width: 82%"></span>
            <span class="skeleton skeleton--agent skeleton-text" style="width: 58%"></span>
        </div>
        <div class="card-foot card-foot--split">
            <span class="agent-status"><span class="orb" data-orb="reading" role="img" aria-label="Reading"></span><span class="agent-status-label text-shimmer">Reading the tickets</span><span class="agent-status-time">0:09</span></span>
            <button class="btn btn-sm btn-ghost" type="button">Cancel</button>
        </div>
    </div>
    <div class="sedna-col sedna-gap-3" style="width: 300px">
        <div class="form-field">
            <label class="form-label" for="beam-refine">Refine the summary</label>
            <input class="form-input beam beam--glow" id="beam-refine" value="Group the tickets by region" />
            <span class="form-hint">Click into the field: the focus edge and ring stay under the beam.</span>
        </div>
        <div class="sedna-row sedna-gap-2">
            <button class="btn beam" type="button"><i class="ri-sparkling-2-line"></i>Drafting reply</button>
            <button class="btn btn-ghost" type="button">Stop</button>
        </div>
    </div>
</div>
