<div class="sedna-grid sedna-grid--sm sedna-grid--fit" style="max-width:640px">
    <figure class="media-figure">
        <div class="skeleton skeleton-image" aria-hidden="true"></div>
        <figcaption>Loading. A <code>.skeleton-image</code> is 16:9, like the frame it turns into.</figcaption>
    </figure>
    <figure class="media-figure">
        <div class="media-frame">
            <img src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=640&amp;h=360&amp;fit=crop&amp;q=70&amp;auto=format"
                 width="640" height="360" loading="lazy"
                 alt="A long warehouse aisle between tall racks of stored goods" />
        </div>
        <figcaption>Loaded, at the same height. Photo by Ruchindra Gunasekara on Unsplash.</figcaption>
    </figure>
    <figure class="media-figure" style="--media-ratio: 4 / 3">
        <div class="media-frame">
            <img src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=640&amp;h=480&amp;fit=crop&amp;q=70&amp;auto=format"
                 width="640" height="480" loading="lazy"
                 alt="The same aisle in a 4:3 frame" />
        </div>
        <figcaption><code>--media-ratio: 4 / 3</code> on the figure. Any frame inside follows it.</figcaption>
    </figure>
</div>
