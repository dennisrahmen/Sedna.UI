<div class="sedna-col sedna-gap-4" style="max-width:640px">
    <ul class="file-grid" aria-label="Brand files">
        <li class="file-tile">
            <a class="file-tile-open" href="#">
                <span class="file-tile-thumb file-tile-thumb--transparency">
                <svg width="160" height="90" viewBox="0 0 160 90" role="img" aria-label="logo-mark.svg">
                    <circle cx="45" cy="45" r="28" fill="currentColor" style="color: var(--brand)" />
                    <rect x="84" y="31" width="52" height="28" rx="6" fill="currentColor" style="color: var(--info-fg)" />
                </svg>
                </span>
                <span class="file-name">logo-mark.svg</span>
            </a>
            <span class="file-meta"><span>4 KB</span></span>
        </li>
    </ul>

    <div class="sedna-row-wrap sedna-gap-2" aria-label="Attached, not yet uploaded">
        <span class="file-thumb file-thumb--transparency">
            <svg width="48" height="48" viewBox="0 0 48 48" role="img" aria-label="badge.svg">
                <circle cx="24" cy="24" r="14" fill="currentColor" style="color: var(--brand)" />
            </svg>
            <button class="chip-dismiss" type="button" aria-label="Remove badge.svg"><i class="ri-close-line"></i></button>
        </span>
    </div>

    <div class="choice-tiles" role="radiogroup" aria-label="Logo for the invoice header">
        <label class="choice-tile">
            <input type="radio" name="invoice-logo" value="mark" checked />
            <span class="choice-tile-art choice-tile-art--transparency">
                <svg width="160" height="90" viewBox="0 0 160 90" role="img" aria-label="Mark alone">
                    <circle cx="45" cy="45" r="28" fill="currentColor" style="color: var(--brand)" />
                    <rect x="84" y="31" width="52" height="28" rx="6" fill="currentColor" style="color: var(--info-fg)" />
                </svg>
            </span>
            <span class="choice-tile-title">Mark alone</span>
            <span class="choice-tile-hint">Transparent, sits on any paper</span>
        </label>
        <label class="choice-tile">
            <input type="radio" name="invoice-logo" value="boxed" />
            <span class="choice-tile-art choice-tile-art--transparency">
                <svg width="160" height="90" viewBox="0 0 160 90" role="img" aria-label="Mark on a box">
                    <rect width="160" height="90" rx="8" fill="currentColor" style="color: var(--surface-strong)" />
                    <circle cx="45" cy="45" r="28" fill="currentColor" style="color: var(--brand)" />
                    <rect x="84" y="31" width="52" height="28" rx="6" fill="currentColor" style="color: var(--info-fg)" />
                </svg>
            </span>
            <span class="choice-tile-title">Mark on a box</span>
            <span class="choice-tile-hint">Carries its own background</span>
        </label>
    </div>
</div>
