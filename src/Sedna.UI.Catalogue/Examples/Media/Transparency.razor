<div class="sedna-grid sedna-grid--sm sedna-grid--fit" style="max-width:640px">
    <figure class="media-figure">
        <div class="media-frame media-frame--transparency">
            <svg width="160" height="90" viewBox="0 0 160 90" role="img" aria-label="Logo, transparent background">
                <circle cx="45" cy="45" r="28" fill="currentColor" style="color: var(--brand)" />
                <rect x="84" y="31" width="52" height="28" rx="6" fill="currentColor" style="color: var(--info-fg)" />
            </svg>
        </div>
        <figcaption>A transparent background: the squares show through around the mark.</figcaption>
    </figure>
    <figure class="media-figure">
        <div class="media-frame media-frame--transparency">
            <svg width="160" height="90" viewBox="0 0 160 90" role="img" aria-label="Logo, white background">
                <rect width="160" height="90" fill="white" />
                <circle cx="45" cy="45" r="28" fill="currentColor" style="color: var(--brand)" />
                <rect x="84" y="31" width="52" height="28" rx="6" fill="currentColor" style="color: var(--info-fg)" />
            </svg>
        </div>
        <figcaption>The same mark on a baked-in white box, which the squares give away.</figcaption>
    </figure>
</div>
