<div class="sedna-row-wrap sedna-gap-3">
    <div class="sedna-col sedna-center sedna-gap-1"><button class="btn btn-icon btn-mic" type="button" aria-label="Talk"><i class="ri-mic-line"></i></button><code>idle</code></div>
    <div class="sedna-col sedna-center sedna-gap-1"><button class="btn btn-icon btn-mic" type="button" data-state="listening" style="--level: 0.5" aria-label="Stop listening"><i class="ri-mic-fill"></i></button><code>listening</code></div>
    <div class="sedna-col sedna-center sedna-gap-1"><button class="btn btn-icon btn-mic" type="button" data-state="muted" aria-label="Unmute"><i class="ri-mic-off-line"></i></button><code>muted</code></div>
    <div class="sedna-col sedna-center sedna-gap-1"><button class="btn btn-icon btn-mic" type="button" disabled aria-label="Talk"><i class="ri-mic-line"></i></button><code>no microphone</code></div>
</div>
