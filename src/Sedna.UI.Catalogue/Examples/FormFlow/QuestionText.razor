<div style="max-width:640px">
    <a class="back-link" href="#"><i class="ri-arrow-left-line"></i> <span>Back</span></a>
    <ol class="steps">
        <li data-state="done">Business</li>
        <li data-state="current">Contact</li>
        <li>Delivery</li>
        <li>Payment</li>
        <li>Check</li>
    </ol>
    <form>
        <div class="form-field">
            <h1><label for="fft-mail">What email address should we send invoices to?</label></h1>
            <p class="form-hint" id="fft-mail-hint">We only use it for invoices and statements.</p>
            <input class="form-input sedna-w sedna-w--lg" id="fft-mail" type="email" name="invoice-email"
                   autocomplete="email" spellcheck="false" aria-describedby="fft-mail-hint" />
        </div>
        <div class="form-actions form-actions--start">
            <button class="btn btn--brand btn--solid" type="submit">Continue</button>
        </div>
    </form>
</div>
