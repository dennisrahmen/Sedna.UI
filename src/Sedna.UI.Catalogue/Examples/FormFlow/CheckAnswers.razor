<form style="max-width:720px">
    <h2 class="sedna-mt-0">Check your answers before opening the account</h2>

    <h3>Your business</h3>
    <dl>
        <div class="kv kv--text">
            <dt class="k">Business name</dt>
            <dd class="v">Northwind Retail</dd>
            <dd class="kv-action"><a href="#">Change<span class="visually-hidden"> business name</span></a></dd>
        </div>
        <div class="kv kv--text">
            <dt class="k">Registered address</dt>
            <dd class="v">12 Harbour Road<br />Unit 4<br />Example Town</dd>
            <dd class="kv-action"><a href="#">Change<span class="visually-hidden"> registered address</span></a></dd>
        </div>
        <div class="kv kv--text">
            <dt class="k">Trading since</dt>
            <dd class="v">March 2019</dd>
            <dd class="kv-action"><a href="#">Change<span class="visually-hidden"> date you started trading</span></a></dd>
        </div>
    </dl>

    <h3>Contact</h3>
    <dl>
        <div class="kv kv--text">
            <dt class="k">Name</dt>
            <dd class="v">Alex Fischer</dd>
            <dd class="kv-action"><a href="#">Change<span class="visually-hidden"> name</span></a></dd>
        </div>
        <div class="kv kv--text">
            <dt class="k">Email for invoices</dt>
            <dd class="v">alex.fischer@example.com</dd>
            <dd class="kv-action"><a href="#">Change<span class="visually-hidden"> email for invoices</span></a></dd>
        </div>
        <div class="kv kv--text">
            <dt class="k">Customer number</dt>
            <dd class="v">TRD-20418</dd>
        </div>
    </dl>

    <h3>Now send your application</h3>
    <p>By sending this application you confirm that, to the best of your knowledge, the details you have given are correct.</p>
    <div class="form-actions form-actions--start">
        <button class="btn btn--go btn--solid" type="submit">Accept and send</button>
    </div>
</form>
