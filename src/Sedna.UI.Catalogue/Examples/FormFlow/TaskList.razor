<div style="max-width:640px">
    <div class="page-head">
        <div class="page-head-text">
            <h2>Trade account application incomplete</h2>
            <p>You have completed 2 of 6 tasks.</p>
        </div>
    </div>

    <div class="sedna-col sedna-gap-20">
        <div class="card">
            <div class="card-head"><strong>1. Before you start</strong></div>
            <ul class="list list--tasks">
                <li>
                    <a class="list-row" href="#">
                        <span class="list-main"><span class="list-title">Check you can open an account</span></span>
                        <span class="list-status">Completed</span>
                    </a>
                </li>
                <li>
                    <a class="list-row" href="#">
                        <span class="list-main">
                            <span class="list-title">Tell us about your business</span>
                            <span class="list-sub">Its name, its registered address and when it started trading.</span>
                        </span>
                        <span class="list-status">Completed</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="card">
            <div class="card-head"><strong>2. Apply</strong></div>
            <ul class="list list--tasks">
                <li>
                    <a class="list-row" href="#">
                        <span class="list-main"><span class="list-title">Contact details</span></span>
                        <span class="list-status"><span class="badge badge--info">In progress</span></span>
                    </a>
                </li>
                <li>
                    <a class="list-row" href="#">
                        <span class="list-main"><span class="list-title">Delivery addresses and the goods-in hours of every depot that will receive orders</span></span>
                        <span class="list-status"><span class="badge badge--danger">There is a problem</span></span>
                    </a>
                </li>
                <li>
                    <a class="list-row" href="#">
                        <span class="list-main"><span class="list-title">Payment terms</span></span>
                        <span class="list-status"><span class="badge">Not started</span></span>
                    </a>
                </li>
                <li>
                    <span class="list-row">
                        <span class="list-main"><span class="list-title">Check and send your application</span></span>
                        <span class="list-status list-status--muted">Cannot start yet</span>
                    </span>
                </li>
            </ul>
        </div>
    </div>
</div>
