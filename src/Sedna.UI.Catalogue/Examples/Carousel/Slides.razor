<section class="carousel" aria-roledescription="carousel" aria-label="What is new in this release" data-carousel style="max-width:520px">
    <div class="carousel-track" tabindex="0" aria-label="Slides">
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="1 of 4">
            <div class="card card--fill">
                <div class="card-body">
                    <p class="eyebrow">Orders</p>
                    <h3>Split a shipment</h3>
                    <p>Send the lines that are in stock today and hold the rest, from the order's own page.</p>
                </div>
            </div>
        </div>
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="2 of 4">
            <div class="card card--fill">
                <div class="card-body">
                    <p class="eyebrow">Returns</p>
                    <h3>Labels by e-mail</h3>
                    <p>A return label goes to the customer as soon as the return is approved.</p>
                </div>
            </div>
        </div>
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="3 of 4">
            <div class="card card--fill">
                <div class="card-body">
                    <p class="eyebrow">Reports</p>
                    <h3>Weekly digest</h3>
                    <p>Late orders, held stock and open returns, every Monday at 08:00.</p>
                </div>
            </div>
        </div>
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label="4 of 4">
            <div class="card card--fill">
                <div class="card-body">
                    <p class="eyebrow">Settings</p>
                    <h3>Quiet hours</h3>
                    <p>No notifications between the hours you choose, on every device you sign in on.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="carousel-controls">
        <button class="btn btn--icon btn--sm" type="button" data-carousel-prev aria-label="Previous slide"><i class="ri-arrow-left-s-line"></i></button>
        <div class="deck-dots">
            <button class="deck-dot" type="button" data-carousel-to="1" aria-label="Slide 1" aria-current="true"></button>
            <button class="deck-dot" type="button" data-carousel-to="2" aria-label="Slide 2"></button>
            <button class="deck-dot" type="button" data-carousel-to="3" aria-label="Slide 3"></button>
            <button class="deck-dot" type="button" data-carousel-to="4" aria-label="Slide 4"></button>
        </div>
        <button class="btn btn--icon btn--sm" type="button" data-carousel-next aria-label="Next slide"><i class="ri-arrow-right-s-line"></i></button>
    </div>
    <p class="visually-hidden" aria-live="polite" data-carousel-live data-carousel-say="Slide {position} of {count}"></p>
</section>
