<form class="chat-composer chat-composer--prompt" style="max-width: 640px">
    <div class="chat-composer-row">
        <textarea class="form-input" rows="1" placeholder="Ask Ops agent" aria-label="Message"></textarea>
    </div>
    <div class="chat-composer-tools">
        <button class="btn btn-sm btn-ghost btn-icon" type="button" aria-label="Attach a file"><i class="ri-attachment-2"></i></button>
        <button class="chip" type="button" aria-pressed="true"><i class="ri-global-line"></i><span class="chip-label">Search</span></button>
        <button class="chip" type="button" aria-pressed="false"><i class="ri-lightbulb-line"></i><span class="chip-label">Think longer</span></button>
        <span class="chat-composer-send">
            <button class="btn btn-sm btn-ghost" type="button">Balanced<i class="ri-arrow-down-s-line"></i></button>
            <button class="btn btn-ghost btn-icon btn-mic" type="button" aria-label="Talk"><i class="ri-mic-line"></i></button>
            <button class="btn btn-primary btn-icon" type="submit" aria-label="Send"><i class="ri-arrow-up-line"></i></button>
        </span>
    </div>
</form>
