<div class="sedna-col sedna-gap-8" style="max-width: 640px">
    <form class="chat-composer chat-composer--prompt">
        <div class="chat-composer-files">
            <span class="chip"><i class="ri-file-text-line"></i> <span>sync-02-14.log</span> <button class="chip-dismiss" type="button" aria-label="Remove sync-02-14.log"><i class="ri-close-line"></i></button></span>
            <span class="chip"><i class="ri-image-line"></i> <span>queue-depth.png</span> <button class="chip-dismiss" type="button" aria-label="Remove queue-depth.png"><i class="ri-close-line"></i></button></span>
        </div>
        <div class="chat-composer-row">
            <textarea class="form-input" rows="1" placeholder="Ask Ops agent" aria-label="Message" aria-describedby="pt-limits"></textarea>
        </div>
        <div class="chat-composer-tools">
            <div class="menu-anchor">
                <button class="btn btn--sm btn--ghost btn--icon" type="button" data-menu-toggle aria-expanded="false" aria-label="Add"><i class="ri-add-line"></i></button>
                <div class="menu menu--start" hidden>
                    <button class="menu-item" type="button"><i class="ri-attachment-2"></i> <span>Attach a file</span></button>
                    <button class="menu-item" type="button"><i class="ri-screenshot-2-line"></i> <span>Take a screenshot</span></button>
                    <button class="menu-item" type="button"><i class="ri-links-line"></i> <span>Add a link</span></button>
                </div>
            </div>
            <button class="btn btn--sm btn--ghost" type="button" popovertarget="pt-models"><i class="ri-cloud-line"></i><span>Balanced</span><i class="ri-arrow-down-s-line"></i></button>
            <span class="chat-composer-send" data-state="idle">
                <button class="btn btn--sm btn--ghost btn--icon" type="button" aria-label="Take a screenshot"><i class="ri-screenshot-2-line"></i></button>
                <button class="btn btn--sm btn--ghost btn--icon btn-mic" type="button" aria-label="Talk"><i class="ri-mic-line"></i></button>
                <button class="btn btn--sm btn--brand btn--solid btn--icon" type="submit">
                    <span data-when="idle"><i class="ri-arrow-up-line" aria-hidden="true"></i><span class="visually-hidden">Send</span></span>
                    <span data-when="submitted streaming"><i class="ri-stop-fill" aria-hidden="true"></i><span class="visually-hidden">Stop</span></span>
                    <span data-when="error"><i class="ri-restart-line" aria-hidden="true"></i><span class="visually-hidden">Retry</span></span>
                </button>
            </span>
        </div>
    </form>
    <p class="form-hint" id="pt-limits">Up to 5 files, 10 MB each &middot; PDF, PNG, CSV or a log</p>
    <div class="popover popover--flush" id="pt-models" popover>
        <div class="form-combo form-combo--inline" data-combo="single" data-combo-managed>
            <div class="form-combo-box">
                <span class="form-combo-icon"><i class="ri-search-line"></i></span>
                <input class="form-combo-input" type="text" role="combobox" placeholder="Search models" aria-label="Model"
                       aria-expanded="false" aria-controls="pt-models-list" aria-autocomplete="list" autocomplete="off" />
            </div>
            <div class="form-combo-panel">
                <div class="form-combo-list" id="pt-models-list" role="listbox" aria-label="Models">
                    <div class="form-combo-option" role="option" id="pt-large" data-value="large" aria-selected="false">
                        <i class="ri-cloud-line" aria-hidden="true"></i>
                        <span class="form-combo-option-text">Large<span class="form-combo-option-note">Deepest reasoning, slowest to answer</span></span>
                    </div>
                    <div class="form-combo-option" role="option" id="pt-balanced" data-value="balanced" aria-selected="true">
                        <i class="ri-cloud-line" aria-hidden="true"></i>
                        <span class="form-combo-option-text">Balanced<span class="form-combo-option-note">Good for most questions</span></span>
                    </div>
                    <div class="form-combo-option" role="option" id="pt-fast" data-value="fast" aria-selected="false">
                        <i class="ri-cloud-line" aria-hidden="true"></i>
                        <span class="form-combo-option-text">Fast<span class="form-combo-option-note">Short answers, lowest cost</span></span>
                    </div>
                </div>
                <div class="form-combo-empty"><i class="ri-search-line"></i><span>No model matches.</span></div>
            </div>
        </div>
    </div>
</div>
