<div class="sedna-row-wrap sedna-gap-32">
    <div class="sedna-col sedna-center sedna-gap-8">
        <span class="chat-composer-send" data-state="idle">
            <button class="btn btn--brand btn--solid btn--icon" type="button">
                <span data-when="idle"><i class="ri-arrow-up-line" aria-hidden="true"></i><span class="visually-hidden">Send</span></span>
                <span data-when="submitted streaming"><i class="ri-stop-fill" aria-hidden="true"></i><span class="visually-hidden">Stop</span></span>
                <span data-when="error"><i class="ri-restart-line" aria-hidden="true"></i><span class="visually-hidden">Retry</span></span>
            </button>
        </span>
        <code>idle</code>
    </div>
    <div class="sedna-col sedna-center sedna-gap-8">
        <span class="chat-composer-send" data-state="submitted">
            <button class="btn btn--brand btn--solid btn--icon" type="button">
                <span data-when="idle"><i class="ri-arrow-up-line" aria-hidden="true"></i><span class="visually-hidden">Send</span></span>
                <span data-when="submitted streaming"><i class="ri-stop-fill" aria-hidden="true"></i><span class="visually-hidden">Stop</span></span>
                <span data-when="error"><i class="ri-restart-line" aria-hidden="true"></i><span class="visually-hidden">Retry</span></span>
            </button>
        </span>
        <code>submitted</code>
    </div>
    <div class="sedna-col sedna-center sedna-gap-8">
        <span class="chat-composer-send" data-state="streaming">
            <button class="btn btn--brand btn--solid btn--icon" type="button">
                <span data-when="idle"><i class="ri-arrow-up-line" aria-hidden="true"></i><span class="visually-hidden">Send</span></span>
                <span data-when="submitted streaming"><i class="ri-stop-fill" aria-hidden="true"></i><span class="visually-hidden">Stop</span></span>
                <span data-when="error"><i class="ri-restart-line" aria-hidden="true"></i><span class="visually-hidden">Retry</span></span>
            </button>
        </span>
        <code>streaming</code>
    </div>
    <div class="sedna-col sedna-center sedna-gap-8">
        <span class="chat-composer-send" data-state="error">
            <button class="btn btn--brand btn--solid btn--icon" type="button">
                <span data-when="idle"><i class="ri-arrow-up-line" aria-hidden="true"></i><span class="visually-hidden">Send</span></span>
                <span data-when="submitted streaming"><i class="ri-stop-fill" aria-hidden="true"></i><span class="visually-hidden">Stop</span></span>
                <span data-when="error"><i class="ri-restart-line" aria-hidden="true"></i><span class="visually-hidden">Retry</span></span>
            </button>
        </span>
        <code>error</code>
    </div>
</div>
