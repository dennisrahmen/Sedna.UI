<form class="chat-composer chat-composer--prompt beam" style="max-width: 640px">
    <div class="chat-composer-row">
        <textarea class="form-input" rows="1" placeholder="Ask Ops agent" aria-label="Message"></textarea>
    </div>
    <div class="chat-composer-tools">
        <span class="agent-status"><span class="orb" data-orb="writing" role="img" aria-label="Writing"></span><span class="agent-status-label text-shimmer">Writing the answer</span></span>
        <span class="chat-composer-send">
            <button class="btn btn-icon" type="button" aria-label="Stop"><i class="ri-stop-fill"></i></button>
        </span>
    </div>
</form>
