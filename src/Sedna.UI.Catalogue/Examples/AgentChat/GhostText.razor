<form class="chat-composer chat-composer--prompt" style="max-width: 640px">
    <div class="chat-composer-row">
        <div class="ghost-field">
            <textarea class="form-input" rows="1" placeholder="Ask Ops agent" aria-label="Message" aria-describedby="ghost-hint"
                      data-suggestion="Why did the nightly sync stop at 02:14 on src-db-14?"></textarea>
            <div class="ghost-text" aria-hidden="true"></div>
        </div>
    </div>
    <div class="chat-composer-tools">
        <span class="form-hint" id="ghost-hint">Tab accepts the suggestion, Escape dismisses it</span>
        <span class="chat-composer-send">
            <button class="btn btn--brand btn--solid btn--icon" type="submit" aria-label="Send"><i class="ri-arrow-up-line"></i></button>
        </span>
    </div>
</form>
