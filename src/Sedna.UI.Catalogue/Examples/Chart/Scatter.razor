<div class="card" data-chart-frame>
    <div class="card-head">
        <h3>Response time against request size</h3>
    </div>
    <div class="card-body">
        <div class="chart-legend">
            <span class="chart-key"><span class="chart-swatch chart-swatch--diamond series-3"></span><span>Search</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--triangle series-4"></span><span>Checkout</span></span>
        </div>
        <div class="chart" data-chart="scatter" data-chart-min="auto" id="chart-latency"
             aria-label="Response time in milliseconds against request size in kilobytes, for search and checkout"
             aria-roledescription="chart">
            <table class="chart-data" data-chart-data>
                <caption>Response time against request size</caption>
                <thead>
                    <tr>
                        <th scope="col">Request size (KB)</th>
                        <th scope="col" data-tone="3" data-shape="diamond">Search</th>
                        <th scope="col" data-tone="4" data-shape="triangle">Checkout</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">4</th><td>92</td><td></td></tr>
                    <tr><th scope="row">9</th><td>118</td><td></td></tr>
                    <tr><th scope="row">14</th><td>131</td><td>212</td></tr>
                    <tr><th scope="row">22</th><td>154</td><td>238</td></tr>
                    <tr><th scope="row">31</th><td>149</td><td>276</td></tr>
                    <tr><th scope="row">38</th><td>187</td><td>301</td></tr>
                    <tr><th scope="row">46</th><td></td><td>322</td></tr>
                    <tr><th scope="row">55</th><td>214</td><td>356</td></tr>
                    <tr><th scope="row">63</th><td></td><td>389</td></tr>
                </tbody>
            </table>
            <div class="chart-plot"></div>
            <div class="chart-wait skeleton skeleton-block"></div>
        </div>
        <p class="visually-hidden" data-chart-live aria-live="polite"
           data-chart-announce="{series}, {category} kilobytes: {value} milliseconds."></p>
    </div>
</div>
