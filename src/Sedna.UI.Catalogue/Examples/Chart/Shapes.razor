<div class="card" data-chart-frame>
    <div class="card-head">
        <h3>Error rate by region</h3>
    </div>
    <div class="card-body">
        <div class="chart-legend">
            <span class="chart-key"><span class="chart-swatch series-1"></span><span>North</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--square series-2"></span><span>East</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--diamond series-3"></span><span>South</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--triangle series-4"></span><span>West</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--triangle-down series-5"></span><span>Central</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--cross series-6"></span><span>Overseas</span></span>
        </div>
        <div class="chart" data-chart="line" id="chart-regions" data-chart-format='{"style":"percent","maximumFractionDigits":2}'
             aria-label="Error rate per day by region, last 6 days" aria-roledescription="chart">
            <table class="chart-data" data-chart-data>
                <caption>Error rate per day by region</caption>
                <thead>
                    <tr>
                        <th scope="col">Day</th><th scope="col">North</th><th scope="col">East</th><th scope="col">South</th>
                        <th scope="col">West</th><th scope="col">Central</th><th scope="col">Overseas</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Mon</th><td data-value="0.012">1.2%</td><td data-value="0.018">1.8%</td><td data-value="0.009">0.9%</td><td data-value="0.021">2.1%</td><td data-value="0.015">1.5%</td><td data-value="0.031">3.1%</td></tr>
                    <tr><th scope="row">Tue</th><td data-value="0.011">1.1%</td><td data-value="0.02">2.0%</td><td data-value="0.01">1.0%</td><td data-value="0.019">1.9%</td><td data-value="0.014">1.4%</td><td data-value="0.028">2.8%</td></tr>
                    <tr><th scope="row">Wed</th><td data-value="0.014">1.4%</td><td data-value="0.017">1.7%</td><td data-value="0.012">1.2%</td><td data-value="0.024">2.4%</td><td data-value="0.016">1.6%</td><td data-value="0.035">3.5%</td></tr>
                    <tr><th scope="row">Thu</th><td data-value="0.013">1.3%</td><td data-value="0.016">1.6%</td><td data-value="0.011">1.1%</td><td data-value="0.022">2.2%</td><td data-value="0.019">1.9%</td><td data-value="0.03">3.0%</td></tr>
                    <tr><th scope="row">Fri</th><td data-value="0.01">1.0%</td><td data-value="0.015">1.5%</td><td data-value="0.009">0.9%</td><td data-value="0.02">2.0%</td><td data-value="0.017">1.7%</td><td data-value="0.026">2.6%</td></tr>
                    <tr><th scope="row">Sat</th><td data-value="0.009">0.9%</td><td data-value="0.013">1.3%</td><td data-value="0.008">0.8%</td><td data-value="0.018">1.8%</td><td data-value="0.012">1.2%</td><td data-value="0.024">2.4%</td></tr>
                </tbody>
            </table>
            <div class="chart-plot"></div>
            <div class="chart-wait skeleton skeleton-block"></div>
        </div>
    </div>
</div>
