<div class="sedna-grid sedna-grid--sm">
    <div class="card">
        <div class="card-head"><h3>Small</h3></div>
        <div class="card-body">
            <div class="chart chart--sm" data-chart="column" id="chart-size-sm" aria-label="Builds per day, small">
                <table class="chart-data" data-chart-data>
                    <thead><tr><th scope="col">Day</th><th scope="col">Builds</th></tr></thead>
                    <tbody>
                        <tr><th scope="row">Mon</th><td>42</td></tr>
                        <tr><th scope="row">Tue</th><td>57</td></tr>
                        <tr><th scope="row">Wed</th><td>49</td></tr>
                        <tr><th scope="row">Thu</th><td>63</td></tr>
                        <tr><th scope="row">Fri</th><td>38</td></tr>
                    </tbody>
                </table>
                <div class="chart-plot"></div>
                <div class="chart-wait skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><h3>Large</h3></div>
        <div class="card-body">
            <div class="chart chart--lg" data-chart="column" id="chart-size-lg" aria-label="Builds per day, large">
                <table class="chart-data" data-chart-data>
                    <thead><tr><th scope="col">Day</th><th scope="col">Builds</th></tr></thead>
                    <tbody>
                        <tr><th scope="row">Mon</th><td>42</td></tr>
                        <tr><th scope="row">Tue</th><td>57</td></tr>
                        <tr><th scope="row">Wed</th><td>49</td></tr>
                        <tr><th scope="row">Thu</th><td>63</td></tr>
                        <tr><th scope="row">Fri</th><td>38</td></tr>
                    </tbody>
                </table>
                <div class="chart-plot"></div>
                <div class="chart-wait skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
    <div class="card card--fill" style="height: 20rem">
        <div class="card-head"><h3>Filling the card</h3></div>
        <div class="card-body">
            <div class="chart chart--fill" data-chart="column" id="chart-size-fill" aria-label="Builds per day, filling the card">
                <table class="chart-data" data-chart-data>
                    <thead><tr><th scope="col">Day</th><th scope="col">Builds</th></tr></thead>
                    <tbody>
                        <tr><th scope="row">Mon</th><td>42</td></tr>
                        <tr><th scope="row">Tue</th><td>57</td></tr>
                        <tr><th scope="row">Wed</th><td>49</td></tr>
                        <tr><th scope="row">Thu</th><td>63</td></tr>
                        <tr><th scope="row">Fri</th><td>38</td></tr>
                    </tbody>
                </table>
                <div class="chart-plot"></div>
                <div class="chart-wait skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
</div>
