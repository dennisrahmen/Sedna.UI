<div class="card" data-chart-frame>
    <div class="card-head">
        <h3>Sign-ups by plan</h3>
    </div>
    <div class="card-body">
        <div class="chart-legend">
            <span class="chart-key"><span class="chart-swatch chart-swatch--line series-1"></span><span>Starter</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--line series-2"></span><span>Team</span></span>
            <span class="chart-key"><span class="chart-swatch chart-swatch--line series-3"></span><span>Business</span></span>
        </div>
        <div class="chart" data-chart="line" id="chart-signups"
             aria-label="Sign-ups per week by plan, last eight weeks" aria-roledescription="chart">
            <table class="chart-data" data-chart-data>
                <caption>Sign-ups per week by plan</caption>
                <thead>
                    <tr>
                        <th scope="col">Week</th>
                        <th scope="col">Starter</th>
                        <th scope="col">Team</th>
                        <th scope="col" data-shape="diamond">Business</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Week 38</th><td>312</td><td>96</td><td>21</td></tr>
                    <tr><th scope="row">Week 39</th><td>298</td><td>104</td><td>24</td></tr>
                    <tr><th scope="row">Week 40</th><td>341</td><td>110</td><td>22</td></tr>
                    <tr><th scope="row">Week 41</th><td>356</td><td>121</td><td>29</td></tr>
                    <tr><th scope="row">Week 42</th><td>330</td><td>118</td><td>31</td></tr>
                    <tr><th scope="row">Week 43</th><td>372</td><td>134</td><td>35</td></tr>
                    <tr><th scope="row">Week 44</th><td>401</td><td>139</td><td>33</td></tr>
                    <tr><th scope="row">Week 45</th><td>418</td><td>152</td><td>40</td></tr>
                </tbody>
            </table>
            <div class="chart-plot"></div>
            <div class="chart-tip" data-chart-tip hidden>
                <span class="chart-tip-title" data-chart-field="category"></span>
                <span class="chart-tip-row" data-chart-current>
                    <span class="chart-tip-swatch"></span>
                    <span data-chart-field="series"></span>
                    <span class="chart-tip-value" data-chart-field="value"></span>
                </span>
            </div>
            <div class="chart-wait skeleton skeleton-block"></div>
        </div>
    </div>
    <div class="card-foot">
        <p class="form-hint" data-chart-live aria-live="polite"
           data-chart-announce="{category}, {series}: {value} sign-ups, week {index} of {count}."
           data-chart-announce-select="{series}, {category} chosen.">Tab to the chart, then move with the arrow keys.</p>
    </div>
</div>
