<div class="card" style="max-width:560px">
    <div class="card-body">
        <form class="chat-composer">
            <div class="chat-composer-row">
                <button class="btn btn--ghost btn--icon" type="button" aria-label="Attach a file"><i class="ri-attachment-2"></i></button>
                <div class="mention-field">
                    <textarea class="form-input" rows="1" data-mention="chat-people" placeholder="Message the dock team, &#64; to name someone" aria-label="Message"></textarea>
                    <div class="menu" id="chat-people" hidden aria-label="People in this conversation">
                        <button class="menu-item" type="button" tabindex="-1" data-mention-value="alex.fischer" data-label="Alex Fischer">
                            <span class="avatar avatar--sm">AF</span><span>Alex Fischer</span>
                        </button>
                        <button class="menu-item" type="button" tabindex="-1" data-mention-value="priya.nair" data-label="Priya Nair">
                            <span class="avatar avatar--sm avatar--viz-2">PN</span><span>Priya Nair</span>
                        </button>
                        <button class="menu-item" type="button" tabindex="-1" data-mention-value="tomas.ferreira" data-label="Tomás Ferreira">
                            <span class="avatar avatar--sm avatar--viz-4">TF</span><span>Tomás Ferreira</span>
                        </button>
                    </div>
                </div>
                <button class="btn btn--brand btn--solid btn--icon" type="submit" aria-label="Send"><i class="ri-send-plane-2-line"></i></button>
            </div>
        </form>
    </div>
</div>
