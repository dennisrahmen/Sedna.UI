<div class="card" style="max-width:560px" aria-busy="true">
    <div class="card-body">
        <div class="chat" aria-label="Loading the conversation">
            <div class="chat-message">
                <span class="skeleton skeleton-circle" style="--skeleton-size: 22px"></span>
                <div class="chat-body">
                    <span class="skeleton skeleton-text sedna-mt-0 sedna-mb-0 sedna-w sedna-w--sm"></span>
                    <span class="skeleton skeleton-block sedna-w sedna-w--lg" style="--skeleton-height: 44px"></span>
                </div>
            </div>
            <div class="chat-message chat-message--mine">
                <div class="chat-body">
                    <span class="skeleton skeleton-block sedna-w sedna-w--md" style="--skeleton-height: 44px"></span>
                </div>
            </div>
            <div class="chat-message">
                <span class="skeleton skeleton-circle" style="--skeleton-size: 22px"></span>
                <div class="chat-body">
                    <span class="skeleton skeleton-text sedna-mt-0 sedna-mb-0 sedna-w sedna-w--sm"></span>
                    <span class="skeleton skeleton-block skeleton-block--sm sedna-w sedna-w--md"></span>
                </div>
            </div>
            <span class="visually-hidden">Loading the conversation</span>
        </div>
    </div>
</div>
