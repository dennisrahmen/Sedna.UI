<section class="card" style="max-width:460px; margin-block-start:40px">
    <div class="card-body sedna-place-center" style="min-height:120px">
        <span class="text-muted">Return RMA-0318 &middot; 2 items received</span>
    </div>
    <div class="card-foot card-foot--start" style="--panel-placement: block-start">
        <div class="form-combo" data-combo="single" data-combo-managed style="flex:1">
            <div class="form-combo-box">
                <input class="form-combo-input" id="cb-restock" type="text" role="combobox" placeholder="Restock into…"
                       aria-label="Restock into" aria-expanded="false" aria-controls="cb-restock-list" aria-autocomplete="list" autocomplete="off" />
                <span class="form-combo-actions">
                    <button class="form-combo-btn form-combo-toggle" type="button" tabindex="-1" aria-label="Show bins"><i class="ri-arrow-down-s-line"></i></button>
                </span>
            </div>
            <div class="form-combo-panel">
                <div class="form-combo-list" id="cb-restock-list" role="listbox" aria-label="Bins">
                    <div class="form-combo-option" role="option" id="cb-restock-a1" data-value="a1" aria-selected="false">Aisle A, bin 1</div>
                    <div class="form-combo-option" role="option" id="cb-restock-a4" data-value="a4" aria-selected="false">Aisle A, bin 4</div>
                    <div class="form-combo-option" role="option" id="cb-restock-c2" data-value="c2" aria-selected="false">Aisle C, bin 2</div>
                    <div class="form-combo-option" role="option" id="cb-restock-q" data-value="q" aria-selected="false">Quarantine shelf</div>
                </div>
                <div class="form-combo-empty">No bin matches</div>
            </div>
        </div>
        <button class="btn btn--sm" type="button">Restock</button>
    </div>
</section>
