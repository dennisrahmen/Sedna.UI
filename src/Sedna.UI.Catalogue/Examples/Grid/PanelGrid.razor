<div class="panel-grid" aria-label="Warehouse dashboard">
    <section class="card card--resizable" style="--panel-x: 0; --panel-y: 0; --panel-w: 4; --panel-h: 3">
        <div class="card-head"><h3>Open orders</h3></div>
        <div class="card-body">
            <div class="stat">
                <span class="stat-label">Open now</span>
                <span class="stat-value">1 204</span>
                <span class="stat-note">37 awaiting stock</span>
            </div>
        </div>
    </section>
    <section class="card card--resizable" style="--panel-x: 4; --panel-y: 0; --panel-w: 4; --panel-h: 3">
        <div class="card-head"><h3>Dispatch</h3></div>
        <div class="card-body">
            <div class="stat">
                <span class="stat-label">Median time</span>
                <span class="stat-value">4.2<span class="stat-unit">h</span></span>
                <span class="stat-note">20 min faster than last week</span>
            </div>
        </div>
    </section>
    <section class="card card--resizable" style="--panel-x: 8; --panel-y: 0; --panel-w: 4; --panel-h: 6">
        <div class="card-head"><h3>Late orders</h3></div>
        <div class="card-body card-body--flush">
            <ul class="list">
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4182</span><span class="list-sub">Northwind Retail · 2 days late</span></span></a></li>
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4190</span><span class="list-sub">Alex Fischer · 1 day late</span></span></a></li>
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4197</span><span class="list-sub">Northwind Retail · due today</span></span></a></li>
            </ul>
        </div>
    </section>
    <section class="card card--resizable" style="--panel-x: 0; --panel-y: 3; --panel-w: 8; --panel-h: 3">
        <div class="card-head"><h3>Returns this week</h3></div>
        <div class="card-body">
            <div class="stat">
                <span class="stat-label">Received</span>
                <span class="stat-value">12</span>
                <span class="stat-note">3 awaiting inspection at dock 4</span>
            </div>
        </div>
    </section>
</div>
