                <div class="kv"><span class="k">Oldest</span><span class="v">2 h 14 m</span></div>
            </div>
        </div>
        <div class="card">
            <div class="card-head">
                <strong>EU-Central</strong>
                <span class="health-badge health-badge--degraded"><span class="health-dot"></span> Degraded</span>
            </div>
