<div class="form-field">
    <span class="form-label" id="brand-colour-label">Brand colour</span>
    <div class="form-color-picker" data-color-picker role="group" aria-labelledby="brand-colour-label">
        <div class="form-color-area" data-color-area role="slider" tabindex="0"
             aria-label="Saturation and brightness" aria-valuemin="0" aria-valuemax="100" aria-valuenow="74"
             data-color-valuetext="Saturation {s}%, brightness {v}%"></div>
        <input class="form-range form-range--hue" data-color-hue type="range" min="0" max="360" value="201" aria-label="Hue" />
        <input class="form-range form-range--alpha" data-color-alpha type="range" min="0" max="100" value="100" aria-label="Opacity" />
        <div class="sedna-row sedna-gap-2">
            <span class="form-color-preview" aria-hidden="true"></span>
            <input class="form-input" data-color-value name="brand" type="text" value="#3aa8e2" aria-label="Brand colour as hex" spellcheck="false" autocomplete="off" />
        </div>
    </div>
</div>
