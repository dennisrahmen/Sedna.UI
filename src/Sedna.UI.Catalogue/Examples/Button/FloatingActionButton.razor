<div class="sedna-col sedna-gap-12">
    <div class="sedna-row-wrap">
        <button class="fab" type="button" style="position:static">
            <i class="ri-add-line"></i> <span>New order</span>
        </button>
        <button class="fab fab--icon" type="button" style="position:static" aria-label="New order">
            <i class="ri-add-line"></i>
        </button>
    </div>
    <div class="sedna-row-wrap">
        <button class="fab fab--brand" type="button" style="position:static"><i class="ri-add-line"></i> <span>Brand</span></button>
        <button class="fab fab--go" type="button" style="position:static"><i class="ri-send-plane-line"></i> <span>Send</span></button>
        <button class="fab fab--warn" type="button" style="position:static"><i class="ri-user-shared-line"></i> <span>Take over</span></button>
        <button class="fab fab--danger" type="button" style="position:static"><i class="ri-alarm-warning-line"></i> <span>Raise alarm</span></button>
        <button class="fab fab--info" type="button" style="position:static"><i class="ri-question-line"></i> <span>Help</span></button>
        <button class="fab fab--secret" type="button" style="position:static"><i class="ri-lock-line"></i> <span>Vault</span></button>
    </div>
    <div class="sedna-row-wrap">
        <button class="fab fab--sm" type="button" style="position:static"><i class="ri-add-line"></i> <span>Small</span></button>
        <button class="fab fab--sm fab--icon" type="button" style="position:static" aria-label="Small"><i class="ri-add-line"></i></button>
        <button class="fab fab--lg" type="button" style="position:static"><i class="ri-add-line"></i> <span>Large</span></button>
        <button class="fab fab--lg fab--icon" type="button" style="position:static" aria-label="Large"><i class="ri-add-line"></i></button>
    </div>
    <div class="sedna-row-wrap">
        <button class="fab" type="button" style="position:static" aria-busy="true"><i class="ri-add-line"></i> <span>Creating</span></button>
        <button class="fab" type="button" style="position:static" disabled><i class="ri-add-line"></i> <span>New order</span></button>
    </div>
</div>
