<div class="sedna-col sedna-gap-2">
    <div class="sedna-row-wrap">
        <button class="btn btn--danger" type="button"><i class="ri-delete-bin-line"></i> <span>Delete</span></button>
        <button class="btn sedna-push" type="button">Cancel</button>
        <button class="btn btn--brand btn--solid" type="button">Save</button>
    </div>
    <div class="sedna-row-wrap sedna-justify-end">
        <button class="btn btn--warn" type="button">Take over</button>
        <button class="btn btn--go btn--solid" type="button"><i class="ri-check-line"></i> <span>Approve &amp; send</span></button>
    </div>
    <div class="sedna-row-wrap sedna-justify-end">
        <button class="btn" type="button" disabled>Hand back</button>
        <button class="btn btn--warn btn--solid" type="button"><i class="ri-user-shared-line"></i> <span>Accept &amp; take over</span></button>
    </div>
</div>
