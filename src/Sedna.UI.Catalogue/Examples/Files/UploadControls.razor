<div class="sedna-col sedna-gap-3" style="max-width:560px">
    <div class="file-batch" role="group" aria-label="Uploads">
        <i class="ri-upload-cloud-2-line file-batch-status" aria-hidden="true"></i>
        <span class="file-batch-main">
            <span class="file-batch-title">Uploading 3 of 5</span>
            <span class="file-meta"><span>45%</span><span>2.1 MB/s</span><span>12 s left</span></span>
        </span>
        <span class="file-batch-actions">
            <button class="btn btn--ghost btn--sm" type="button"><i class="ri-pause-line"></i> <span>Pause all</span></button>
            <button class="btn btn--ghost btn--sm" type="button"><i class="ri-close-line"></i> <span>Cancel all</span></button>
        </span>
        <span class="progress" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100" aria-label="All uploads"><span class="progress-bar" style="width:45%"></span></span>
    </div>

    <ul class="file-list" aria-label="Uploads">
        <li class="file-item">
            <span class="file-icon file-icon--sm file-icon--sheet"><i class="ri-file-excel-2-line"></i></span>
            <span class="file-item-main">
                <span class="file-item-name">stock-check-2026-09-14.xlsx</span>
                <span class="progress" role="progressbar" aria-valuenow="64" aria-valuemin="0" aria-valuemax="100" aria-label="Uploading stock-check-2026-09-14.xlsx"><span class="progress-bar" style="width:64%"></span></span>
                <span class="file-meta"><span>2.6 of 4.1 MB</span><span>1.4 MB/s</span><span>2 s left</span></span>
            </span>
            <span class="file-item-size">64%</span>
            <span class="file-item-actions">
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Pause stock-check-2026-09-14.xlsx"><i class="ri-pause-line"></i></button>
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Cancel stock-check-2026-09-14.xlsx"><i class="ri-close-line"></i></button>
            </span>
        </li>
        <li class="file-item file-item--paused">
            <span class="file-icon file-icon--sm file-icon--media"><i class="ri-file-video-line"></i></span>
            <span class="file-item-main">
                <span class="file-item-name">dock-4-walkthrough.mp4</span>
                <span class="progress" role="progressbar" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100" aria-label="dock-4-walkthrough.mp4, paused"><span class="progress-bar" style="width:30%"></span></span>
                <span class="file-meta"><span>18 of 60 MB</span><span>Paused</span></span>
            </span>
            <i class="ri-pause-circle-line file-item-status" role="img" aria-label="Paused"></i>
            <span class="file-item-actions">
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Resume dock-4-walkthrough.mp4"><i class="ri-play-line"></i></button>
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Cancel dock-4-walkthrough.mp4"><i class="ri-close-line"></i></button>
            </span>
        </li>
        <li class="file-item file-item--error">
            <span class="file-icon file-icon--sm file-icon--doc"><i class="ri-file-word-2-line"></i></span>
            <span class="file-item-main">
                <span class="file-item-name">dock-handover-checklist.docx</span>
                <span class="progress" role="progressbar" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100" aria-label="dock-handover-checklist.docx, failed"><span class="progress-bar progress-bar--danger" style="width:40%"></span></span>
                <span class="file-meta"><span>The connection dropped at 40%</span></span>
            </span>
            <i class="ri-error-warning-fill file-item-status" role="img" aria-label="Failed"></i>
            <span class="file-item-actions">
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Retry dock-handover-checklist.docx"><i class="ri-refresh-line"></i></button>
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Remove dock-handover-checklist.docx"><i class="ri-close-line"></i></button>
            </span>
        </li>
        <li class="file-item file-item--done">
            <span class="file-icon file-icon--sm file-icon--pdf"><i class="ri-file-pdf-2-line"></i></span>
            <span class="file-item-main">
                <span class="file-item-name">delivery-note-week-38-signed.pdf</span>
                <span class="file-meta"><span>84 KB</span><span>Uploaded</span></span>
            </span>
            <i class="ri-checkbox-circle-fill file-item-status" role="img" aria-label="Uploaded"></i>
        </li>
    </ul>

    <div class="file-batch file-batch--paused" role="group" aria-label="Uploads, paused">
        <i class="ri-pause-circle-line file-batch-status" aria-hidden="true"></i>
        <span class="file-batch-main">
            <span class="file-batch-title">Paused at 3 of 5</span>
            <span class="file-meta"><span>45%</span></span>
        </span>
        <span class="file-batch-actions">
            <button class="btn btn--ghost btn--sm" type="button"><i class="ri-play-line"></i> <span>Resume all</span></button>
            <button class="btn btn--ghost btn--sm" type="button"><i class="ri-close-line"></i> <span>Cancel all</span></button>
        </span>
        <span class="progress" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100" aria-label="All uploads, paused"><span class="progress-bar" style="width:45%"></span></span>
    </div>
    <div class="file-batch file-batch--done" role="group" aria-label="Uploads, finished">
        <i class="ri-checkbox-circle-fill file-batch-status" aria-hidden="true"></i>
        <span class="file-batch-main">
            <span class="file-batch-title">5 files uploaded</span>
            <span class="file-meta"><span>68 MB</span><span>in 41 s</span></span>
        </span>
        <span class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-label="All uploads, finished"><span class="progress-bar" style="width:100%"></span></span>
    </div>
    <div class="file-batch file-batch--error" role="group" aria-label="Uploads, one failed">
        <i class="ri-error-warning-fill file-batch-status" aria-hidden="true"></i>
        <span class="file-batch-main">
            <span class="file-batch-title">4 of 5 uploaded, 1 failed</span>
        </span>
        <span class="file-batch-actions">
            <button class="btn btn--ghost btn--sm" type="button"><i class="ri-refresh-line"></i> <span>Retry the failed one</span></button>
        </span>
        <span class="progress" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100" aria-label="All uploads, one failed"><span class="progress-bar" style="width:80%"></span></span>
    </div>
</div>
