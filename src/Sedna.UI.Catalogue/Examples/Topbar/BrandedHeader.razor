<div style="--topbar-bg: var(--brand); --topbar-fg: var(--on-solid); --topbar-muted: var(--on-solid); --topbar-hover: var(--brand-hover); --topbar-height: 56px">
    <header class="topbar topbar--sticky">
        <button class="topbar-btn topbar-btn--start" type="button" aria-label="Menu"><i class="ri-menu-line"></i></button>
        <div class="topbar-spacer"></div>
        <div class="topbar-section">
            <button class="btn btn--ghost btn--icon" type="button" aria-label="Send feedback"><i class="ri-feedback-line"></i></button>
            <button class="btn btn--ghost btn--icon" type="button" aria-label="Help"><i class="ri-question-line"></i></button>
        </div>
    </header>
</div>
