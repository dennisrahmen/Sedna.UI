<div style="--topbar-bg: var(--brand); --topbar-fg: var(--on-solid); --topbar-muted: var(--on-solid); --topbar-hover: var(--brand-hover)">
    <header class="topbar">
        <div class="topbar-section">
            <span class="sedna-col">
                <span class="eyebrow">Technical overview</span>
                <span>Server running since 08:14</span>
            </span>
        </div>
        <div class="topbar-spacer"></div>
        <div class="topbar-section">
            <span class="text-muted">Last sync 2 minutes ago</span>
            <button class="btn btn--ghost btn--icon" type="button" aria-label="Refresh"><i class="ri-refresh-line"></i></button>
        </div>
    </header>
</div>
