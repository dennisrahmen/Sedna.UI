<header class="topbar">
    <div class="bare-brand">
        <div class="brand-logo" style="background:var(--brand)"></div>
        <span>Orders</span>
    </div>
    <div class="topbar-spacer"></div>
    <button class="topbar-btn" type="button" popovertarget="apps-panel" aria-label="Switch app"
            data-tip="Go to another app.">
        <i class="ri-apps-2-line" aria-hidden="true"></i>
    </button>
    <div class="popover" id="apps-panel" popover>
        <strong class="popover-title">Apps</strong>
        <nav class="app-switcher" aria-label="Apps">
            <a class="app-switcher-item" href="#" aria-current="page">
                <span class="app-switcher-icon"><i class="ri-inbox-line" aria-hidden="true"></i></span>
                <span>Orders</span>
            </a>
            <a class="app-switcher-item" href="#">
                <span class="app-switcher-icon"><i class="ri-store-2-line" aria-hidden="true"></i></span>
                <span>Inventory</span>
            </a>
            <a class="app-switcher-item" href="#">
                <span class="app-switcher-icon"><i class="ri-truck-line" aria-hidden="true"></i></span>
                <span>Shipping</span>
            </a>
            <a class="app-switcher-item" href="#">
                <span class="app-switcher-icon"><i class="ri-arrow-go-back-line" aria-hidden="true"></i></span>
                <span>Returns</span>
            </a>
            <a class="app-switcher-item" href="#">
                <span class="app-switcher-icon"><i class="ri-bar-chart-box-line" aria-hidden="true"></i></span>
                <span>Reports</span>
            </a>
            <a class="app-switcher-item" href="#">
                <span class="app-switcher-icon"><i class="ri-settings-3-line" aria-hidden="true"></i></span>
                <span>Admin</span>
            </a>
        </nav>
    </div>
    <div class="user-widget">
        <button class="user-trigger" type="button">
            <span class="user-avatar">AF</span>
            <span class="user-info">
                <span class="user-name">Alex Fischer</span>
                <span class="user-email">alex.fischer@example.com</span>
            </span>
        </button>
    </div>
</header>
