<div class="sedna-col sedna-gap-3" style="max-width:520px">
    <fieldset class="form-field">
        <legend class="form-label">Status</legend>
        <div class="form-check-list form-check-list--sm">
            <label class="form-check"><input type="checkbox" name="cl-status" value="open" checked /> <span>Open</span> <span class="form-check-count">412</span></label>
            <label class="form-check"><input type="checkbox" name="cl-status" value="held" checked /> <span>Held</span> <span class="form-check-count">38</span></label>
            <label class="form-check"><input type="checkbox" name="cl-status" value="shipped" /> <span>Shipped</span> <span class="form-check-count">1,206</span></label>
        </div>
    </fieldset>
    <fieldset class="form-field">
        <legend class="form-label">Where should the parcel be left?</legend>
        <div class="form-check-list form-check-list--lg">
            <label class="form-check"><input type="checkbox" name="cl-leave" value="neighbour" checked /> <span>With a neighbour</span></label>
            <label class="form-check"><input type="checkbox" name="cl-leave" value="porch" /> <span>In the porch</span></label>
        </div>
    </fieldset>
    <fieldset class="form-field">
        <legend class="form-label">Days</legend>
        <div class="form-check-list form-check-list--inline">
            <label class="form-check"><input type="checkbox" name="cl-days" value="mon" checked /> <span>Mon</span></label>
            <label class="form-check"><input type="checkbox" name="cl-days" value="tue" checked /> <span>Tue</span></label>
            <label class="form-check"><input type="checkbox" name="cl-days" value="wed" checked /> <span>Wed</span></label>
            <label class="form-check"><input type="checkbox" name="cl-days" value="thu" checked /> <span>Thu</span></label>
            <label class="form-check"><input type="checkbox" name="cl-days" value="fri" checked /> <span>Fri</span></label>
            <label class="form-check"><input type="checkbox" name="cl-days" value="sat" /> <span>Sat</span></label>
            <label class="form-check"><input type="checkbox" name="cl-days" value="sun" /> <span>Sun</span></label>
        </div>
    </fieldset>
</div>
