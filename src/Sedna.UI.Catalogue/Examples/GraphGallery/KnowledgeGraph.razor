<div class="graph-frame" data-graph-frame>
    <div class="toolbar">
        <div class="toolbar-filters">
            <div class="input-group toolbar-input">
                <span class="input-affix"><i class="ri-search-line"></i></span>
                <input class="form-input" type="search" placeholder="Search" aria-label="Search the knowledge graph" data-graph-search />
            </div>
            <label class="form-check"><input type="checkbox" data-graph-show="muted" checked /> Done tasks</label>
        </div>
        <span class="toolbar-count" data-graph-stats="{nodes} records · {edges} links" data-graph-stats-match="{matches} of {nodes} records match"></span>
    </div>
    <div class="chip-set" role="group" aria-label="Show kinds">
        <button class="chip" type="button" data-graph-filter="kind" value="note" aria-pressed="true"><span class="graph-swatch graph-swatch--rounded series-2"></span> Notes</button>
        <button class="chip" type="button" data-graph-filter="kind" value="task" aria-pressed="true"><span class="graph-swatch graph-swatch--diamond series-3"></span> Tasks</button>
        <button class="chip" type="button" data-graph-filter="kind" value="person" aria-pressed="true"><span class="graph-swatch series-5"></span> People</button>
        <button class="chip" type="button" data-graph-filter="kind" value="tag" aria-pressed="true"><span class="graph-swatch graph-swatch--tag series-6"></span> Tags</button>
    </div>
    <div class="sedna-split">
        <div class="graph card" data-graph id="knowledge" data-graph-layout="islands"
