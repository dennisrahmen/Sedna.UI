            <div class="graph-canvas"></div>
            <div class="graph-tools" role="toolbar" aria-label="View">
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="zoom-in" aria-label="Zoom in" data-tip="Zoom in"><i class="ri-zoom-in-line"></i></button>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="zoom-out" aria-label="Zoom out" data-tip="Zoom out"><i class="ri-zoom-out-line"></i></button>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="fit" aria-label="Fit to the frame" data-tip="Fit to the frame"><i class="ri-focus-3-line"></i></button>
                <span class="graph-tools-sep"></span>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="reset" aria-label="Reset the view and the filters" data-tip="Reset"><i class="ri-restart-line"></i></button>
            </div>
            <div class="menu graph-menu" data-graph-menu role="menu" hidden>
                <span class="menu-label" data-graph-field="label"></span>
                <button class="menu-item" role="menuitem" type="button" data-graph-action="focus"><i class="ri-focus-3-line"></i> Only its neighbourhood</button>
                <button class="menu-item" role="menuitem" type="button" data-graph-action="unfocus"><i class="ri-apps-2-line"></i> Everything again</button>
                <button class="menu-item" role="menuitem" type="button" data-graph-action="hide"><i class="ri-eye-off-line"></i> Hide it</button>
                <button class="menu-item" role="menuitem" type="button" data-graph-action="show-all"><i class="ri-eye-line"></i> Show what I hid</button>
            </div>
            <div class="graph-wait skeleton skeleton-block"></div>
            <p class="visually-hidden" data-graph-live aria-live="polite"
               data-graph-announce="{label}, {meta}. {links} links." data-graph-announce-select="{label} selected. Its links are listed beside the graph."></p>
        </div>
        <aside class="card card--fill sedna-split-aside graph-detail" data-graph-detail hidden aria-label="Selected record">
            <div class="card-head">
                <strong data-graph-field="label"></strong>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="clear" aria-label="Close the panel"><i class="ri-close-line"></i></button>
            </div>
            <div class="card-body">
                <p class="form-hint" data-graph-field="meta"></p>
                <ul class="list" data-graph-neighbours>
                    <template data-graph-neighbour>
                        <li>
                            <button class="list-row" type="button" data-graph-action="select">
                                <span class="list-main">
                                    <span class="list-title" data-graph-field="label"></span>
                                    <span class="list-sub">
                                        <span class="graph-direction" aria-hidden="true"><i class="ri-arrow-right-line graph-direction-out"></i><i class="ri-arrow-left-line graph-direction-in"></i><i class="ri-arrow-left-right-line graph-direction-both"></i></span>
                                        <span data-graph-link></span>
                                    </span>
                                </span>
                            </button>
                        </li>
                    </template>
                </ul>
            </div>
            <div class="card-foot card-foot--start">
                <button class="btn btn-sm" type="button" data-graph-action="focus"><i class="ri-focus-3-line"></i> Neighbourhood</button>
                <button class="btn btn-ghost btn-sm" type="button" data-graph-action="unfocus">Everything</button>
            </div>
        </aside>
    </div>
    <div class="graph-legend">
        <span class="graph-key"><span class="graph-swatch graph-swatch--hexagon series-1"></span> Project</span>
        <span class="graph-key"><span class="graph-swatch graph-swatch--diamond series-3 graph-swatch--muted"></span> Done task</span>
        <span class="graph-key"><span class="graph-line"></span> Filed under, written by, assigned to</span>
        <span class="graph-key"><span class="graph-line graph-line--dotted"></span> Tagged</span>
    </div>
</div>
