<div class="graph-frame" data-graph-frame>
    <div class="toolbar">
        <div class="toolbar-filters">
            <div class="input-group toolbar-input">
                <span class="input-affix"><i class="ri-search-line"></i></span>
                <input class="form-input" type="search" placeholder="Name or team" aria-label="Find a person or a team" data-graph-search />
            </div>
        </div>
        <span class="toolbar-count" data-graph-stats="{nodes} people and teams" data-graph-stats-match="{matches} of {nodes} match"></span>
    </div>
    <div class="graph card" data-graph id="org-chart" data-graph-layout="dagre" data-graph-nodes="box"
         data-graph-curve="taxi" data-graph-edge-labels="none" aria-label="Organisation chart" aria-roledescription="graph">
        <ul class="graph-data" data-graph-data>
            <li data-node="md" data-tone="1" data-icon="ri-user-star-line" data-meta="Managing director" data-location="Zürich office" data-email="alex.fischer@example.com" data-root>Alex Fischer</li>
            <li data-node="engineering" data-tone="2" data-icon="ri-code-s-slash-line" data-meta="Engineering director" data-location="Zürich office" data-email="priya.nair@example.com">Priya Nair</li>
            <li data-node="finance" data-tone="3" data-icon="ri-funds-line" data-meta="Finance director" data-location="Milano office" data-email="rin.nakamura@example.com">Rin Nakamura</li>
            <li data-node="operations" data-tone="5" data-icon="ri-truck-line" data-meta="Operations director" data-location="Bern office" data-email="jordan.weiss@example.com">Jordan Weiss</li>
            <li data-node="people" data-tone="info" data-icon="ri-team-line" data-meta="Head of people" data-location="Zürich office" data-muted>Open role</li>
            <li data-node="platform" data-tone="2" data-meta="6 engineers" data-location="Remote" data-email="platform@example.com">Platform team</li>
            <li data-node="design" data-tone="2" data-meta="3 designers" data-location="Zürich office" data-email="design@example.com">Design team</li>
            <li data-node="controlling" data-tone="3" data-meta="2 controllers" data-location="Stuttgart office" data-email="controlling@example.com">Controlling</li>
            <li data-node="logistics" data-tone="5" data-meta="14 people, 2 shifts" data-location="Bern office" data-email="logistics@example.com">Logistics</li>
            <li data-node="service" data-tone="5" data-meta="9 people" data-location="Zürich office" data-email="service@example.com">Customer service</li>
            <li data-node="reliability" data-tone="2" data-meta="3 engineers, on call" data-location="Basel office" data-email="reliability@example.com">Site reliability</li>

            <li data-edge data-source="md" data-target="engineering">Priya Nair reports to Alex Fischer.</li>
            <li data-edge data-source="md" data-target="finance">Rin Nakamura reports to Alex Fischer.</li>
            <li data-edge data-source="md" data-target="operations">Jordan Weiss reports to Alex Fischer.</li>
            <li data-edge data-source="md" data-target="people" data-line="dashed">The open head of people role will report to Alex Fischer.</li>
            <li data-edge data-source="engineering" data-target="platform">The platform team reports to Priya Nair.</li>
            <li data-edge data-source="engineering" data-target="design">The design team reports to Priya Nair.</li>
            <li data-edge data-source="finance" data-target="controlling">Controlling reports to Rin Nakamura.</li>
            <li data-edge data-source="operations" data-target="logistics">Logistics reports to Jordan Weiss.</li>
            <li data-edge data-source="operations" data-target="service">Customer service reports to Jordan Weiss.</li>
            <li data-edge data-source="platform" data-target="reliability">Site reliability is part of the platform team.</li>
            <li data-edge data-source="operations" data-target="controlling" data-line="dotted" data-tone="5">Controlling also has a dotted-line report to Jordan Weiss.</li>
        </ul>
        <div class="graph-canvas"></div>
        <div class="graph-tools" role="toolbar" aria-label="View">
            <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="zoom-in" aria-label="Zoom in" data-tip="Zoom in"><i class="ri-zoom-in-line"></i></button>
            <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="zoom-out" aria-label="Zoom out" data-tip="Zoom out"><i class="ri-zoom-out-line"></i></button>
            <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="fit" aria-label="Fit to the frame" data-tip="Fit to the frame"><i class="ri-focus-3-line"></i></button>
            <span class="graph-tools-sep"></span>
            <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="export-svg" data-graph-filename="organisation-chart" aria-label="Download as SVG" data-tip="Download as SVG"><i class="ri-file-code-line"></i></button>
            <button class="btn btn--ghost btn--sm btn--icon" type="button" data-graph-action="export-png" data-graph-filename="organisation-chart" aria-label="Download as PNG" data-tip="Download as PNG"><i class="ri-image-line"></i></button>
        </div>
        <div class="graph-tip" data-graph-tip hidden>
            <span class="graph-tip-head"><i data-graph-icon aria-hidden="true"></i><span class="graph-tip-title" data-graph-field="label"></span></span>
            <span class="graph-tip-meta" data-graph-field="meta"></span>
            <span class="graph-tip-meta" data-graph-field="location"></span>
            <span class="graph-tip-ref" data-graph-field="email"></span>
        </div>
        <div class="graph-wait skeleton skeleton-block"></div>
        <p class="visually-hidden" data-graph-live aria-live="polite"
           data-graph-announce="{label}, {meta}. {links} links." data-graph-announce-select="{label} selected."></p>
    </div>
    <div class="graph-legend">
        <span class="graph-key"><span class="graph-swatch graph-swatch--rounded series-2"></span> <span>Engineering</span></span>
        <span class="graph-key"><span class="graph-swatch graph-swatch--rounded series-3"></span> <span>Finance</span></span>
        <span class="graph-key"><span class="graph-swatch graph-swatch--rounded series-5"></span> <span>Operations</span></span>
        <span class="graph-key"><span class="graph-swatch graph-swatch--rounded series-info"></span> <span>People</span></span>
        <span class="graph-key"><span class="graph-line"></span> <span>Reports to</span></span>
        <span class="graph-key"><span class="graph-line graph-line--dotted"></span> <span>Dotted-line report</span></span>
        <span class="graph-key"><span class="graph-line graph-line--dashed"></span> <span>Open role</span></span>
    </div>
</div>
