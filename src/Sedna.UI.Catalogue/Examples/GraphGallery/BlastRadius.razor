<div class="card" data-graph-frame>
    <div class="card-head">
        <strong>Session store is down</strong>
        <span class="badge badge-danger">Since 09:12</span>
    </div>
    <div class="card-body">
        <div class="toolbar">
            <div class="toolbar-filters">
                <div class="segmented segmented--sm" role="group" aria-label="How far to follow the calls">
                    <label class="segmented-option"><input type="radio" name="blast-depth" value="1" data-graph-option="depth" /> 1 hop</label>
                    <label class="segmented-option"><input type="radio" name="blast-depth" value="2" data-graph-option="depth" checked /> 2 hops</label>
                    <label class="segmented-option"><input type="radio" name="blast-depth" value="3" data-graph-option="depth" /> 3 hops</label>
                </div>
                <span class="toolbar-count" data-graph-stats="{nodes} of {totalNodes} services in view"></span>
            </div>
            <div class="toolbar-actions">
                <button class="btn btn-sm" type="button" data-graph-action="unfocus"><i class="ri-apps-2-line"></i> Whole map</button>
                <button class="btn btn-sm" type="button" data-graph-action="focus" value="session-store"><i class="ri-focus-3-line"></i> Back to the failure</button>
            </div>
        </div>
    </div>
    <div class="graph graph--lg" data-graph id="blast-radius" data-graph-layout="dagre" data-graph-arrows="target"
         data-graph-focus="session-store" data-graph-focus-depth="2" data-graph-spacing="loose"
         aria-label="Services that depend on the session store" aria-roledescription="graph">
        <ul class="graph-data" data-graph-data>
            <li data-node="session-store" data-tone="danger" data-shape="square" data-icon="ri-database-2-line" data-meta="Down · connection refused" data-root>Session store</li>
            <li data-node="identity-api" data-tone="warn" data-icon="ri-key-2-line" data-meta="38 % of sign-ins fail">Identity API</li>
            <li data-node="basket" data-tone="warn" data-icon="ri-shopping-cart-2-line" data-meta="Guest baskets cannot be read">Basket service</li>
            <li data-node="web-shop" data-tone="warn" data-icon="ri-store-2-line" data-meta="Sign-in and basket errors">Web shop</li>
            <li data-node="mobile-api" data-tone="warn" data-icon="ri-smartphone-line" data-meta="Sign-in errors">Mobile app API</li>
            <li data-node="checkout-api" data-tone="warn" data-icon="ri-bank-card-line" data-meta="Checkout falls back to guest">Checkout API</li>
            <li data-node="partner-api" data-tone="warn" data-icon="ri-links-line" data-meta="Token refresh fails">Partner API</li>
            <li data-node="admin-console" data-tone="warn" data-icon="ri-settings-3-line" data-meta="Staff cannot sign in">Admin console</li>
            <li data-node="support-desk" data-tone="warn" data-icon="ri-customer-service-2-line" data-meta="Staff cannot sign in">Support desk</li>
            <li data-node="accounts" data-tone="go" data-shape="square" data-icon="ri-database-2-line" data-meta="Healthy">Accounts</li>
            <li data-node="catalogue-api" data-tone="go" data-icon="ri-server-line" data-meta="Healthy">Catalogue API</li>
            <li data-node="recommendations" data-tone="go" data-icon="ri-lightbulb-flash-line" data-meta="Healthy">Recommendations</li>
            <li data-node="pricing" data-tone="go" data-icon="ri-calculator-line" data-meta="Healthy">Pricing engine</li>
            <li data-node="payments-api" data-tone="go" data-icon="ri-bank-card-line" data-meta="Healthy">Payments API</li>
            <li data-node="orders-api" data-tone="go" data-icon="ri-server-line" data-meta="Healthy">Orders API</li>
            <li data-node="search-index" data-tone="go" data-shape="square" data-icon="ri-search-line" data-meta="Healthy">Search index</li>
            <li data-node="product-db" data-tone="go" data-shape="square" data-icon="ri-database-2-line" data-meta="Healthy">Product database</li>
            <li data-node="order-db" data-tone="go" data-shape="square" data-icon="ri-database-2-line" data-meta="Healthy">Order database</li>
            <li data-node="ledger" data-tone="go" data-shape="square" data-icon="ri-database-2-line" data-meta="Healthy">Ledger</li>
            <li data-node="order-worker" data-tone="go" data-icon="ri-loop-right-line" data-meta="Healthy">Order worker</li>
            <li data-node="warehouse-sync" data-tone="go" data-icon="ri-swap-line" data-meta="Healthy">Warehouse sync</li>
            <li data-node="reporting" data-tone="go" data-icon="ri-bar-chart-box-line" data-meta="Healthy">Reporting</li>
            <li data-node="newsletter" data-tone="go" data-icon="ri-mail-line" data-meta="Healthy">Newsletter</li>

            <li data-edge data-source="identity-api" data-target="session-store" data-tone="danger" data-label="stores sessions">The identity API stores sessions in the session store.</li>
            <li data-edge data-source="basket" data-target="session-store" data-tone="danger" data-label="stores guest baskets">The basket service keeps guest baskets in the session store.</li>
            <li data-edge data-source="identity-api" data-target="accounts" data-label="reads users">The identity API reads users from the accounts store.</li>
            <li data-edge data-source="web-shop" data-target="identity-api" data-tone="warn" data-label="signs in">The web shop signs shoppers in through the identity API.</li>
            <li data-edge data-source="web-shop" data-target="basket" data-tone="warn" data-label="adds to">The web shop adds items to the basket service.</li>
            <li data-edge data-source="web-shop" data-target="catalogue-api" data-label="reads">The web shop reads products from the catalogue API.</li>
            <li data-edge data-source="web-shop" data-target="recommendations" data-label="asks">The web shop asks recommendations for suggestions.</li>
            <li data-edge data-source="mobile-api" data-target="identity-api" data-tone="warn" data-label="signs in">The mobile app API signs shoppers in through the identity API.</li>
            <li data-edge data-source="mobile-api" data-target="basket" data-tone="warn" data-label="adds to">The mobile app API adds items to the basket service.</li>
            <li data-edge data-source="mobile-api" data-target="catalogue-api" data-label="reads">The mobile app API reads products from the catalogue API.</li>
            <li data-edge data-source="checkout-api" data-target="identity-api" data-tone="warn" data-label="verifies">The checkout API verifies the shopper with the identity API.</li>
            <li data-edge data-source="checkout-api" data-target="basket" data-tone="warn" data-label="reads">The checkout API reads the basket.</li>
            <li data-edge data-source="checkout-api" data-target="pricing" data-label="prices">The checkout API prices the basket with the pricing engine.</li>
            <li data-edge data-source="checkout-api" data-target="payments-api" data-label="charges">The checkout API charges through the payments API.</li>
            <li data-edge data-source="checkout-api" data-target="orders-api" data-label="places">The checkout API places orders with the orders API.</li>
            <li data-edge data-source="partner-api" data-target="identity-api" data-tone="warn" data-label="refreshes tokens">The partner API refreshes tokens with the identity API.</li>
            <li data-edge data-source="partner-api" data-target="orders-api" data-label="reads orders">The partner API reads orders from the orders API.</li>
            <li data-edge data-source="admin-console" data-target="identity-api" data-tone="warn" data-label="signs in">The admin console signs staff in through the identity API.</li>
            <li data-edge data-source="admin-console" data-target="catalogue-api" data-label="edits">The admin console edits products through the catalogue API.</li>
            <li data-edge data-source="support-desk" data-target="identity-api" data-tone="warn" data-label="signs in">The support desk signs staff in through the identity API.</li>
            <li data-edge data-source="support-desk" data-target="orders-api" data-label="looks up">The support desk looks orders up in the orders API.</li>
            <li data-edge data-source="recommendations" data-target="catalogue-api" data-label="reads">Recommendations read products from the catalogue API.</li>
            <li data-edge data-source="catalogue-api" data-target="search-index" data-label="queries">The catalogue API queries the search index.</li>
            <li data-edge data-source="catalogue-api" data-target="product-db" data-label="reads">The catalogue API reads the product database.</li>
            <li data-edge data-source="pricing" data-target="product-db" data-label="reads">The pricing engine reads the product database.</li>
            <li data-edge data-source="payments-api" data-target="ledger" data-label="books">The payments API books into the ledger.</li>
            <li data-edge data-source="orders-api" data-target="order-db" data-label="writes">The orders API writes the order database.</li>
            <li data-edge data-source="orders-api" data-target="order-worker" data-label="queues">The orders API queues orders for the order worker.</li>
            <li data-edge data-source="order-worker" data-target="warehouse-sync" data-label="sends">The order worker sends picking lists to warehouse sync.</li>
            <li data-edge data-source="reporting" data-target="order-db" data-label="reads">Reporting reads the order database.</li>
            <li data-edge data-source="reporting" data-target="ledger" data-label="reads">Reporting reads the ledger.</li>
            <li data-edge data-source="newsletter" data-target="accounts" data-label="reads">The newsletter reads addresses from the accounts store.</li>
        </ul>
        <div class="graph-canvas"></div>
        <div class="graph-tools" role="toolbar" aria-label="View">
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="zoom-in" aria-label="Zoom in" data-tip="Zoom in"><i class="ri-zoom-in-line"></i></button>
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="zoom-out" aria-label="Zoom out" data-tip="Zoom out"><i class="ri-zoom-out-line"></i></button>
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="fit" aria-label="Fit to the frame" data-tip="Fit to the frame"><i class="ri-focus-3-line"></i></button>
        </div>
        <div class="graph-wait skeleton skeleton-block"></div>
        <p class="visually-hidden" data-graph-live aria-live="polite"
           data-graph-announce="{label}: {meta}. {links} links in view." data-graph-announce-select="{label} selected."></p>
    </div>
    <div class="card-foot card-foot--start">
        <div class="graph-legend">
            <span class="graph-key"><span class="graph-swatch series-danger"></span> Down</span>
            <span class="graph-key"><span class="graph-swatch series-warn"></span> Failing because of it</span>
            <span class="graph-key"><span class="graph-swatch series-go"></span> Healthy</span>
            <span class="graph-key"><span class="graph-swatch graph-swatch--square series-muted"></span> Data store</span>
            <span class="graph-key"><span class="graph-line graph-line--arrow"></span> Calls</span>
        </div>
    </div>
</div>
