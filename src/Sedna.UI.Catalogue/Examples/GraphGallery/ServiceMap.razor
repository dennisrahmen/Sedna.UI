            <li data-edge data-source="payments" data-target="fraud" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The payments team owns fraud scoring.</li>
            <li data-edge data-source="payments" data-target="ledger" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The payments team owns the ledger.</li>
            <li data-edge data-source="payments" data-target="card-gateway" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The payments team owns the card gateway adapter.</li>
            <li data-edge data-source="fulfilment" data-target="orders-api" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The fulfilment team owns the orders API.</li>
            <li data-edge data-source="fulfilment" data-target="order-worker" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The fulfilment team owns the order worker.</li>
            <li data-edge data-source="fulfilment" data-target="warehouse-sync" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The fulfilment team owns warehouse sync.</li>
            <li data-edge data-source="fulfilment" data-target="labels" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The fulfilment team owns shipping labels.</li>
            <li data-edge data-source="identity" data-target="identity-api" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The identity team owns the identity API.</li>
            <li data-edge data-source="identity" data-target="session-store" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The identity team owns the session store.</li>

            <li data-edge data-source="gateway" data-target="web-shop" data-kind="calls" data-label="routes">The edge gateway routes shoppers to the web shop.</li>
            <li data-edge data-source="gateway" data-target="checkout-api" data-kind="calls" data-label="routes">The edge gateway routes to the checkout API.</li>
            <li data-edge data-source="gateway" data-target="identity-api" data-kind="calls" data-label="signs in">The edge gateway signs shoppers in through the identity API.</li>
            <li data-edge data-source="web-shop" data-target="catalogue-api" data-kind="calls" data-label="reads">The web shop reads products from the catalogue API.</li>
            <li data-edge data-source="web-shop" data-target="recommendations" data-kind="calls" data-label="asks" data-tone="warn">The web shop asks recommendations for suggestions.</li>
            <li data-edge data-source="web-shop" data-target="basket" data-kind="calls" data-label="adds to">The web shop adds items to the basket service.</li>
            <li data-edge data-source="catalogue-api" data-target="search-index" data-kind="calls" data-label="queries">The catalogue API queries the search index.</li>
            <li data-edge data-source="recommendations" data-target="catalogue-api" data-kind="calls" data-label="reads">Recommendations read products from the catalogue API.</li>
            <li data-edge data-source="checkout-api" data-target="basket" data-kind="calls" data-label="reads">The checkout API reads the basket.</li>
            <li data-edge data-source="checkout-api" data-target="pricing" data-kind="calls" data-label="prices">The checkout API prices the basket with the pricing engine.</li>
            <li data-edge data-source="pricing" data-target="catalogue-api" data-kind="calls" data-label="reads">The pricing engine reads list prices from the catalogue API.</li>
            <li data-edge data-source="checkout-api" data-target="identity-api" data-kind="calls" data-label="verifies">The checkout API verifies the shopper with the identity API.</li>
            <li data-edge data-source="checkout-api" data-target="payments-api" data-kind="calls" data-label="charges" data-weight="heavy">The checkout API charges the card through the payments API.</li>
            <li data-edge data-source="checkout-api" data-target="orders-api" data-kind="calls" data-label="places" data-weight="heavy">The checkout API places the order with the orders API.</li>
            <li data-edge data-source="payments-api" data-target="fraud" data-kind="calls" data-label="scores" data-tone="warn">The payments API scores every charge with fraud scoring.</li>
            <li data-edge data-source="payments-api" data-target="ledger" data-kind="calls" data-label="books">The payments API books every charge into the ledger.</li>
            <li data-edge data-source="payments-api" data-target="card-gateway" data-kind="calls" data-label="authorises">The payments API authorises cards through the card gateway adapter.</li>
            <li data-edge data-source="orders-api" data-target="order-worker" data-kind="calls" data-label="queues" data-line="dashed">The orders API queues each order for the order worker.</li>
            <li data-edge data-source="order-worker" data-target="warehouse-sync" data-kind="calls" data-label="sends" data-tone="danger">The order worker sends picking lists to warehouse sync.</li>
            <li data-edge data-source="order-worker" data-target="labels" data-kind="calls" data-label="prints">The order worker prints shipping labels.</li>
            <li data-edge data-source="identity-api" data-target="session-store" data-kind="calls" data-label="stores">The identity API stores sessions in the session store.</li>
        </ul>
        <div class="graph-canvas"></div>
        <div class="graph-tools" role="toolbar" aria-label="View">
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="zoom-in" aria-label="Zoom in" data-tip="Zoom in"><i class="ri-zoom-in-line"></i></button>
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="zoom-out" aria-label="Zoom out" data-tip="Zoom out"><i class="ri-zoom-out-line"></i></button>
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="fit" aria-label="Fit to the frame" data-tip="Fit to the frame"><i class="ri-focus-3-line"></i></button>
            <span class="graph-tools-sep"></span>
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="hulls" aria-pressed="true" aria-label="Outline teams" data-tip="Outline teams"><i class="ri-shape-line"></i></button>
            <button class="btn btn-ghost btn-sm btn-icon" type="button" data-graph-action="fullscreen" aria-pressed="false" aria-label="Full screen" data-tip="Full screen">
                <i class="ri-fullscreen-line graph-when-off"></i><i class="ri-fullscreen-exit-line graph-when-on"></i>
            </button>
        </div>
        <div class="graph-tip" data-graph-tip hidden>
            <span class="graph-tip-head"><i data-graph-icon aria-hidden="true"></i><span class="graph-tip-title" data-graph-field="label"></span></span>
            <span class="graph-tip-meta" data-graph-field="meta"></span>
            <span class="graph-tip-ref" data-graph-field="host"></span>
        </div>
        <div class="graph-wait skeleton skeleton-block"></div>
        <p class="visually-hidden" data-graph-live aria-live="polite"
           data-graph-announce="{label}, {meta}. {links} links." data-graph-announce-select="{label} selected."></p>
    </div>
    <div class="graph-legend">
        <span class="graph-key"><span class="graph-swatch series-go"></span> Healthy</span>
        <span class="graph-key"><span class="graph-swatch series-warn"></span> Degraded</span>
        <span class="graph-key"><span class="graph-swatch series-danger"></span> Down</span>
        <span class="graph-key"><span class="graph-swatch graph-swatch--square series-muted"></span> Data store</span>
        <span class="graph-key"><span class="graph-line graph-line--arrow"></span> Calls</span>
        <span class="graph-key"><span class="graph-line graph-line--dashed graph-line--arrow"></span> Queues</span>
        <span class="graph-key"><span class="graph-line graph-line--dotted"></span> Owned by the team</span>
    </div>
</div>
