            <li data-node="recommendations" data-group="storefront" data-kind="service" data-icon="ri-lightbulb-flash-line" data-tone="warn" data-tone-team="1" data-meta="Degraded · 3 % of requests fail" data-host="recs-worker-02" data-hub>Recommendations</li>

            <li data-node="checkout" data-group="checkout" data-kind="team" data-shape="rounded" data-icon="ri-team-line" data-tone="3" data-meta="Owns 3 services">Checkout team</li>
