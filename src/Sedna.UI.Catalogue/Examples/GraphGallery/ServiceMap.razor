            <li data-node="session-store" data-group="identity" data-kind="store" data-shape="square" data-icon="ri-database-2-line" data-tone="go" data-tone-team="2" data-meta="Healthy · 42 % memory" data-host="session-cache-02">Session store</li>

            <li data-edge data-source="storefront" data-target="web-shop" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The storefront team owns the web shop.</li>
            <li data-edge data-source="storefront" data-target="catalogue-api" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The storefront team owns the catalogue API.</li>
            <li data-edge data-source="storefront" data-target="search-index" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The storefront team owns the search index.</li>
            <li data-edge data-source="storefront" data-target="recommendations" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The storefront team owns recommendations.</li>
            <li data-edge data-source="checkout" data-target="checkout-api" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The checkout team owns the checkout API.</li>
            <li data-edge data-source="checkout" data-target="basket" data-kind="owns" data-label="owns" data-line="dotted" data-arrow="none" data-weight="light">The checkout team owns the basket service.</li>
