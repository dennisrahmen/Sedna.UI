            <li data-node="fulfilment" data-group="fulfilment" data-kind="team" data-shape="rounded" data-icon="ri-team-line" data-tone="4" data-meta="Owns 4 services">Fulfilment team</li>
            <li data-node="orders-api" data-group="fulfilment" data-kind="service" data-icon="ri-server-line" data-tone="go" data-tone-team="4" data-meta="Healthy · p95 95 ms" data-host="orders-console-01">Orders API</li>
            <li data-node="order-worker" data-group="fulfilment" data-kind="service" data-icon="ri-loop-right-line" data-tone="warn" data-tone-team="4" data-meta="Degraded · 1,240 messages waiting" data-host="orders-worker-03" data-hub>Order worker</li>
