<div class="graph-frame" data-graph-frame>
    <div class="toolbar">
        <div class="toolbar-filters chip-set" role="group" aria-label="Teams">
            <button class="chip" type="button" data-graph-filter="group" value="storefront" aria-pressed="true"><span class="graph-swatch series-1"></span> Storefront</button>
            <button class="chip" type="button" data-graph-filter="group" value="checkout" aria-pressed="true"><span class="graph-swatch series-3"></span> Checkout</button>
            <button class="chip" type="button" data-graph-filter="group" value="payments" aria-pressed="true"><span class="graph-swatch series-5"></span> Payments</button>
            <button class="chip" type="button" data-graph-filter="group" value="fulfilment" aria-pressed="true"><span class="graph-swatch series-4"></span> Fulfilment</button>
            <button class="chip" type="button" data-graph-filter="group" value="identity" aria-pressed="true"><span class="graph-swatch series-2"></span> Identity</button>
        </div>
        <div class="segmented segmented--sm" role="radiogroup" aria-label="Colour services by">
            <label class="segmented-option"><input type="radio" name="service-map-colour" value="tone" data-graph-option="colour" checked /> Health</label>
            <label class="segmented-option"><input type="radio" name="service-map-colour" value="team" data-graph-option="colour" /> Team</label>
        </div>
    </div>
    <div class="graph graph--lg card" data-graph id="service-map" data-graph-layout="islands" data-graph-hulls data-graph-spacing="compact"
         data-graph-arrows="target" aria-label="Service map by team, coloured by health" aria-roledescription="graph">
        <ul class="graph-data" data-graph-data>
            <li data-node="gateway" data-kind="edge" data-shape="hexagon" data-icon="ri-door-open-line" data-tone="go" data-tone-team="muted" data-meta="Healthy · p95 38 ms" data-host="edge-gateway-01" data-hub>Edge gateway</li>

            <li data-node="storefront" data-group="storefront" data-kind="team" data-shape="rounded" data-icon="ri-team-line" data-tone="1" data-meta="Owns 4 services">Storefront team</li>
            <li data-node="web-shop" data-group="storefront" data-kind="service" data-icon="ri-store-2-line" data-tone="go" data-tone-team="1" data-meta="Healthy · p95 120 ms" data-host="shop-web-01">Web shop</li>
            <li data-node="catalogue-api" data-group="storefront" data-kind="service" data-icon="ri-server-line" data-tone="go" data-tone-team="1" data-meta="Healthy · p95 64 ms" data-host="catalogue-api-02">Catalogue API</li>
