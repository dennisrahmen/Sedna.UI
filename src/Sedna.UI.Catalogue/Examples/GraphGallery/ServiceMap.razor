            <li data-node="basket" data-group="checkout" data-kind="service" data-icon="ri-server-line" data-tone="go" data-tone-team="3" data-meta="Healthy · p95 31 ms" data-host="basket-02">Basket service</li>
            <li data-node="pricing" data-group="checkout" data-kind="service" data-icon="ri-calculator-line" data-tone="go" data-tone-team="3" data-meta="Healthy · p95 47 ms" data-host="pricing-01">Pricing engine</li>

            <li data-node="payments" data-group="payments" data-kind="team" data-shape="rounded" data-icon="ri-team-line" data-tone="5" data-meta="Owns 4 services">Payments team</li>
            <li data-node="payments-api" data-group="payments" data-kind="service" data-icon="ri-bank-card-line" data-tone="go" data-tone-team="5" data-meta="Healthy · p95 210 ms" data-host="payments-api-01">Payments API</li>
            <li data-node="fraud" data-group="payments" data-kind="service" data-icon="ri-shield-check-line" data-tone="warn" data-tone-team="5" data-meta="Degraded · p95 1.9 s" data-host="fraud-score-01" data-hub>Fraud scoring</li>
            <li data-node="ledger" data-group="payments" data-kind="store" data-shape="square" data-icon="ri-database-2-line" data-tone="go" data-tone-team="5" data-meta="Healthy · replication lag 0 s" data-host="src-db-14">Ledger</li>
