<ol class="workflow workflow--sm" tabindex="0" aria-label="Three steps at work, one in each look">
    <li class="workflow-step" data-state="running">
        <article class="workflow-node">
            <header class="workflow-node-head">
                <span class="workflow-node-icon series-2"><i class="ri-database-2-line"></i></span>
                <span class="workflow-node-title">Look up the store</span>
                <span class="workflow-node-meta">Asset database &middot; running</span>
            </header>
        </article>
    </li>
</ol>

<ol class="workflow workflow--sm" tabindex="0" aria-label="A step at work with a glow">
    <li class="workflow-step" data-state="running">
        <article class="workflow-node workflow-node--glow">
            <header class="workflow-node-head">
                <span class="workflow-node-icon series-4"><i class="ri-mail-send-line"></i></span>
                <span class="workflow-node-title">Notify the store</span>
                <span class="workflow-node-meta">Mail &middot; running</span>
            </header>
        </article>
    </li>
</ol>

<ol class="workflow workflow--sm" tabindex="0" aria-label="An agent's step at work">
    <li class="workflow-step" data-state="running">
        <article class="workflow-node workflow-node--agent">
            <header class="workflow-node-head">
                <span class="workflow-node-icon workflow-node-icon--agent"><i class="ri-sparkling-2-line"></i></span>
                <span class="workflow-node-title">Decide where it goes</span>
                <span class="workflow-node-meta">Agent &middot; running</span>
            </header>
        </article>
    </li>
</ol>
