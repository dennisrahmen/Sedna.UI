<div class="sedna-split sedna-split--lg">
    <ol class="workflow workflow--sm workflow--grid" tabindex="0" aria-label="The ticket's steps; choose one to see what it did">
        <li class="workflow-step" data-state="done">
            <button class="workflow-node" type="button" aria-pressed="false">
                <span class="workflow-node-head">
                    <span class="workflow-node-icon workflow-node-icon--agent"><i class="ri-scales-3-line"></i></span>
                    <span class="workflow-node-title">Assess severity</span>
                    <span class="workflow-node-meta">P1 &middot; 2.1 s</span>
                </span>
            </button>
        </li>
        <li class="workflow-step" data-state="done">
            <button class="workflow-node" type="button" aria-pressed="true">
                <span class="workflow-node-head">
                    <span class="workflow-node-icon workflow-node-icon--agent"><i class="ri-route-line"></i></span>
                    <span class="workflow-node-title">Decide where it goes</span>
                    <span class="workflow-node-meta">Page on call &middot; 3.0 s</span>
                </span>
            </button>
        </li>
        <li class="workflow-step" data-state="waiting">
            <button class="workflow-node" type="button" aria-pressed="false">
                <span class="workflow-node-head">
                    <span class="workflow-node-icon series-danger"><i class="ri-alarm-warning-line"></i></span>
                    <span class="workflow-node-title">Page on call</span>
                    <span class="workflow-node-meta">Waiting for Rin</span>
                </span>
            </button>
        </li>
    </ol>
    <aside class="card sedna-split-aside">
        <div class="card-head">
            <strong>Decide where it goes</strong>
            <span class="badge badge-go">Done</span>
        </div>
        <div class="card-body sedna-col sedna-gap-3">
            <div>
                <div class="kv"><span class="k">Started</span><span class="v">21:40:12</span></div>
                <div class="kv"><span class="k">Took</span><span class="v">3.0 s</span></div>
                <div class="kv"><span class="k">Read</span><span class="v">T-48213, 2 related</span></div>
            </div>
            <ol class="workflow-decision" aria-label="Options it weighed">
                <li data-state="chosen">
                    <span class="workflow-decision-option">Page on call <span class="visually-hidden">(chosen)</span></span>
                    <span class="meter"><span class="meter-fill" style="--value: 86%"></span></span>
                    <span class="workflow-decision-score">0.86</span>
                </li>
                <li data-state="rejected">
                    <span class="workflow-decision-option">Queue for the morning</span>
                    <span class="meter"><span class="meter-fill" style="--value: 31%"></span></span>
                    <span class="workflow-decision-score">0.31</span>
                </li>
            </ol>
            <ol class="agent-steps">
                <li data-state="done">
                    <span class="agent-step-icon"><i class="ri-check-line"></i></span>
                    <details class="agent-step">
                        <summary><span class="agent-step-label"><i class="ri-calendar-schedule-line"></i>Read the on-call rota</span><span class="agent-step-meta">0.4 s</span></summary>
                        <pre class="code-block"><code>rota.current(team: "network") &rarr; Rin Nakamura, until 07:00</code></pre>
                    </details>
                </li>
            </ol>
        </div>
    </aside>
</div>
