<div class="sedna-grid" style="--grid-min: 260px; --grid-max: 3">
    <div class="card card--resizable" id="widget-orders" style="--card-height: 240px">
        <div class="card-head">
            <span class="card-head-lead"><i class="ri-draggable" aria-hidden="true"></i></span>
            <h3>Open orders</h3>
            <div class="card-head-right">
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Fold Open orders" aria-expanded="true"><i class="ri-arrow-up-s-line"></i></button>
            </div>
        </div>
        <div class="card-body">
            <ul class="list">
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4182</span><span class="list-sub">Northwind Retail</span></span></a></li>
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4183</span><span class="list-sub">Alex Fischer</span></span></a></li>
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4184</span><span class="list-sub">Northwind Retail</span></span></a></li>
                <li><a class="list-row" href="#"><span class="list-main"><span class="list-title">ORD-4185</span><span class="list-sub">Alex Fischer</span></span></a></li>
            </ul>
        </div>
        <div class="card-resize" data-resize="--card-height" role="separator" aria-orientation="horizontal" aria-label="Resize Open orders" aria-valuemin="120" aria-valuenow="240" tabindex="0"></div>
    </div>
    <div class="card card--folded">
        <div class="card-head">
            <span class="card-head-lead"><i class="ri-draggable" aria-hidden="true"></i></span>
            <h3>Returns this week</h3>
            <div class="card-head-right">
                <button class="btn btn--ghost btn--icon btn--sm" type="button" aria-label="Unfold Returns this week" aria-expanded="false"><i class="ri-arrow-down-s-line"></i></button>
            </div>
        </div>
        <div class="card-body"><p>12 returns, 3 awaiting inspection.</p></div>
    </div>
</div>
