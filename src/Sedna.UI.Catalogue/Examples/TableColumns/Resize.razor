<div class="sedna-scroll sedna-scroll-x" style="--scroll-max: 240px" tabindex="0" role="group" aria-label="Open orders">
    <table class="table table--fixed table--sticky table--pin-start">
        <thead>
            <tr>
                <th style="--col-width: 112px">
                    <span>Order</span>
                    <div class="col-resize" data-resize="--col-width" data-resize-key="order" role="separator" aria-orientation="vertical"
                         aria-label="Resize Order" aria-valuenow="112" tabindex="0"></div>
                </th>
                <th style="--col-width: 208px">
                    <span>Customer</span>
