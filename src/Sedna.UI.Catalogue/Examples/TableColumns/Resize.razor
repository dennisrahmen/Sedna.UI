                         aria-label="Resize State" aria-valuenow="120" tabindex="0"></div>
                </th>
                <th class="col-num" style="--col-width: 112px">
                    <span>Total (EUR)</span>
                    <div class="col-resize" data-resize="--col-width" data-resize-key="total" role="separator" aria-orientation="vertical"
