<div class="choice-tiles" role="radiogroup" aria-label="Screen layout" style="max-width:640px">
    <label class="choice-tile">
        <input type="radio" name="screen-layout" value="stage" checked />
        <span class="choice-tile-art"><i class="ri-layout-right-line" aria-hidden="true"></i></span>
        <span class="choice-tile-title">Stage and side</span>
        <span class="choice-tile-hint">Runs large, the queue beside them</span>
    </label>
    <label class="choice-tile">
        <input type="radio" name="screen-layout" value="grid" />
        <span class="choice-tile-art"><i class="ri-layout-grid-line" aria-hidden="true"></i></span>
        <span class="choice-tile-title">Grid</span>
        <span class="choice-tile-hint">Every run the same size</span>
    </label>
    <label class="choice-tile">
        <input type="radio" name="screen-layout" value="strip" />
        <span class="choice-tile-art"><i class="ri-layout-top-line" aria-hidden="true"></i></span>
        <span class="choice-tile-title">Strip</span>
        <span class="choice-tile-hint">Newest first along the top</span>
    </label>
    <label class="choice-tile">
        <input type="radio" name="screen-layout" value="focus" disabled />
        <span class="choice-tile-art"><i class="ri-focus-3-line" aria-hidden="true"></i></span>
        <span class="choice-tile-title">Focus</span>
        <span class="choice-tile-hint">Needs a second screen</span>
    </label>
</div>
