<fieldset class="form-field" style="max-width:420px">
    <legend class="form-label">Notify</legend>
    <div class="form-check-list-head">
        <label class="form-check"><input type="checkbox" data-check-all="ht-teams" /> <span>Every team</span></label>
    </div>
    <div class="form-check-list">
        <label class="form-check"><input type="checkbox" name="ht-teams" value="fulfilment" checked /> <span>Fulfilment</span></label>
        <label class="form-check"><input type="checkbox" name="ht-teams" value="returns" /> <span>Returns</span></label>
        <label class="form-check"><input type="checkbox" name="ht-teams" value="customer-care" checked /> <span>Customer care</span></label>
        <label class="form-check"><input type="checkbox" name="ht-teams" value="finance" /> <span>Finance</span></label>
    </div>
</fieldset>
<fieldset class="form-field" style="max-width:420px">
    <legend class="form-label">Rendered by the app</legend>
    <label class="form-check"><input type="checkbox" aria-checked="mixed" /> <span>Every warehouse</span></label>
</fieldset>
