<div class="cal-week cal-week--day-tones" style="--cal-hours: 3; --cal-hour-height: 40px">
    <div class="cal-week-head">
        <span></span>
        <span class="cal-weekday" aria-current="date">Thu 1</span>
        <span class="cal-weekday">
            <span>Fri 2</span>
            <span class="cal-marks">
                <button class="cal-mark" type="button" aria-label="2 tasks due"><i class="ri-checkbox-circle-line"></i><span>2</span></button>
            </span>
        </span>
        <span class="cal-weekday cal-day--weekend">Sat 3</span>
        <span class="cal-weekday cal-day--weekend">Sun 4</span>
        <span class="cal-weekday cal-day--holiday">Mon 5</span>
        <span class="cal-weekday">Tue 6</span>
        <span class="cal-weekday">Wed 7</span>
    </div>
    <div class="cal-week-body sedna-scroll">
        <div class="cal-hours">
            <span class="cal-hour">09:00</span>
            <span class="cal-hour">10:00</span>
            <span class="cal-hour">11:00</span>
        </div>
        <div class="cal-day-col" aria-current="date">
            <a class="cal-block" href="#" style="--cal-start: 0.5; --cal-span: 1"><span class="cal-event-time">09:30</span> <span>Stand-up</span></a>
        </div>
        <div class="cal-day-col"></div>
        <div class="cal-day-col"></div>
        <div class="cal-day-col"></div>
        <div class="cal-day-col"></div>
        <div class="cal-day-col">
            <a class="cal-block cal-event--teal" href="#" style="--cal-start: 1; --cal-span: 1.5"><span class="cal-event-time">10:00</span> <span>Carrier review</span></a>
        </div>
        <div class="cal-day-col"></div>
    </div>
</div>
