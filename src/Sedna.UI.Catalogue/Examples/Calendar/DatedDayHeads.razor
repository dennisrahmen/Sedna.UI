<div class="card" style="max-width: 720px">
    <div class="card-head"><h3>The next seven days</h3></div>
    <div class="cal-month cal-month--flush cal-month--day-tones" style="--cal-lanes: 1">
        <div class="cal-weekdays">
            <span class="cal-weekday cal-weekday--date" aria-current="date">Thu 19 Nov</span>
            <span class="cal-weekday cal-weekday--date">Fri 20</span>
            <span class="cal-weekday cal-weekday--date cal-day--weekend">Sat 21</span>
            <span class="cal-weekday cal-weekday--date cal-day--weekend">Sun 22</span>
            <span class="cal-weekday cal-weekday--date cal-day--holiday">Mon 23</span>
            <span class="cal-weekday cal-weekday--date">Tue 24</span>
            <span class="cal-weekday cal-weekday--date">Wed 25</span>
        </div>
        <div class="cal-row">
            <div class="cal-day" aria-current="date"></div>
            <div class="cal-day"></div>
            <div class="cal-day cal-day--weekend"></div>
            <div class="cal-day cal-day--weekend"></div>
            <div class="cal-day cal-day--holiday"></div>
            <div class="cal-day"></div>
            <div class="cal-day"></div>
            <div class="cal-row-events">
                <a class="cal-event cal-event--teal" href="#" style="grid-column: 1; grid-row: 1">Stock count</a>
                <a class="cal-event cal-event--go" href="#" style="grid-column: 6; grid-row: 1">Dispatch</a>
            </div>
        </div>
    </div>
</div>
