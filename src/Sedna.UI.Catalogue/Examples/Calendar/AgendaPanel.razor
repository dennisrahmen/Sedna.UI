<div class="card" style="max-width: 340px">
    <div class="card-head"><h3>This week</h3></div>
    <div class="sedna-scroll" style="--scroll-max: 320px">
        <div class="cal-agenda" style="border: 0; border-radius: 0">
            <section class="cal-agenda-day" aria-current="date" aria-labelledby="panel-14">
                <h4 class="cal-agenda-head" id="panel-14">
                    <span class="cal-agenda-weekday">Today</span>
                    <span class="cal-agenda-date">Mon 14 Sep</span>
                </h4>
                <ul class="cal-agenda-events">
                    <li class="cal-agenda-event cal-event--go">
                        <span class="cal-agenda-time">14:00 – 15:00</span>
                        <span class="cal-event-dot"></span>
                        <a class="cal-agenda-title" href="#">Dispatch ORD-4209</a>
                        <span class="cal-agenda-meta">Dock 2</span>
                    </li>
                    <li class="cal-agenda-event cal-event--teal">
                        <span class="cal-agenda-time">16:30 – 17:00</span>
                        <span class="cal-event-dot"></span>
                        <a class="cal-agenda-title" href="#">Carrier review</a>
                    </li>
                </ul>
            </section>
            <section class="cal-agenda-day" aria-labelledby="panel-15">
                <h4 class="cal-agenda-head" id="panel-15">
                    <span class="cal-agenda-weekday">Tomorrow</span>
                    <span class="cal-agenda-date">Tue 15 Sep</span>
                </h4>
                <ul class="cal-agenda-events">
                    <li class="cal-agenda-event cal-event--warn">
                        <span class="cal-agenda-time">All day</span>
                        <span class="cal-event-dot"></span>
                        <a class="cal-agenda-title" href="#">Stocktake, aisles 1 to 14</a>
                    </li>
                </ul>
            </section>
            <section class="cal-agenda-day" aria-labelledby="panel-16">
                <h4 class="cal-agenda-head" id="panel-16">
                    <span class="cal-agenda-weekday">Wednesday</span>
                    <span class="cal-agenda-date">16 Sep</span>
                </h4>
                <p class="cal-agenda-empty">Nothing planned</p>
            </section>
            <section class="cal-agenda-day" aria-labelledby="panel-17">
                <h4 class="cal-agenda-head" id="panel-17">
                    <span class="cal-agenda-weekday">Thursday</span>
                    <span class="cal-agenda-date">17 Sep</span>
                </h4>
                <ul class="cal-agenda-events">
                    <li class="cal-agenda-event cal-event--orange">
                        <span class="cal-agenda-time">09:00 – 11:00</span>
                        <span class="cal-event-dot"></span>
                        <a class="cal-agenda-title" href="#">Inbound, 2 trailers</a>
                        <span class="cal-agenda-meta">Docks 3–4</span>
                    </li>
                </ul>
            </section>
        </div>
    </div>
</div>
