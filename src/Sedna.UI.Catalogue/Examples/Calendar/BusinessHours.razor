<p class="text-muted text-sm">Open 08:00 to 18:00 on weekdays, closed on Saturday.</p>
<div class="cal-week" style="--cal-days: 6; --cal-hours: 12; --cal-hour-height: 36px">
    <div class="cal-week-head">
        <span></span>
        <span class="cal-weekday">Mon 14</span>
        <span class="cal-weekday">Tue 15</span>
        <span class="cal-weekday" aria-current="date">Wed 16</span>
        <span class="cal-weekday">Thu 17</span>
        <span class="cal-weekday">Fri 18</span>
        <span class="cal-weekday">Sat 19</span>
    </div>
    <div class="cal-week-body sedna-scroll">
        <div class="cal-hours">
            <span class="cal-hour">07:00</span>
            <span class="cal-hour">08:00</span>
            <span class="cal-hour">09:00</span>
            <span class="cal-hour">10:00</span>
            <span class="cal-hour">11:00</span>
            <span class="cal-hour">12:00</span>
            <span class="cal-hour">13:00</span>
            <span class="cal-hour">14:00</span>
            <span class="cal-hour">15:00</span>
            <span class="cal-hour">16:00</span>
            <span class="cal-hour">17:00</span>
            <span class="cal-hour">18:00</span>
        </div>
        <div class="cal-day-col">
            <div class="cal-closed" style="--cal-start: 0; --cal-span: 1"></div>
            <div class="cal-closed" style="--cal-start: 11; --cal-span: 1"></div>
            <a class="cal-block" href="#" style="--cal-start: 1; --cal-span: 0.5"><span class="cal-event-time">08:00</span> <span>Stand-up</span></a>
            <a class="cal-block cal-event--teal" href="#" style="--cal-start: 3; --cal-span: 2"><span class="cal-event-time">10:00</span> <span>Carrier review</span></a>
        </div>
        <div class="cal-day-col">
            <div class="cal-closed" style="--cal-start: 0; --cal-span: 1"></div>
            <div class="cal-closed" style="--cal-start: 11; --cal-span: 1"></div>
            <div class="cal-block cal-event--background cal-event--warn" style="--cal-start: 1; --cal-span: 10">Stock freeze</div>
            <a class="cal-block cal-event--warn" href="#" style="--cal-start: 2; --cal-span: 3"><span class="cal-event-time">09:00</span> <span>Stocktake, aisles 1 to 14</span></a>
        </div>
        <div class="cal-day-col" aria-current="date">
            <div class="cal-closed" style="--cal-start: 0; --cal-span: 1"></div>
            <div class="cal-closed" style="--cal-start: 11; --cal-span: 1"></div>
            <div class="cal-block cal-event--background cal-event--info" style="--cal-start: 5; --cal-span: 3">Maintenance window</div>
            <a class="cal-block cal-event--go" href="#" style="--cal-start: 7; --cal-span: 1"><span class="cal-event-time">14:00</span> <span>Dispatch ORD-4209</span></a>
            <div class="cal-now" style="--cal-at: 4.4"></div>
        </div>
        <div class="cal-day-col">
            <div class="cal-closed" style="--cal-start: 0; --cal-span: 1"></div>
            <div class="cal-closed" style="--cal-start: 11; --cal-span: 1"></div>
            <a class="cal-block cal-event--danger" href="#" style="--cal-start: 5; --cal-span: 1.5"><span class="cal-event-time">12:00</span> <span>Audit</span></a>
        </div>
        <div class="cal-day-col">
            <div class="cal-closed" style="--cal-start: 0; --cal-span: 1"></div>
            <div class="cal-closed" style="--cal-start: 10; --cal-span: 2"></div>
            <a class="cal-block cal-event--orange" href="#" style="--cal-start: 2; --cal-span: 2"><span class="cal-event-time">09:00</span> <span>Inbound, 2 trailers</span></a>
        </div>
        <div class="cal-day-col cal-day-col--closed"></div>
    </div>
</div>
