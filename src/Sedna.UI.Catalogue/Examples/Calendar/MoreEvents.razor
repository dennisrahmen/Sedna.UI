<div class="cal-month" style="--cal-lanes: 2; max-width: 760px">
    <div class="cal-weekdays">
        <span class="cal-weekday">Mon</span>
        <span class="cal-weekday">Tue</span>
        <span class="cal-weekday">Wed</span>
        <span class="cal-weekday">Thu</span>
        <span class="cal-weekday">Fri</span>
        <span class="cal-weekday">Sat</span>
        <span class="cal-weekday">Sun</span>
    </div>
    <div class="cal-row">
        <div class="cal-day"><span class="cal-day-num">14</span></div>
        <div class="cal-day"><span class="cal-day-num">15</span></div>
        <div class="cal-day" aria-current="date"><span class="cal-day-num">16</span></div>
        <div class="cal-day"><span class="cal-day-num">17</span></div>
        <div class="cal-day"><span class="cal-day-num">18</span></div>
        <div class="cal-day cal-day--weekend"><span class="cal-day-num">19</span></div>
        <div class="cal-day cal-day--weekend"><span class="cal-day-num">20</span></div>
        <div class="cal-row-events">
            <a class="cal-event cal-event--warn" href="#" style="grid-column: 2 / span 2; grid-row: 1">Stocktake</a>
            <a class="cal-event" href="#" style="grid-column: 1; grid-row: 1"><span class="cal-event-time">08:00</span> <span>Stand-up</span></a>
            <a class="cal-event cal-event--go" href="#" style="grid-column: 3; grid-row: 2"><span class="cal-event-time">14:00</span> <span>Dispatch ORD-4209</span></a>
            <button class="cal-more" type="button" data-popover="more-16" style="grid-column: 3" aria-label="2 more on Wednesday 16 September, show the day">+2 more</button>
            <a class="cal-event cal-event--teal" href="#" style="grid-column: 5; grid-row: 1"><span class="cal-event-time">10:00</span> <span>Carrier review</span></a>
            <a class="cal-event cal-event--orange" href="#" style="grid-column: 5; grid-row: 2"><span class="cal-event-time">13:00</span> <span>Inbound</span></a>
            <button class="cal-more" type="button" data-popover="more-18" style="grid-column: 5" aria-label="1 more on Friday 18 September, show the day">+1 more</button>
        </div>
    </div>
</div>
<div class="popover" id="more-16" popover>
    <strong class="popover-title">Wednesday 16 September</strong>
    <ul class="cal-event-list">
        <li><a class="cal-event cal-event--warn cal-event--continues-start" href="#">Stocktake, from Tuesday</a></li>
        <li><a class="cal-event cal-event--go" href="#"><span class="cal-event-time">14:00</span> <span>Dispatch ORD-4209</span></a></li>
        <li><a class="cal-event cal-event--danger" href="#"><span class="cal-event-time">15:30</span> <span>Fire door inspection</span></a></li>
        <li><a class="cal-event cal-event--tentative" href="#"><span class="cal-event-time">17:00</span> <span>Leaving drinks, tentative</span></a></li>
    </ul>
</div>
<div class="popover" id="more-18" popover>
    <strong class="popover-title">Friday 18 September</strong>
    <ul class="cal-event-list">
        <li><a class="cal-event cal-event--teal" href="#"><span class="cal-event-time">10:00</span> <span>Carrier review</span></a></li>
        <li><a class="cal-event cal-event--orange" href="#"><span class="cal-event-time">13:00</span> <span>Inbound, two trailers</span></a></li>
        <li><a class="cal-event cal-event--filled" href="#"><span class="cal-event-time">16:00</span> <span>Weekly close</span></a></li>
    </ul>
</div>
