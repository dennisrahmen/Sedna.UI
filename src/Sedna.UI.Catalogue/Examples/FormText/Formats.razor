<div class="sedna-grid sedna-grid--sm sedna-grid--fit" style="max-width:640px">
    <div class="form-field">
        <label class="form-label" for="fmt-phone">Phone</label>
        <input class="form-input" id="fmt-phone" type="tel" autocomplete="tel" placeholder="+44 20 7946 0958"
               aria-describedby="fmt-phone-hint" />
        <p class="form-hint" id="fmt-phone-hint">With the country code. Spaces are fine.</p>
    </div>
    <div class="form-field">
        <label class="form-label" for="fmt-postcode">Postcode</label>
        <input class="form-input" id="fmt-postcode" type="text" inputmode="numeric" autocomplete="postal-code"
               pattern="[0-9]{5}" maxlength="5" placeholder="12345" aria-describedby="fmt-postcode-hint" />
        <p class="form-hint" id="fmt-postcode-hint">Five digits.</p>
    </div>
    <div class="form-field">
        <label class="form-label" for="fmt-iban">IBAN</label>
        <input class="form-input text-mono" id="fmt-iban" type="text" autocomplete="off" autocapitalize="characters"
               spellcheck="false" pattern="[A-Za-z]{2}[0-9]{2}[A-Za-z0-9 ]{11,40}"
               aria-describedby="fmt-iban-hint" />
        <p class="form-hint" id="fmt-iban-hint">Copy it from your bank statement. Spaces are ignored.</p>
    </div>
    <div class="form-field">
        <label class="form-label" for="fmt-card">Card number</label>
        <input class="form-input text-mono" id="fmt-card" type="text" inputmode="numeric" autocomplete="cc-number"
               pattern="[0-9 ]{12,23}" placeholder="4111 1111 1111 1111" aria-describedby="fmt-card-hint" />
        <p class="form-hint" id="fmt-card-hint">The long number on the front. Spaces are fine.</p>
    </div>
</div>
