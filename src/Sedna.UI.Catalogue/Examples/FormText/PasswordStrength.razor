<div class="form-field" style="max-width:360px">
    <label class="form-label" for="pw-new">New password</label>
    <div class="input-group">
        <input class="form-input" id="pw-new" type="password" autocomplete="new-password" minlength="12"
               aria-describedby="pw-new-strength" value="lantern42" />
        <button class="input-reveal" type="button" data-reveal aria-controls="pw-new" aria-pressed="false" aria-label="Show password">
            <i class="ri-eye-line"></i><i class="ri-eye-off-line"></i>
        </button>
    </div>
    <div class="meter meter--sm" role="img" aria-label="Strength: weak">
        <span class="meter-fill series-warn" style="--value: 35%"></span>
    </div>
    <p class="form-hint" id="pw-new-strength">Weak — at least 12 characters. A few unrelated words are easier to remember than symbols.</p>
</div>
