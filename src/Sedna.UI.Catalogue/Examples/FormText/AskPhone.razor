<div class="form-section-body" style="max-width:520px">
    <div class="form-field">
        <label class="form-label" for="ap-tel">Phone number</label>
        <input class="form-input sedna-w sedna-w--md" id="ap-tel" type="tel" name="tel"
               autocomplete="tel" aria-describedby="ap-tel-hint" />
        <p class="form-hint" id="ap-tel-hint">For international numbers include the country code.</p>
    </div>
    <div class="form-field">
        <label class="form-label" for="ap-bad">Phone number</label>
        <input class="form-input sedna-w sedna-w--md" id="ap-bad" type="tel" name="tel-checked"
               autocomplete="tel" value="call me after 5" aria-invalid="true" aria-describedby="ap-bad-err" />
        <p class="form-error" id="ap-bad-err">
            <i class="ri-error-warning-line"></i>
            <span>Enter a phone number, like 01632 960 001 or +44 808 157 0192.</span>
        </p>
    </div>
</div>
