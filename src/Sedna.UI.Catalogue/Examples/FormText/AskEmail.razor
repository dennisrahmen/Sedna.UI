<div class="sedna-col" style="max-width:520px; gap:16px">
    <div class="form-field">
        <label class="form-label" for="ae-mail">Email address</label>
        <p class="form-hint" id="ae-mail-hint">We will only use this to send you a receipt.</p>
        <input class="form-input sedna-w sedna-w--lg" id="ae-mail" type="email" name="email"
               autocomplete="email" spellcheck="false" aria-describedby="ae-mail-hint" />
    </div>
    <div class="form-field">
        <label class="form-label" for="ae-bad">Email address</label>
        <input class="form-input sedna-w sedna-w--lg" id="ae-bad" type="email" name="email-checked"
               autocomplete="email" spellcheck="false" value="alex.fischer.example.com"
               aria-invalid="true" aria-describedby="ae-bad-err" />
        <p class="form-error" id="ae-bad-err">
            <i class="ri-error-warning-line"></i>
            <span>Enter an email address in the correct format, like name@example.com</span>
        </p>
    </div>
</div>
