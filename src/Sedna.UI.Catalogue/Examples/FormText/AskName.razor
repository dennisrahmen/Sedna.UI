<div class="form-section-body" style="max-width:520px">
    <div class="form-field">
        <label class="form-label" for="an-full">Full name</label>
        <input class="form-input sedna-w sedna-w--lg" id="an-full" type="text" name="full-name"
               autocomplete="name" spellcheck="false" />
    </div>
    <div class="sedna-grid sedna-grid--sm sedna-grid--fit">
        <div class="form-field">
            <label class="form-label" for="an-given">First name</label>
            <input class="form-input" id="an-given" type="text" name="given-name"
                   autocomplete="given-name" spellcheck="false" />
        </div>
        <div class="form-field">
            <label class="form-label" for="an-family">Last name</label>
            <input class="form-input" id="an-family" type="text" name="family-name"
                   autocomplete="family-name" spellcheck="false" />
        </div>
    </div>
    <div class="form-field">
        <label class="form-label" for="an-err">Full name</label>
        <input class="form-input sedna-w sedna-w--lg" id="an-err" type="text" name="full-name-checked"
               autocomplete="name" spellcheck="false" aria-invalid="true" aria-describedby="an-err-msg" />
        <p class="form-error" id="an-err-msg">
            <i class="ri-error-warning-line"></i>
            <span>Enter your full name.</span>
        </p>
    </div>
</div>
