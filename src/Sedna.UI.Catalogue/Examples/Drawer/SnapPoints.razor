<button class="btn" type="button" onclick="document.getElementById('route-sheet').showModal()">
    <i class="ri-route-line"></i> <span>Open the route</span>
</button>

<dialog class="drawer sheet" data-sheet data-sheet-snap="50%" id="route-sheet" aria-labelledby="route-sheet-title">
    <button class="sheet-handle" type="button" data-sheet-expand aria-expanded="false" aria-label="Resize the sheet"></button>
    <div class="drawer-header">
        <h3 id="route-sheet-title">Today's route for van 12</h3>
        <button class="modal-close" type="button" aria-label="Close"
                onclick="this.closest('dialog').close()"><i class="ri-close-line"></i></button>
    </div>
    <div class="drawer-body">
        <p>Half the screen while the driver glances at the next stop; drag it up, or press the handle, for every stop.</p>
        <ol>
            <li>Northwind Retail, Harbour Street</li>
            <li>Depot 2, loading bay 4</li>
            <li>Collection point, Market Square</li>
            <li>Alex Fischer, Mill Lane</li>
            <li>Parcel locker, station forecourt</li>
            <li>Depot 1, returns desk</li>
        </ol>
    </div>
</dialog>
