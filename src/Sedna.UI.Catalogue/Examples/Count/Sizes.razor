<div class="sedna-row-wrap sedna-gap-24">
    <button class="btn btn--sm btn--icon count-host" type="button" aria-label="Filters, 2 applied"><i class="ri-filter-3-line"></i><span class="count-badge" aria-hidden="true">2</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Messages, 5 unread"><i class="ri-message-2-line"></i><span class="count-badge" aria-hidden="true">5</span></button>
    <button class="btn btn--lg btn--icon count-host" type="button" aria-label="Messages, 12 unread"><i class="ri-message-2-line"></i><span class="count-badge" aria-hidden="true">12</span></button>
    <span class="count-host count-host--round"><span class="avatar avatar--sm avatar--viz-1" role="img" aria-label="Alex Fischer, 4 unread">AF</span><span class="count-badge" aria-hidden="true">4</span></span>
    <span class="count-host count-host--round"><span class="avatar avatar--viz-2" role="img" aria-label="Priya Nair, 4 unread">PN</span><span class="count-badge" aria-hidden="true">4</span></span>
    <span class="count-host count-host--round"><span class="avatar avatar--lg avatar--viz-3" role="img" aria-label="Jordan Weiss, 17 unread">JW</span><span class="count-badge" aria-hidden="true">17</span></span>
</div>
<div class="sedna-row-wrap sedna-gap-24">
    <button class="btn btn--sm btn--icon count-host" type="button" aria-label="Filters, something new"><i class="ri-filter-3-line"></i><span class="count-badge" aria-hidden="true"></span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Messages, something new"><i class="ri-message-2-line"></i><span class="count-badge" aria-hidden="true"></span></button>
    <button class="btn btn--lg btn--icon count-host" type="button" aria-label="Messages, something new"><i class="ri-message-2-line"></i><span class="count-badge" aria-hidden="true"></span></button>
    <span class="count-host count-host--round"><span class="avatar avatar--sm avatar--viz-1" role="img" aria-label="Alex Fischer, something new">AF</span><span class="count-badge" aria-hidden="true"></span></span>
    <span class="count-host count-host--round"><span class="avatar avatar--viz-2" role="img" aria-label="Priya Nair, something new">PN</span><span class="count-badge" aria-hidden="true"></span></span>
    <span class="count-host count-host--round"><span class="avatar avatar--lg avatar--viz-3" role="img" aria-label="Jordan Weiss, something new">JW</span><span class="count-badge" aria-hidden="true"></span></span>
</div>
<div class="sedna-row-wrap sedna-gap-24">
    <span class="count-host" role="img" aria-label="Mail, 3 unread"><i class="ri-mail-line ri-xl" aria-hidden="true"></i><span class="count-badge" aria-hidden="true">3</span></span>
    <span class="count-host" role="img" aria-label="Mail, 3 unread"><i class="ri-mail-line ri-3x" aria-hidden="true"></i><span class="count-badge count-badge--lg" aria-hidden="true">3</span></span>
    <span class="count-host" role="img" aria-label="Mail, 3 unread" style="--count-size: 18px; --count-text: var(--text-2)"><i class="ri-mail-line ri-4x" aria-hidden="true"></i><span class="count-badge" aria-hidden="true">3</span></span>
    <button class="btn btn--icon count-host" type="button" aria-label="Messages, 5 unread"><i class="ri-message-2-line"></i><span class="count-badge count-badge--sm" aria-hidden="true">5</span></button>
</div>
