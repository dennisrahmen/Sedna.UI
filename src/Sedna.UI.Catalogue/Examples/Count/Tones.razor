<div class="sedna-row-wrap sedna-gap-20">
    <button class="btn btn--icon count-host" type="button" aria-label="New messages, 5"><i class="ri-message-2-line"></i><span class="count-badge count-badge--brand" aria-hidden="true">5</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Finished, 1"><i class="ri-download-2-line"></i><span class="count-badge count-badge--go" aria-hidden="true">1</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Needs a look, 3"><i class="ri-error-warning-line"></i><span class="count-badge count-badge--warn" aria-hidden="true">3</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Incidents, 2"><i class="ri-alarm-warning-line"></i><span class="count-badge count-badge--danger" aria-hidden="true">2</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Updates, 4"><i class="ri-refresh-line"></i><span class="count-badge count-badge--info" aria-hidden="true">4</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Private, 1"><i class="ri-lock-line"></i><span class="count-badge count-badge--secret" aria-hidden="true">1</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Mentions, 7"><i class="ri-at-line"></i><span class="count-badge count-badge--cyan" aria-hidden="true">7</span></button>
