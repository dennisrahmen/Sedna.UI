<div class="sedna-row-wrap sedna-gap-20">
    <button class="btn btn--icon count-host" type="button" aria-label="Messages, 5 unread"><i class="ri-message-2-line"></i><span class="count-badge" aria-hidden="true">5</span></button>
    <button class="btn btn--sm btn--icon count-host" type="button" aria-label="Filters, 2 applied"><i class="ri-filter-3-line"></i><span class="count-badge count-badge--muted" aria-hidden="true">2</span></button>
    <button class="btn count-host" type="button" aria-label="Review, 8 waiting"><i class="ri-eye-line"></i> <span>Review</span><span class="count-badge count-badge--danger" aria-hidden="true">8</span></button>
    <button class="btn btn--icon count-host" type="button" aria-label="Refresh, new results"><i class="ri-refresh-line"></i><span class="count-badge count-badge--go" aria-hidden="true"></span></button>
</div>
