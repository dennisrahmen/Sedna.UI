<div class="transfer" data-transfer style="max-width:640px">
    <div class="form-field">
        <span class="form-label" id="tr-available-label">Available groups</span>
        <div class="listbox" role="listbox" id="tr-available" aria-labelledby="tr-available-label" aria-multiselectable="true" tabindex="0" style="--listbox-rows:6" data-transfer-from>
            <div role="option" aria-selected="false">Facilities</div>
            <div role="option" aria-selected="false">Finance</div>
            <div role="option" aria-selected="false">Network</div>
            <div role="option" aria-selected="false">Procurement</div>
            <div role="option" aria-selected="false">Security</div>
            <div role="option" aria-selected="false">Warehouse</div>
        </div>
        <p class="form-hint">Pick one or more, then Add. A double-click moves a single row.</p>
    </div>

    <div class="transfer-actions">
        <button class="btn btn--icon" type="button" data-transfer-add aria-label="Add to notified"
                data-tip="Moves everything chosen on the left over to the right.">
            <i class="ri-arrow-right-line"></i>
        </button>
        <button class="btn btn--icon" type="button" data-transfer-remove aria-label="Remove from notified"
                data-tip="Moves everything chosen on the right back to the left.">
            <i class="ri-arrow-left-line"></i>
        </button>
    </div>

    <div class="form-field">
        <span class="form-label" id="tr-notified-label">Notified on escalation</span>
        <div class="listbox" role="listbox" id="tr-notified" aria-labelledby="tr-notified-label" aria-multiselectable="true" tabindex="0" style="--listbox-rows:6" data-transfer-to>
            <div role="option" aria-selected="false">Fulfilment</div>
            <div role="option" aria-selected="false">On call</div>
        </div>
        <p class="form-hint">This is the answer: the rows in this list. A listbox posts nothing, so read them from <code>sedna-listbox-select</code>.</p>
    </div>
</div>
