<div class="form-field">
    <span class="form-label" id="oc-signin-label">Sign-in code</span>
    <div class="form-code" data-code-group role="group" aria-labelledby="oc-signin-label" aria-describedby="oc-signin-hint">
        <input type="hidden" name="code" data-code-value />
        <input class="form-input" inputmode="numeric" autocomplete="one-time-code" aria-label="Digit 1 of 6" />
        <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 2 of 6" />
        <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 3 of 6" />
        <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 4 of 6" />
        <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 5 of 6" />
        <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 6 of 6" />
    </div>
    <p class="form-hint" id="oc-signin-hint">Sent by text message to the number ending 042. It expires in 10 minutes.</p>
</div>
