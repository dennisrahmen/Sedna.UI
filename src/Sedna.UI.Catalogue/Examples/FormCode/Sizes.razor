<div class="sedna-col sedna-gap-2">
    <div class="sedna-row-wrap">
        <div class="form-code form-code--sm" data-code-group role="group" aria-label="Door PIN, small">
            <input type="hidden" name="pin-sm" data-code-value />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 1 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 2 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 3 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 4 of 4" />
        </div>
        <button class="btn btn--sm" type="button">Unlock</button>
    </div>
    <div class="sedna-row-wrap">
        <div class="form-code" data-code-group role="group" aria-label="Door PIN">
            <input type="hidden" name="pin-md" data-code-value />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 1 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 2 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 3 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 4 of 4" />
        </div>
        <button class="btn" type="button">Unlock</button>
    </div>
    <div class="sedna-row-wrap">
        <div class="form-code form-code--lg" data-code-group role="group" aria-label="Door PIN, large">
            <input type="hidden" name="pin-lg" data-code-value />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 1 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 2 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 3 of 4" />
            <input class="form-input" inputmode="numeric" autocomplete="off" aria-label="Digit 4 of 4" />
        </div>
        <button class="btn btn--lg" type="button">Unlock</button>
    </div>
</div>
