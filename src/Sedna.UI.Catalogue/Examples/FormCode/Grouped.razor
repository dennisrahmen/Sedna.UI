<div class="form-field">
    <span class="form-label" id="oc-recovery-label">Recovery code</span>
    <div class="form-code" data-code-group role="group" aria-labelledby="oc-recovery-label" aria-describedby="oc-recovery-hint">
        <input type="hidden" name="recovery" data-code-value />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 1 of 8" />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 2 of 8" />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 3 of 8" />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 4 of 8" />
        <span class="form-code-sep" aria-hidden="true">&ndash;</span>
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 5 of 8" />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 6 of 8" />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 7 of 8" />
        <input class="form-input" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Character 8 of 8" />
    </div>
    <p class="form-hint" id="oc-recovery-hint">One of the ten codes you saved when you turned on two-step sign-in.</p>
</div>
