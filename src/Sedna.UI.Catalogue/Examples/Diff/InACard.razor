<div class="card" style="max-width:640px">
    <div class="card-head">
        <h3>Pick list template</h3>
        <div class="card-head-right">
            <span class="badge badge--go">+2</span>
            <span class="badge badge--danger">&minus;1</span>
        </div>
    </div>
    <div class="diff diff--flush">
        <div class="diff-body">
            <table class="diff-table">
                <caption class="visually-hidden">Changes to the pick list template</caption>
                <thead class="visually-hidden">
                    <tr><th scope="col">Old line</th><th scope="col">New line</th><th scope="col">Text</th></tr>
                </thead>
                <tbody>
                    <tr><td class="diff-num">4</td><td class="diff-num">4</td><td class="diff-code">columns: [bin, sku, qty]</td></tr>
                    <tr class="diff-del"><td class="diff-num">5</td><td class="diff-num"></td><td class="diff-code">sort: <del>sku</del></td></tr>
                    <tr class="diff-add"><td class="diff-num"></td><td class="diff-num">5</td><td class="diff-code">sort: <ins>bin</ins></td></tr>
                    <tr class="diff-add"><td class="diff-num"></td><td class="diff-num">6</td><td class="diff-code">group_by: aisle</td></tr>
                    <tr><td class="diff-num">6</td><td class="diff-num">7</td><td class="diff-code">footer: Packed by ____</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-foot">
        <button class="btn" type="button">Keep the old one</button>
        <button class="btn btn--brand btn--solid" type="button">Use the new template</button>
    </div>
</div>
