<div class="mochi-host" style="max-width: 360px; margin-block-start: 80px">
    <div class="card">
        <div class="empty-state">
            <span class="empty-state-title">Nothing in the queue</span>
            <p>Support agent is resting. A new ticket wakes it up.</p>
            <button class="btn btn-sm" type="button">Assign a ticket</button>
        </div>
    </div>
    <span class="mochi" data-perch="sit" data-action="sleep" data-tone="lilac" style="--size: 96px; --perch-inset: calc(50% - 48px)" role="img" aria-label="Support agent, asleep"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
</div>
