<div class="mochi-host mochi-host--room" style="max-width: 360px; --size: 96px">
    <div class="card">
        <div class="empty-state">
            <span class="empty-state-title">Assign a message to Support agent</span>
            <p>Its queue is empty. A new customer message wakes it up.</p>
            <button class="btn btn--sm" type="button">Assign a message</button>
        </div>
    </div>
    <span class="mochi" data-perch="sit" data-action="sleep" data-tone="lilac" style="--perch-inset: calc(50% - var(--size) / 2)" role="img" aria-label="Support agent, asleep"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
</div>
