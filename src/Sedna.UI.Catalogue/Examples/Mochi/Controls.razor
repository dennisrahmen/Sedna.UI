<div class="sedna-row-wrap sedna-start sedna-gap-40">
    <div class="form-field sedna-w sedna-w--lg">
        <label class="form-label" for="mochi-runbook">Runbook name</label>
        <div class="mochi-host">
            <input class="form-input" id="mochi-runbook" value="Restart the order sync" />
            <span class="mochi mochi--md" data-perch="peek" data-mood="curious" data-tone="lilac" role="img" aria-label="Research agent, peeking over the field"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
    </div>
    <div class="sedna-w sedna-w--lg">
        <div class="mochi-host mochi-host--room">
            <div class="search">
                <i class="ri-search-line search-icon" aria-hidden="true"></i>
                <input class="search-input" type="search" placeholder="Search runbooks" aria-label="Search runbooks" />
            </div>
            <span class="mochi mochi--md" data-perch="hang" data-action="point" data-tone="sky" role="img" aria-label="Research agent, hanging from the search box"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
    </div>
    <div class="mochi-host mochi-host--inline mochi-host--room">
        <button class="btn btn--go btn--solid" type="button">Approve the change</button>
        <span class="mochi mochi--md" data-perch="sit" data-action="celebrate" data-tone="lemon" role="img" aria-label="Release agent, cheering on the button"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
    </div>
</div>
