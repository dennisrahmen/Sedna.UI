<div class="sedna-row-wrap sedna-gap-3" style="align-items: start; row-gap: var(--space-9)">
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 96px">
        <div class="mochi-host">
            <div class="card">
                <div class="card-head"><strong>Order sync</strong><span class="badge badge-go">Healthy</span></div>
                <div class="card-body">Three runs since 03:30, all on time.</div>
            </div>
            <span class="mochi" data-perch="sit" data-action="idle" role="img" aria-label="Ops agent, sitting on the card"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>sit</code> on the top edge, feet dangling in front</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 96px">
        <div class="mochi-host">
            <div class="card">
                <div class="card-head"><strong>Ticket summary</strong><span class="badge badge-ai"><i class="ri-sparkling-2-line"></i>AI</span></div>
                <div class="card-body">214 tickets, mostly one sync failure.</div>
            </div>
            <span class="mochi" data-perch="peek" data-mood="curious" role="img" aria-label="Research agent, peeking over the card"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>peek</code> over the top, both hands on the edge</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 96px">
        <div class="mochi-host">
            <div class="card">
                <div class="card-head"><strong>Welcome back, Alex</strong></div>
                <div class="card-body">Two approvals are waiting for you.</div>
            </div>
            <span class="mochi" data-perch="peek" data-action="wave" data-mood="happy" data-tone="mint" role="img" aria-label="Support agent, waving over the card"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>peek</code> and <code>wave</code>: one hand lets go</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 96px">
        <div class="mochi-host">
            <div class="card">
                <div class="card-head"><strong>Runbook</strong></div>
                <div class="card-body"><span class="skeleton skeleton-text" style="width: 92%"></span><span class="skeleton skeleton-text" style="width: 76%"></span></div>
            </div>
            <span class="mochi" data-perch="look" data-tone="sky" role="img" aria-label="Research agent, reading the card"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>look</code> leaning in, reading what is below</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 96px; padding-inline-end: 72px">
        <div class="mochi-host">
            <div class="card">
                <div class="card-head"><strong>Release 4.2</strong><span class="badge badge-warn">Staged</span></div>
                <div class="card-body">Waiting for your go-ahead.</div>
            </div>
            <span class="mochi" data-perch="side" data-mood="curious" data-tone="lilac" role="img" aria-label="Release agent, peeking out from behind the card"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>side</code> leaning out from behind the edge</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 96px">
        <div class="mochi-host">
            <div class="card">
                <div class="card-head"><strong>Report ready</strong></div>
                <div class="card-body" style="padding-block-end: 88px">214 tickets summarised in 1:12.</div>
            </div>
            <span class="mochi" data-perch="stand" data-action="done" data-tone="lemon" role="img" aria-label="Research agent, done"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>stand</code> on the bottom edge</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 24px">
        <div class="mochi-host" style="margin-block-end: 104px">
            <div class="card">
                <div class="card-head"><strong>Disk usage</strong><span class="badge badge-danger">97%</span></div>
                <div class="card-body">src-db-14 is nearly full.</div>
            </div>
            <span class="mochi" data-perch="hang" data-tone="coral" role="img" aria-label="Ops agent, hanging from the card"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>hang</code> from the bottom edge by both hands</figcaption>
    </figure>
    <figure class="sedna-col sedna-gap-3" style="margin: 0; width: 260px; padding-block-start: 24px">
        <div class="mochi-host" style="margin-block-end: 104px">
            <div class="card">
                <div class="card-head"><strong>New in this release</strong></div>
                <div class="card-body">Approvals now show who asked.</div>
            </div>
            <span class="mochi" data-perch="hang" data-action="wave" data-mood="excited" data-tone="sky" role="img" aria-label="Support agent, hanging from the card and waving"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
        </div>
        <figcaption class="text-muted text-sm"><code>hang</code> and <code>wave</code>: one hand lets go</figcaption>
    </figure>
</div>
