<div class="card" style="max-width: 460px">
    <ul class="list">
        <li><div class="list-row">
            <span class="mochi mochi--bust" data-action="celebrate" style="--size: 44px" role="img" aria-label="Research agent, celebrating"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
            <span class="list-main"><span class="list-title">Report ready</span><span class="list-sub">214 tickets summarised in 1:12</span></span>
            <span class="list-meta"><button class="btn btn-sm btn-primary" type="button">Open</button></span>
        </div></li>
        <li><div class="list-row">
            <span class="mochi mochi--bust" data-action="oops" data-tone="sky" style="--size: 44px" role="img" aria-label="Billing agent, stuck"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
            <span class="list-main"><span class="list-title">Refund failed</span><span class="list-sub">The payment service did not answer.</span></span>
            <span class="list-meta"><button class="btn btn-sm" type="button">Retry</button></span>
        </div></li>
        <li><div class="list-row">
            <span class="mochi mochi--bust" data-action="listen" data-tone="mint" style="--size: 44px" role="img" aria-label="Voice agent, listening"><svg viewBox="0 0 160 160" aria-hidden="true"><use href="#sedna-mochi" /></svg></span>
            <span class="list-main"><span class="list-title">Listening</span><span class="list-sub">Say what you need.</span></span>
            <span class="list-meta"><button class="btn btn-sm btn-icon btn-mic" type="button" data-state="listening" aria-label="Stop listening"><i class="ri-mic-fill"></i></button></span>
        </div></li>
    </ul>
</div>
