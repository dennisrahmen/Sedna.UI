<div class="sedna-col sedna-gap-2">
    <div class="sedna-row-wrap">
        <div class="segmented segmented--sm" role="group" aria-label="Small time range">
            <label class="segmented-option"><input type="radio" name="sz-sm" checked /> <span>24h</span></label>
            <label class="segmented-option"><input type="radio" name="sz-sm" /> <span>7d</span></label>
        </div>
        <button class="btn btn--sm" type="button"><i class="ri-refresh-line"></i> <span>Refresh</span></button>
        <input class="form-input form-input--sm toolbar-input" type="search" placeholder="Search orders&hellip;" />
    </div>
    <div class="sedna-row-wrap">
        <div class="segmented" role="group" aria-label="Time range">
            <label class="segmented-option"><input type="radio" name="sz-md" checked /> <span>24h</span></label>
            <label class="segmented-option"><input type="radio" name="sz-md" /> <span>7d</span></label>
        </div>
        <button class="btn" type="button"><i class="ri-refresh-line"></i> <span>Refresh</span></button>
        <input class="form-input toolbar-input" type="search" placeholder="Search orders&hellip;" />
    </div>
    <div class="sedna-row-wrap">
        <div class="segmented segmented--lg" role="group" aria-label="Large time range">
            <label class="segmented-option"><input type="radio" name="sz-lg" checked /> <span>24h</span></label>
            <label class="segmented-option"><input type="radio" name="sz-lg" /> <span>7d</span></label>
        </div>
        <button class="btn btn--lg" type="button"><i class="ri-refresh-line"></i> <span>Refresh</span></button>
        <input class="form-input form-input--lg toolbar-input" type="search" placeholder="Search orders&hellip;" />
    </div>
</div>
