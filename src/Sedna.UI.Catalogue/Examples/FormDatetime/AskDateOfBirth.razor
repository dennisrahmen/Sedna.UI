<fieldset class="form-section" style="max-width:520px">
    <legend>Date of birth</legend>
    <p class="form-section-hint" id="ad-hint">For example, 27 3 1990</p>
    <div class="form-section-body">
        <div class="sedna-row-wrap sedna-gap-12 sedna-start">
            <div class="form-field">
                <label class="form-label" for="ad-day">Day</label>
                <input class="form-input sedna-w-fit" id="ad-day" type="text" name="dob-day" size="2"
                       inputmode="numeric" autocomplete="bday-day" aria-describedby="ad-hint" />
            </div>
            <div class="form-field">
                <label class="form-label" for="ad-month">Month</label>
                <input class="form-input sedna-w-fit" id="ad-month" type="text" name="dob-month" size="2"
                       inputmode="numeric" autocomplete="bday-month" aria-describedby="ad-hint" />
            </div>
            <div class="form-field">
                <label class="form-label" for="ad-year">Year</label>
                <input class="form-input sedna-w-fit" id="ad-year" type="text" name="dob-year" size="4"
                       inputmode="numeric" autocomplete="bday-year" aria-describedby="ad-hint" />
            </div>
        </div>
    </div>
</fieldset>
