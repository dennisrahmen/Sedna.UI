<div class="card" style="max-width:420px">
    <div class="card-head"><h3>Pair a scanner</h3></div>
    <div class="card-body sedna-col sedna-center sedna-gap-4">
        <p class="text-muted">Open the camera on the handheld and point it at the code. It pairs the device with dock 3 for this shift.</p>
        <figure class="qr-figure">
            <span class="qr" data-qr="https://example.com/pair/7Q4K-2HM9" aria-label="QR code that pairs a scanner with dock 3"></span>
            <figcaption class="qr-caption">example.com/pair/7Q4K-2HM9</figcaption>
        </figure>
        <button class="btn btn--sm" type="button" data-copy="https://example.com/pair/7Q4K-2HM9"><i class="ri-file-copy-line"></i> <span>Copy the link</span></button>
    </div>
</div>
