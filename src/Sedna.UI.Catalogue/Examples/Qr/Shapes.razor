        <figure class="qr-figure">
            <span class="qr qr--sm" data-qr="https://example.com/pair/7Q4K-2HM9" data-qr-shape="dots" aria-label="QR code with dots"></span>
            <figcaption class="qr-caption">Dots</figcaption>
        </figure>
