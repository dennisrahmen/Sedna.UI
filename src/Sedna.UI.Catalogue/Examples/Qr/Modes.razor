<div class="sedna-row sedna-wrap sedna-gap-40">
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="0123456789012345678901234567890123456789" aria-label="QR code of a number"></span>
        <figcaption class="qr-caption">Digits only</figcaption>
    </figure>
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="DOCK 4 ROW 12 BAY 3" aria-label="QR code of a location in capitals"></span>
        <figcaption class="qr-caption">Capitals, digits and a few symbols</figcaption>
    </figure>
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="Straße 4, Dock 4 — データ" aria-label="QR code of mixed text"></span>
        <figcaption class="qr-caption">Any other text, as UTF-8</figcaption>
    </figure>
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="https://example.com/orders/20261117093000142857" aria-label="QR code of an address with a long number"></span>
        <figcaption class="qr-caption">An address ending in a long number</figcaption>
    </figure>
</div>
