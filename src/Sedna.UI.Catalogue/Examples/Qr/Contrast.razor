<div class="sedna-row sedna-wrap sedna-gap-40">
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="https://example.com/pair/7Q4K-2HM9" style="--qr-ink: var(--slate-400)" aria-label="QR code whose pale ink is drawn in the safe colours"></span>
        <figcaption class="qr-caption">A pale ink, drawn in the safe pair</figcaption>
    </figure>
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="https://example.com/pair/7Q4K-2HM9" style="--qr-ink: var(--white); --qr-paper: var(--slate-900)" aria-label="QR code whose light ink is drawn in the safe colours"></span>
        <figcaption class="qr-caption">Light on dark, not allowed</figcaption>
    </figure>
    <figure class="qr-figure">
        <span class="qr qr--sm" data-qr="https://example.com/pair/7Q4K-2HM9" data-qr-invert style="--qr-ink: var(--white); --qr-paper: var(--slate-900)" aria-label="Inverted QR code, light modules on a dark paper"></span>
        <figcaption class="qr-caption">Light on dark, allowed</figcaption>
    </figure>
</div>
