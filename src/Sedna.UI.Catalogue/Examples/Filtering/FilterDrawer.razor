<div class="toolbar">
    <div class="toolbar-filters">
        <button class="btn" type="button" aria-haspopup="dialog" aria-label="Filters, 3 applied"
                onclick="sednaUi.modal.show('fd-filters')">
            <i class="ri-filter-3-line"></i> <span>Filters</span> <span class="badge badge--sm badge--info">3</span>
        </button>
    </div>
    <div class="toolbar-actions">
        <span class="toolbar-count">302 of 1,656 orders</span>
    </div>
</div>

<dialog class="drawer drawer--start" id="fd-filters" aria-labelledby="fd-title">
    <div class="drawer-header">
        <h3 id="fd-title">Filters</h3>
        <button class="modal-close" type="button" aria-label="Close"
                onclick="this.closest('dialog').close()"><i class="ri-close-line"></i></button>
    </div>
    <form class="drawer-body" id="fd-form" method="dialog">
        <fieldset class="form-section">
            <legend>Status</legend>
            <div class="form-section-body">
                <label class="form-check"><input type="checkbox" checked /> <span>Open</span> <span class="form-check-count">412</span></label>
                <label class="form-check"><input type="checkbox" checked /> <span>Held</span> <span class="form-check-count">38</span></label>
                <label class="form-check"><input type="checkbox" /> <span>Shipped</span> <span class="form-check-count">1,206</span></label>
                <label class="form-check"><input type="checkbox" disabled /> <span>Cancelled</span> <span class="form-check-count">0</span></label>
            </div>
        </fieldset>
        <fieldset class="form-section">
            <legend>Region</legend>
            <div class="form-section-body">
                <label class="form-check"><input type="checkbox" checked /> <span>EU-West</span> <span class="form-check-count">301</span></label>
                <label class="form-check"><input type="checkbox" /> <span>EU-Central</span> <span class="form-check-count">97</span></label>
                <label class="form-check"><input type="checkbox" /> <span>US-East</span> <span class="form-check-count">52</span></label>
            </div>
        </fieldset>
        <fieldset class="form-section">
            <legend>Amount</legend>
            <div class="input-group input-group--sm">
                <input class="form-input" type="number" value="100" placeholder="Min" aria-label="Lowest amount" />
                <span class="input-affix">–</span>
                <input class="form-input" type="number" placeholder="Max" aria-label="Highest amount" />
            </div>
        </fieldset>
    </form>
    <div class="drawer-footer">
        <button class="btn btn--ghost" type="reset" form="fd-form">Reset</button>
        <button class="btn btn--brand btn--solid" type="submit" form="fd-form">Show 302 orders</button>
    </div>
</dialog>
