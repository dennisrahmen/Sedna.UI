<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sedna.UI.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Renders the tier-1 components and asserts the markup they emit, which is
         a version contract: an app breaks on a changed class or element. -->
    <!-- 2.8.6, not 1.40: bUnit 1.x pins AngleSharp 1.2.0, which carries
         GHSA-pgww-w46g-26qg. TreatWarningsAsErrors turns NU1902 into a build
         failure, which is the behaviour we want — 2.8.6 brings AngleSharp 1.5.2,
         the first patched release. -->
    <PackageReference Include="bunit" Version="2.8.6" />
    <!-- Drives a real browser over the catalogue. Restores like any other package;
         the browser binaries are a separate `playwright install` step, so the tests
         that need them skip when they are absent (see BrowserTests). -->
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <!-- axe-core over the same Playwright pages. It finds the WCAG rules a source
         scan cannot see at all: a missing accessible name, a broken label
         association, a contrast pair the token audit did not think to check. -->
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sedna.UI\Sedna.UI.csproj" />
  </ItemGroup>

</Project>
