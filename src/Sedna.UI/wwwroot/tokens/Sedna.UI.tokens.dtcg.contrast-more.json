  "warn": {
    "warn-bg": {
      "$type": "color",
      "$value": "{amber.amber-900}"
    },
    "warn-border": {
      "$type": "color",
      "$value": "{amber.amber-400}"
    },
    "warn-fg": {
      "$type": "color",
      "$value": "{amber.amber-300}"
    }
  }
}
