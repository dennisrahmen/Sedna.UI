{
  "$description": "Sedna.UI design tokens for :root[data-density=\"touch\"]. Load after the files in load.",
  "$extensions": {
    "com.sedna-ui": {
      "selector": ":root[data-density=\"touch\"]",
      "media": null,
      "load": [
        "Sedna.UI.tokens.dtcg.json"
      ],
      "cssOnly": {}
    }
  },
  "card": {
    "card-pad-block": {
      "$type": "dimension",
      "$value": "{space.space-8}"
    },
    "card-pad-inline": {
      "$type": "dimension",
      "$value": "{space.space-8}"
    }
  },
  "cell": {
    "cell-pad-x": {
      "$type": "dimension",
      "$value": "{space.space-7}"
    },
    "cell-pad-y": {
      "$type": "dimension",
      "$value": "{space.space-6}"
    }
  },
  "control": {
    "control-height": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "control-height-lg": {
      "$type": "dimension",
      "$value": {
        "value": 52,
        "unit": "px"
      }
    },
    "control-height-sm": {
      "$type": "dimension",
      "$value": {
        "value": 36,
        "unit": "px"
      }
    }
  },
  "list": {
    "list-gap": {
      "$type": "dimension",
      "$value": "{space.space-6}"
    },
    "list-pad-block": {
      "$type": "dimension",
      "$value": "{space.space-7}"
    },
    "list-pad-inline": {
      "$type": "dimension",
      "$value": "{space.space-7}"
    }
  },
  "page": {
    "page-banner-pad-block": {
      "$type": "dimension",
      "$value": "{space.space-7}"
    },
    "page-rhythm": {
      "$type": "dimension",
      "$value": "{space.space-8}"
    }
  }
}
