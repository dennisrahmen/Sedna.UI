{
  "$description": "Sedna.UI design tokens for :root inside @media (forced-colors: active). Load after the files in load.",
  "$extensions": {
    "com.sedna-ui": {
      "selector": ":root",
      "media": "(forced-colors: active)",
      "load": [
        "Sedna.UI.tokens.dtcg.json"
      ],
      "cssOnly": {
        "accent": "LinkText",
        "agent-edge": "color-mix(in srgb, var(--agent-to) 35%, transparent)",
        "agent-from": "Highlight",
        "agent-glow": "color-mix(in srgb, var(--agent-to) 55%, transparent)",
        "agent-glow-dim": "color-mix(in srgb, var(--agent-to) 25%, transparent)",
        "agent-skeleton-cool": "color-mix(in srgb, var(--agent-to) 24%, var(--skeleton-bg))",
        "agent-skeleton-warm": "color-mix(in srgb, var(--agent-from) 24%, var(--skeleton-bg))",
        "agent-sphere-halo": "color-mix(in srgb, var(--agent-to) 70%, transparent)",
        "agent-sphere-ring": "color-mix(in srgb, var(--agent-to) 30%, transparent)",
        "agent-tint": "color-mix(in srgb, var(--agent-to) 12%, transparent)",
        "agent-to": "Highlight",
        "agent-trail": "color-mix(in srgb, var(--fg) 30%, transparent)",
        "backdrop": "Canvas",
        "badge-bg": "Canvas",
        "bg": "Canvas",
        "bg-elevated": "Canvas",
        "bg-hover": "Highlight",
        "border": "CanvasText",
        "border-hover": "Highlight",
        "border-strong": "CanvasText",
        "brand": "Highlight",
        "brand-active": "Highlight",
        "brand-glow": "color-mix(in srgb, var(--brand) 18%, transparent)",
        "brand-hover": "Highlight",
        "brand-ring": "color-mix(in srgb, var(--brand) 50%, transparent)",
        "brand-ring-check": "color-mix(in srgb, var(--brand) 35%, transparent)",
        "brand-ring-soft": "color-mix(in srgb, var(--brand) 40%, transparent)",
        "brand-soft": "Highlight",
        "brand-text": "LinkText",
        "brand-tint": "Canvas",
        "brand-tint-strong": "color-mix(in srgb, var(--brand) 24%, transparent)",
        "card-bg": "Canvas",
        "code-bg": "Canvas",
        "code-fg": "CanvasText",
        "danger-active": "color-mix(in srgb, var(--danger-solid), var(--danger-fg) 25%)",
        "danger-bg": "Canvas",
        "danger-border": "CanvasText",
        "danger-border-strong": "CanvasText",
        "danger-fg": "CanvasText",
        "danger-hover": "color-mix(in srgb, var(--danger-solid), var(--danger-fg) 15%)",
        "danger-solid": "CanvasText",
        "divider": "CanvasText",
        "fg": "CanvasText",
        "fg-soft": "CanvasText",
        "field-border-danger": "CanvasText",
        "field-border-warn": "CanvasText",
        "flow-glow": "Canvas",
        "flow-light": "Highlight",
        "flow-line": "CanvasText",
        "flow-tint": "Canvas",
        "go-bg": "Canvas",
        "go-bg-active": "color-mix(in srgb, var(--go-bg), var(--go-solid) 20%)",
        "go-bg-hover": "color-mix(in srgb, var(--go-bg), var(--go-solid) 12%)",
        "go-border": "CanvasText",
        "go-fg": "CanvasText",
        "go-solid": "CanvasText",
        "heat-0": "Canvas",
        "heat-1": "color-mix(in srgb, CanvasText 25%, Canvas)",
        "heat-2": "color-mix(in srgb, CanvasText 50%, Canvas)",
        "heat-3": "color-mix(in srgb, CanvasText 75%, Canvas)",
        "heat-4": "CanvasText",
        "info-active": "color-mix(in srgb, var(--info-solid), var(--info-fg) 25%)",
        "info-bg": "Canvas",
        "info-bg-active": "color-mix(in srgb, var(--info-bg), var(--info-solid) 20%)",
        "info-bg-hover": "color-mix(in srgb, var(--info-bg), var(--info-solid) 12%)",
        "info-border": "CanvasText",
        "info-fg": "CanvasText",
        "info-hover": "color-mix(in srgb, var(--info-solid), var(--info-fg) 15%)",
        "muted": "GrayText",
        "on-solid": "HighlightText",
        "on-viz": "CanvasText",
        "overlay": "Canvas",
        "presence-out-of-office": "CanvasText",
        "progress-track": "Canvas",
        "rating-off": "CanvasText",
        "rating-on": "Highlight",
        "secret-active": "color-mix(in srgb, var(--secret-fg), var(--secret-bg) 25%)",
        "secret-bg": "Canvas",
        "secret-bg-active": "color-mix(in srgb, var(--secret-bg), var(--secret-fg) 18%)",
        "secret-bg-hover": "color-mix(in srgb, var(--secret-bg), var(--secret-fg) 10%)",
        "secret-border": "CanvasText",
        "secret-fg": "CanvasText",
        "secret-hover": "color-mix(in srgb, var(--secret-fg), var(--secret-bg) 15%)",
        "sidebar-active": "Highlight",
        "sidebar-bg": "Canvas",
        "sidebar-border": "CanvasText",
        "sidebar-fg": "CanvasText",
        "skeleton-bg": "Canvas",
        "skeleton-sheen": "Canvas",
        "surface-raised-2": "Canvas",
        "surface-raised-3": "Canvas",
        "surface-soft": "Canvas",
        "surface-strong": "Canvas",
        "table-head-bg": "Canvas",
        "tip-bg": "Canvas",
        "tip-border": "CanvasText",
        "tip-fg": "CanvasText",
        "viz-previous": "GrayText",
        "warn-bg": "Canvas",
        "warn-border": "CanvasText",
        "warn-fg": "CanvasText",
        "warn-solid": "CanvasText"
      }
    }
  }
}
