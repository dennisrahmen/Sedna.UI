<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sedna.UI</RootNamespace>
    <AssemblyName>Sedna.UI</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ── NuGet package ─────────────────────────────────────────────────────
       Version is a floor for local builds only: CI passes -p:Version=<tag>, so
       the published version is always the git tag (see .github/workflows).
       Static web assets are served from _content/Sedna.UI/… in a consuming
       app, and land under staticwebassets/ in the .nupkg. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sedna.UI</PackageId>
    <Version>0.2.0</Version>

    <Title>Sedna.UI</Title>
    <Authors>Dennis Rahmen</Authors>
    <Company>Dennis Rahmen</Company>
    <Copyright>Copyright (c) Dennis Rahmen</Copyright>
    <Description>Semantic CSS for Blazor, built to be written by an agent. You write plain HTML with semantic classes; the package ships the stylesheet, a design-token contract, the icons and the script, and an MCP server at sedna-ui.com hands your agent the exact markup.</Description>
    <PackageTags>blazor;razor;css;design-system;design-tokens;ui;aspnetcore;mcp;ai-agents</PackageTags>
    <!-- Apache-2.0 over MIT for its explicit patent grant (§3): every
         contributor licenses their patents to every user, and that binds
         outside pull requests to this public repo too. MIT is silent on
         patents, leaving only an arguable implied licence. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Project website on the nuget.org listing: the catalogue, which is what a
         reader wants. RepositoryUrl is a separate field and stays on GitHub, so
         the listing shows both "Project website" and "Source repository". -->
    <PackageProjectUrl>https://www.sedna-ui.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dennisrahmen/Sedna.UI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Deterministic, source-linked builds in CI. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed at the package root so nuget.org renders them. All outside the
         project dir, so there is no default glob to collide with.
         The icon is renamed to icon.png in the package to match PackageIcon;
         nuget.org requires a raster image of 128x128 or smaller. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\brand\sedna-ui-tile-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <!-- The commented copies of the generated stylesheet and scripts. The served copies
         under wwwroot/ carry no comments; these are for reading, in the package and in an
         editor, and are never static web assets — readable/ sits outside wwwroot. -->
    <None Include="readable\*" Pack="true" PackagePath="readable\" Visible="false" />
  </ItemGroup>

  <!-- The app's own tooling, matched to this version: the class check NuGet imports into the
       app's build, the maps and the history it reads, the rename script, the Stylelint config
       and the agent skill. None of it is a static web asset; tooling/ is no folder NuGet acts on. -->
  <ItemGroup>
    <None Update="Tooling\Sedna.UI.targets" Pack="true" PackagePath="build\Sedna.UI.targets;buildTransitive\Sedna.UI.targets" />
    <None Include="..\..\docs\renames\*.json" Pack="true" PackagePath="tooling\renames\" Visible="false" />
    <None Include="..\..\build\rename-classes.py" Pack="true" PackagePath="tooling\" Visible="false" />
    <None Include="..\..\tooling\stylelint\sedna-ui.stylelintrc.json" Pack="true" PackagePath="tooling\stylelint\" Visible="false" />
    <None Include="..\..\skills\sedna-ui\SKILL.md" Pack="true" PackagePath="tooling\skills\sedna-ui\" Visible="false" />
    <!-- The Razor SDK makes every .json a Content item, which would pack the history as contentFiles
         into the app's own project. It is packed under tooling/ for the class check, and nowhere else. -->
    <Content Update="Contract\class-history.json" Pack="true" PackagePath="tooling\class-history.json" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- The state illustrations travel inside the assembly and SednaStateArt writes them
       into the page, so a <use> is a same-document reference in every engine. As a
       static web asset they were an external reference, and WebKit renders those in a
       document of their own: no inherited colour, no custom properties, black. -->
  <ItemGroup>
    <EmbeddedResource Include="StateArt\Sedna.UI.states.svg" LogicalName="Sedna.UI.states.svg" />
    <EmbeddedResource Include="StateArt\Sedna.UI.mochi.svg" LogicalName="Sedna.UI.mochi.svg" />
    <!-- Generated by build/class-history.sh from the release tags, never committed:
         SednaContract answers from it. A build without it still compiles; SednaContract
         then says how to make it, and verify-package refuses a package without it. -->
    <EmbeddedResource Include="Contract\class-history.json" LogicalName="Sedna.UI.class-history.json"
                      Condition="Exists('Contract\class-history.json')" />
  </ItemGroup>

  <!-- So SednaRampGenerationTests can call the internal Oklch conversion directly, rather than
       keeping a second, independently-written copy of the same thirty lines in the test project —
       exactly the kind of drift-prone duplication docs/architecture.md's "one implementation"
       decisions (build/css-inventory.sh, ui._.score) exist to avoid. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sedna.UI.Tests" />
  </ItemGroup>

  <!-- The only package dependency, and the one a Razor Class Library cannot avoid:
       ComponentBase, RenderFragment and NavigationManager live here. A
       FrameworkReference to Microsoft.AspNetCore.App would keep the .nupkg
       dependency-free but would stop a Blazor WebAssembly app consuming this
       library, which does not reference the shared framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

</Project>
