<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sedna.UI</RootNamespace>
    <AssemblyName>Sedna.UI</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ── NuGet package ─────────────────────────────────────────────────────
       Version is a floor for local builds only: CI passes -p:Version=<tag>, so
       the published version is always the git tag (see .github/workflows).
       Static web assets are served from _content/Sedna.UI/… in a consuming
       app, and land under staticwebassets/ in the .nupkg. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sedna.UI</PackageId>
    <Version>0.2.0</Version>

    <Title>Sedna.UI</Title>
    <Authors>Dennis Rahmen</Authors>
    <Company>Dennis Rahmen</Company>
    <Copyright>Copyright (c) Dennis Rahmen</Copyright>
    <Description>Shared Blazor UI layer: one design-token contract plus semantic CSS classes for page content. Rebrand a whole app by redefining a handful of CSS variables.</Description>
    <PackageTags>blazor;razor;css;design-system;design-tokens;ui;aspnetcore</PackageTags>
    <!-- Apache-2.0 over MIT for its explicit patent grant (§3): every
         contributor licenses their patents to every user, and that binds
         outside pull requests to this public repo too. MIT is silent on
         patents, leaving only an arguable implied licence. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Project website on the nuget.org listing: the catalogue, which is what a
         reader wants. RepositoryUrl is a separate field and stays on GitHub, so
         the listing shows both "Project website" and "Source repository". -->
    <PackageProjectUrl>https://www.sedna-ui.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dennisrahmen/Sedna.UI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Deterministic, source-linked builds in CI. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed at the package root so nuget.org renders them. All outside the
         project dir, so there is no default glob to collide with.
         The icon is renamed to icon.png in the package to match PackageIcon;
         nuget.org requires a raster image of 128x128 or smaller. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\brand\dr-simple-ui-icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- The only package dependency, and the one a Razor Class Library cannot avoid:
       ComponentBase, RenderFragment and NavigationManager live here. A
       FrameworkReference to Microsoft.AspNetCore.App would keep the .nupkg
       dependency-free but would stop a Blazor WebAssembly app consuming this
       library, which does not reference the shared framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

</Project>
